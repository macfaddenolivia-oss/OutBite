---
// "Is it near me?" dashboard (Oct 16 2026). All numbers come from CDC
// (src/data/cases.json, written by `npm run update-data`; the build needs no network):
// 1. Title and the place picker (remembered in this browser only, like the home page).
//    The ZIP code box (JavaScript only) looks the ZIP up in src/data/zip-to-state.json
//    (Census ZCTAs, npm run build-zip-data), bundled into this page's script: Enter or
//    "Go" picks its state or territory; a ZIP in more than one state offers a button for
//    each. Nothing is sent or saved, and the ZIP never goes into the page address.
// 2. What these numbers mean, with more detail in an expandable section.
// 3. The three numbers for the chosen place + CDC's national local/travel split, then a
//    link to "Traveling soon?" (world map and CDC travel notices).
// 4. U.S. map, one virus at a time, with a sortable table (also the no-JS and
//    screen-reader version).
// 5. Sources and "last checked".
import ActionRow from '../../components/ActionRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UsMap from '../../components/UsMap.astro';
import placeData from '../../data/places.json';
import CdcSourceLine from '../../components/CdcSourceLine.astro';
import NoteRef from '../../components/NoteRef.astro';
import RefText from '../../components/RefText.astro';
import SourceLine from '../../components/SourceLine.astro';
import externalLinks from '../../content/external-links.json';
import {
  DISEASES,
  REPORTED_NOTE_SOURCES,
  allUSMissing,
  bin,
  caseData,
  formatDate,
  formatWeekDate,
  latestWeekByPlace,
  nationalLatestWeek,
  weekTemplate,
  ytdByPlace,
  type Count,
  type Disease,
} from '../../lib/cases';
import { getLocale, langStaticPaths, localizePath, useTranslations } from '../../i18n';
import { getPage } from '../../config/pages';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const locale = getLocale(lang);
const htmlLang = locale.meta.htmlLang;
// Lists and lookups that t() (strings only) can't return.
const dash = (locale.messages as Record<string, any>).dash as {
  more: string[];
  bins: string[];
  short: Record<string, string>;
  inSentence: Record<string, string>;
};
const href = (key: string) => localizePath(lang, getPage(key).path);
const fmt = new Intl.NumberFormat(htmlLang);
const ytd = ytdByPlace();

const names: Record<string, string> = Object.fromEntries(placeData.places.map((p) => [p.code, t(`places.${p.code}`)]));
const placesSorted = placeData.places.map((p) => p.code).sort((a, b) => names[a].localeCompare(names[b], htmlLang));
// Ongoing local spread, per virus, from CDC (src/data/places.json).
const localSpread = Object.fromEntries(
  DISEASES.map((d) => [d, placeData.places.filter((p) => p.localSpread[d]).map((p) => p.code)]),
) as Record<Disease, string[]>;
const localNote = (diseases: Disease[]) =>
  t('dash.localSpreadOf', { disease: diseases.map((d) => dash.inSentence[d]).join(` ${t('diseasePage.and')} `) });
const diseaseName = (d: Disease) => t(`pages.${d}.title`);

const countText = (n: Count) =>
  n === null ? t('dash.notReported') : n === 0 ? t('dash.noCases') : n === 1 ? t('dash.countLabelOne') : t('dash.countLabel', { count: fmt.format(n) });
const numberText = (n: Count) => (n === null ? t('dash.notReported') : fmt.format(n));
const placeLabel = (code: string, d: Disease) =>
  `${names[code]}: ${countText(ytd[code][d])}${localSpread[d].includes(code) ? ` (${localNote([d])})` : ''}`;
const initial = Object.fromEntries(Object.keys(ytd).map((code) => [code, { bin: bin(ytd[code].dengue), label: placeLabel(code, 'dengue') }]));

const fetched = formatDate(caseData.fetchedAt.slice(0, 10), htmlLang);

// Everything the page script needs. Nothing is sent anywhere.
// Cases newly reported in the latest MMWR week ("current week"), per place and for the U.S.
const week = latestWeekByPlace();
const usWeek = nationalLatestWeek();
const weekDate = formatWeekDate(caseData.weekEnding, htmlLang);
const weekDateLong = formatDate(caseData.weekEnding, htmlLang);
const weekText = {
  weekWith: t('dash.weekWith'),
  weekWithOne: t('dash.weekWithOne'),
  weekNone: t('dash.weekNone'),
  weekMissing: t('dash.weekMissing'),
  date: weekDate,
};
const weekLineText = (n: Count) => weekTemplate(n, weekText).replace('{n}', n === null ? '' : fmt.format(n)).replace('{date}', weekDate);
const refLabel = t('dash.noteRefLabel');

const pageData = {
  locale: htmlLang,
  names,
  ytd,
  national: caseData.allUS.ytd,
  week,
  usWeek,
  weekText,
  localSpread,
  diseases: dash.inSentence,
  about: Object.fromEntries(DISEASES.map((d) => [d, { href: href(d), text: t('diseasePage.aboutLink', { disease: t(`diseasePage.inSentence.${d}`) }) }])),
  binLimits: [1, 2, 10, 50, 200],
  us: t('dash.allUSHeading'),
  text: {
    countLabel: t('dash.countLabel'),
    countLabelOne: t('dash.countLabelOne'),
    noCases: t('dash.noCases'),
    notReported: t('dash.notReported'),
    localSpreadOf: t('dash.localSpreadOf'),
    placeHeading: t('dash.placeHeading', { year: String(caseData.mmwrYear) }),
    selected: t('dash.selected'),
    mapLabel: t('dash.mapLabel'),
    viewTable: t('dash.viewTable'),
    viewMap: t('dash.viewMap'),
    zipNotFound: t('home.near.zipNotFound'),
    zipShort: t('home.near.zipShort'),
    zipMulti: t('home.near.zipMulti'),
    zipFound: t('home.near.zipFound'),
  },
};
---

<BaseLayout lang={lang} title={t('pages.nearMe.title')} description={t('pages.nearMe.summary')}>
  <div class="page-intro">
    <div class="container">
      <h1>{t('pages.nearMe.title')}</h1>
      <p class="page-intro__lead">
        <strong>{t('dash.dataThrough', { date: weekDateLong })}</strong> {t('dash.intro')} {t('dash.lastCheckedExplain', { date: fetched })}
      </p>
      <ActionRow lang={lang} />
    </div>
  </div>

  <div class="container dash" data-dash={JSON.stringify(pageData)}>
    <!-- 1. Place picker (same as the home page) -->
    <section class="dash-pick" aria-labelledby="pick-heading">
      <!-- Target of the home page's "#place-PR" link (the script then picks Puerto Rico). -->
      <span id="place-PR" class="dash-anchor" aria-hidden="true"></span>
      <h2 id="pick-heading" class="visually-hidden">{t('dash.pickHeading')}</h2>
      <div class="dash-pick__fields">
        <div class="dash-pick__field">
          <label for="dash-state">{t('home.near.stateLabel')}</label>
          <select id="dash-state" data-dash-state>
            <option value="">{t('home.near.allUS')}</option>
            {placesSorted.map((code) => <option value={code}>{names[code]}</option>)}
          </select>
        </div>
        <div class="dash-pick__field dash-zip js-only">
          <label for="dash-zip">{t('home.near.zipLabel')}</label>
          <div class="dash-zip__row">
            <input
              id="dash-zip"
              class="dash-pick__zip"
              data-dash-zip
              type="text"
              inputmode="numeric"
              enterkeyhint="go"
              autocomplete="postal-code"
              maxlength="5"
              pattern="[0-9]{5}"
              placeholder={t('home.near.zipPlaceholder')}
              aria-describedby="dash-zip-note dash-zip-msg"
            />
            <button type="button" class="btn btn-primary dash-zip__go" data-dash-zip-go>{t('home.near.zipGo')}</button>
          </div>
          <!-- Right under the ZIP box: the note and "No location tracking." on one line,
               then the ZIP messages (read by screen readers): too short, not found, or
               more than one state with a button for each. -->
          <div class="dash-zip__under">
            <p class="dash-zip__note" id="dash-zip-note">{t('home.near.zipNote')} {t('home.near.privacy')}</p>
            <div class="dash-pick__msg" id="dash-zip-msg" aria-live="polite" data-dash-msg></div>
          </div>
        </div>
        <!-- Without JavaScript there is no ZIP box, so "No location tracking." sits here. -->
        <p class="dash-pick__privacy no-js-only">{t('home.near.privacy')}</p>
        <p class="dash-pick__back js-only">
          <button type="button" class="dash-back" data-dash-back hidden>
            <span aria-hidden="true">←</span> {t('dash.backToUS')}
          </button>
        </p>
      </div>
    </section>

    <!-- 2. Two columns on desktop: map (left, ~65%) and reported cases (right, ~35%),
         "What these numbers mean" under the map. Stacked: cases, map, meaning. -->
    <div class="dash-main">
      <!-- Reported cases for the chosen place -->
      <section class="dash-numbers" aria-labelledby="place-heading">
        <h2 id="place-heading" class="dash-heading" data-dash-place>{t('dash.placeHeading', { place: t('dash.allUSHeading'), year: String(caseData.mmwrYear) })}</h2>
        <!-- Only with JavaScript (the map isn't clickable without it). Arrow points at the map:
             left on desktop, down on tablets and phones. -->
        <p class="dash-hint js-only">
          <span aria-hidden="true"><span class="dash-hint__left">←</span><span class="dash-hint__down">↓</span> {t('dash.mapHint')}</span>
          <span class="visually-hidden">{t('dash.mapHintSr')}</span>
        </p>
        <p class="dash-note"><RefText text={t('dash.unitNote')} href="#dash-note" label={refLabel} /></p>
        <ul class="dash-cells">
          {
            DISEASES.map((d) => (
              <li class="dash-cell" data-dash-row={d} data-active={d === 'dengue' ? 'true' : undefined}>
                <span class="dash-cell__disease">{diseaseName(d)}</span>
                <span class="dash-cell__number" data-dash-count={d}>{numberText(caseData.allUS.ytd[d])}</span>
                <span class="dash-cell__unit">{t('home.near.unit')}</span>
                <span class="dash-cell__week" data-dash-week={d}>
                  <RefText text={weekLineText(usWeek[d])} href="#dash-note" label={refLabel} />
                </span>
              </li>
            ))
          }
        </ul>
        {allUSMissing && (
          <p class="dash-missing" data-dash-missing>
            {t('dash.allUSMissing')}
          </p>
        )}
        <div class="dash-caveat" id="dash-note">
          <p>{t('dash.reportedNote')}</p>
          <SourceLine lang={lang} ids={REPORTED_NOTE_SOURCES} compact />
        </div>
        <template data-ref-template><NoteRef href="#dash-note" label={refLabel} /></template>
        <CdcSourceLine lang={lang} class="dash-source" />
        <!-- Puerto Rico only: link to PRDH's own data (link only; never fetch from that site). -->
        <p class="dash-prdh" data-dash-prdh hidden>
          {t('dash.prdhNote')}{' '}
          <a href={externalLinks['prdh-arbovirus'].url}>{t('dash.prdhLink')} <span aria-hidden="true">→</span></a>
        </p>
      </section>

      <!-- Map (one virus at a time) and table -->
      <section class="dash-map" aria-labelledby="map-heading">
        <!-- Tabs and "View as table" above the map; then the map, legend and source line. -->
        <h2 id="map-heading" class="visually-hidden">{t('dash.mapHeading')}</h2>
        {DISEASES.map((d) => <span id={`map-${d}`} class="dash-map__anchor" />)}
        <div class="dash-map__head">
          <div class="dash-tabs js-only" role="group" aria-label={t('dash.tabsLabel')} data-dash-tabs>
            {
              DISEASES.map((d, i) => (
                <button type="button" class="dash-tab" data-disease={d} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {diseaseName(d)}
                </button>
              ))
            }
          </div>
          <p class="dash-about js-only">
            <a href={href('dengue')} data-dash-about>
              <span data-dash-about-text>{t('diseasePage.aboutLink', { disease: t('diseasePage.inSentence.dengue') })}</span> <span aria-hidden="true">→</span>
            </a>
          </p>
          <button type="button" class="btn btn-secondary dash-map__toggle js-only" data-dash-toggle aria-controls="dash-table-wrap dash-map-panel">
            {t('dash.viewTable')}
          </button>
        </div>
        <div class="dash-map__panel js-only" id="dash-map-panel" data-dash-map-panel>
          <UsMap
            label={t('dash.mapLabel', { disease: dash.inSentence.dengue })}
            names={names}
            short={dash.short}
            localSpread={localSpread.dengue}
            initial={initial}>
            <div class="legend">
              <p class="legend__title">{t('dash.legendHeading', { year: caseData.mmwrYear })}</p>
              <ul class="legend__list">
                {dash.bins.map((label, i) => (
                  <li>
                    <span class={`swatch swatch--${i + 1}`} aria-hidden="true"></span>
                    {label}
                  </li>
                ))}
                <li><span class="swatch swatch--none" aria-hidden="true"></span>{t('dash.legendNone')}</li>
                <li><span class="swatch swatch--missing" aria-hidden="true"></span>{t('dash.legendNotReported')}</li>
                <li data-legend-local hidden={localSpread.dengue.length === 0}><span class="swatch swatch--local" aria-hidden="true"></span>{t('dash.legendLocal')}</li>
              </ul>
              <p class="legend__note">{t('dash.mapNote')} {t('dash.notToScale')}.</p>
            </div>
          </UsMap>
        </div>

        <div class="dash-table-wrap" id="dash-table-wrap" data-dash-table>
          <table class="dash-table">
            <caption><RefText text={t('dash.tableCaption', { date: weekDate })} href="#dash-table-note" label={refLabel} /></caption>
            <thead>
              <tr>
                <th scope="col" aria-sort="ascending" data-sort-key="place">
                  <button type="button" class="sort-btn" disabled>{t('dash.colPlace')}<span class="sort-icon" aria-hidden="true"></span></button>
                </th>
                {
                  DISEASES.flatMap((d) => [
                    <th scope="col" class="num" data-sort-key={d}>
                      <button type="button" class="sort-btn" disabled>
                        <span>{diseaseName(d)}<span class="sort-sub">{t('dash.colYear')}</span></span><span class="sort-icon" aria-hidden="true"></span>
                      </button>
                    </th>,
                    <th scope="col" class="num num--week" data-sort-key={`${d}-week`}>
                      <button type="button" class="sort-btn" disabled>
                        <span>{diseaseName(d)}<span class="sort-sub">{t('dash.colWeek', { date: weekDate })}</span></span><span class="sort-icon" aria-hidden="true"></span>
                      </button>
                    </th>,
                  ])
                }
              </tr>
            </thead>
            <tbody>
              {
                placesSorted.map((code) => (
                  <tr data-code={code} data-place={names[code]}>
                    <th scope="row">
                      {names[code]}
                      {DISEASES.some((d) => localSpread[d].includes(code)) && (
                        <span class="dash-table__local"> ({localNote(DISEASES.filter((d) => localSpread[d].includes(code)))})</span>
                      )}
                    </th>
                    {DISEASES.flatMap((d) => [
                      <td class="num" data-value={ytd[code][d] ?? -1}>{numberText(ytd[code][d])}</td>,
                      <td class="num num--week" data-value={week[code][d] ?? -1}>{numberText(week[code][d])}</td>,
                    ])}
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="dash-caveat dash-caveat--table" id="dash-table-note">{t('dash.reportedNote')}</p>
        </div>
        <CdcSourceLine lang={lang} class="dash-source" />
      </section>

      <!-- What these numbers mean -->
      <section class="dash-meaning" aria-labelledby="meaning-heading">
        <h2 id="meaning-heading" class="dash-heading">{t('dash.meaningHeading')}</h2>
        <p>{t('dash.meaning1')}</p>
        <p>{t('dash.meaning2')}</p>
        <details class="dash-more">
          <summary>{t('dash.moreHeading')}</summary>
          <ul>{dash.more.map((line) => <li>{line}</li>)}</ul>
          <p><a href={href('protect')}>{t('dash.protectLink')} <span aria-hidden="true">→</span></a></p>
        <p class="dash-faq">
          <a href={`${href('faq')}#case-numbers`}>{t('faqLinks.faqNumbers')} <span aria-hidden="true">→</span></a>
          <a href={`${href('faq')}#real-number`}>{t('faqLinks.faqReal')} <span aria-hidden="true">→</span></a>
        </p>
        </details>
      </section>
    </div>

    <!-- 3. CDC's national local/travel split -->
    <section class="dash-split-section" aria-labelledby="split-heading">
      <h2 id="split-heading" class="dash-heading">{t('dash.splitHeading')}</h2>
      <ul class="dash-split">
        {
          DISEASES.map((d) => {
            const s = caseData.split[d];
            return (
              <li>
                <strong>{diseaseName(d)}:</strong>{' '}
                {s.available && s.states && s.territories ? (
                  <>
                    {t('dash.splitLine', {
                      local: fmt.format(s.states.local),
                      travel: fmt.format(s.states.travel),
                      tlocal: fmt.format(s.territories.local),
                      ttravel: fmt.format(s.territories.travel),
                      year: String(s.year),
                    })}{' '}
                    <span class="dash-split__source">
                      <a href={s.url}>{t('dash.splitAsOf', { date: formatDate(s.asOf!, htmlLang) })}</a>
                    </span>
                  </>
                ) : (
                  <a href={s.url}>{t('dash.splitLink')}</a>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="dash-levels">{t('dash.splitExplain')}</p>
      <!-- The world map and CDC's travel notices are on "Traveling soon?"; this page stays on the U.S. -->
      <p class="dash-travel">
        <a href={`${localizePath(lang, getPage('travel').path)}#world`}>{t('dash.travelWorld')} <span aria-hidden="true">→</span></a>
      </p>
    </section>

    <!-- 4. Sources -->
    <section class="dash-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading" class="dash-subheading">{t('dash.sourcesHeading')}</h2>
      <p>{t('dash.sources')}</p>
      <p>{t('dash.lastChecked', { date: fetched })}</p>
    </section>
  </div>
</BaseLayout>

<script>
  import { fillRefText, statesForZip, weekLine, type WeekText } from '../../lib/place-client';
  import zipToState from '../../data/zip-to-state.json';

  type Counts = Record<string, number | null>;
  interface DashData {
    locale: string;
    names: Record<string, string>;
    ytd: Record<string, Counts>;
    national: Counts;
    week: Record<string, Counts>;
    usWeek: Counts;
    weekText: WeekText;
    localSpread: Record<string, string[]>;
    diseases: Record<string, string>;
    about: Record<string, { href: string; text: string }>;
    binLimits: number[];
    us: string;
    text: Record<string, string>;
  }

  const root = document.querySelector<HTMLElement>('[data-dash]');
  if (root?.dataset.dash) {
    const data: DashData = JSON.parse(root.dataset.dash);
    const fmt = new Intl.NumberFormat(data.locale);
    const fill = (s: string, vars: Record<string, string>) => s.replace(/\{(\w+)\}/g, (m, k) => vars[k] ?? m);
    const countText = (n: number | null) =>
      n === null ? data.text.notReported : n === 0 ? data.text.noCases : n === 1 ? data.text.countLabelOne : fill(data.text.countLabel, { count: fmt.format(n) });
    const bin = (n: number | null) => (n === null ? -1 : n === 0 ? 0 : data.binLimits.filter((l) => n >= l).length);

    const select = root.querySelector<HTMLSelectElement>('[data-dash-state]')!;
    const zip = root.querySelector<HTMLInputElement>('[data-dash-zip]')!;
    const msg = root.querySelector<HTMLElement>('[data-dash-msg]')!;
    const map = root.querySelector<HTMLElement>('[data-map]')!;
    const places = [...map.querySelectorAll<HTMLElement | SVGGElement>('.place')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-disease]')];
    let disease = 'dengue';
    let place = '';

    function paintMap() {
      for (const g of places) {
        const code = g.dataset.code!;
        const n = data.ytd[code]?.[disease] ?? null;
        g.querySelector('.shape')!.setAttribute('class', `shape bin-${bin(n)}`);
        // Orange outline and note only where CDC lists ongoing spread of this virus.
        const isLocal = data.localSpread[disease].includes(code);
        g.classList.toggle('is-local', isLocal);
        const local = isLocal ? ` (${fill(data.text.localSpreadOf, { disease: data.diseases[disease] })})` : '';
        g.setAttribute('aria-label', `${data.names[code]}: ${countText(n)}${local}`);
        g.setAttribute('aria-pressed', String(code === place));
      }
      const legendLocal = root!.querySelector<HTMLElement>('[data-legend-local]');
      if (legendLocal) legendLocal.hidden = data.localSpread[disease].length === 0;
      // Draw the selected place last so its edge isn't covered by its neighbours
      // (moving it drops keyboard focus, so give it back).
      const sel = places.find((g) => g.dataset.code === place);
      if (sel && sel.classList.contains('place--state')) {
        const hadFocus = document.activeElement === sel;
        sel.parentNode!.insertBefore(sel, places.find((g) => g.classList.contains('place--dc')) ?? null);
        if (hadFocus) sel.focus();
      }
      map.setAttribute('aria-label', fill(data.text.mapLabel, { disease: data.diseases[disease] }));
    }

    function showPlace(code: string) {
      place = data.ytd[code] ? code : '';
      const counts = place ? data.ytd[place] : data.national;
      const name = place ? data.names[place] : data.us;
      root!.querySelector('[data-dash-place]')!.textContent = fill(data.text.placeHeading, { place: name });
      for (const el of root!.querySelectorAll<HTMLElement>('[data-dash-count]')) {
        const n = counts[el.dataset.dashCount!];
        el.textContent = n === null ? data.text.notReported : fmt.format(n);
      }
      const weekCounts = place ? data.week[place] : data.usWeek;
      const refTemplate = root!.querySelector<HTMLTemplateElement>('[data-ref-template]');
      for (const el of root!.querySelectorAll<HTMLElement>('[data-dash-week]')) {
        fillRefText(el, weekLine(weekCounts[el.dataset.dashWeek!], data.weekText, fmt), refTemplate);
      }
      select.value = place;
      root!.querySelector<HTMLElement>('[data-dash-prdh]')!.hidden = place !== 'PR';
      root!.querySelector<HTMLElement>('[data-dash-back]')!.hidden = place === '';
      const missing = root!.querySelector<HTMLElement>('[data-dash-missing]');
      if (missing) missing.hidden = place !== '';
      paintMap();
      alignCells();
    }

    // Desktop (map and cases side by side): stretch the three number rows evenly so
    // the Chikungunya row's bottom lines up with the bottom of the map frame. If the
    // rows are already taller than that, they keep their own height.
    const cells = root.querySelector<HTMLElement>('.dash-cells')!;
    function alignCells() {
      cells.style.minHeight = '';
      const panel = root!.querySelector<HTMLElement>('[data-dash-map-panel]');
      if (!panel || panel.hidden || !window.matchMedia('(min-width: 64rem)').matches) return;
      const need = panel.getBoundingClientRect().bottom - cells.getBoundingClientRect().top;
      if (need > cells.getBoundingClientRect().height) cells.style.minHeight = `${need}px`;
    }
    window.addEventListener('resize', alignCells);

    function choose(code: string) {
      showPlace(code);
    }

    // Picker
    // ZIP messages: `invalid` marks the box for screen readers; `codes` adds a button per
    // state. Cleared first, so the same message is read again.
    function zipMessage(text: string, opts: { invalid?: boolean; codes?: string[]; quiet?: boolean } = {}) {
      msg.replaceChildren();
      if (opts.invalid) zip.setAttribute('aria-invalid', 'true');
      else zip.removeAttribute('aria-invalid');
      if (!text) return;
      setTimeout(() => {
        const p = document.createElement('p');
        p.className = opts.quiet ? 'visually-hidden' : 'dash-pick__error';
        p.textContent = text;
        msg.append(p);
        if (!opts.codes) return;
        const row = document.createElement('p');
        row.className = 'dash-zip__choices';
        for (const code of opts.codes) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'btn btn-secondary';
          b.textContent = data.names[code];
          b.setAttribute('aria-pressed', 'false');
          b.addEventListener('click', () => {
            for (const o of row.querySelectorAll('button')) o.setAttribute('aria-pressed', String(o === b));
            choose(code);
          });
          row.append(b);
        }
        msg.append(row);
      }, 50);
    }
    function lookUpZip() {
      const value = zip.value;
      if (!/^\d{5}$/.test(value)) return zipMessage(data.text.zipShort, { invalid: true });
      const codes = statesForZip(zipToState, value).filter((c) => data.names[c]);
      if (!codes.length) return zipMessage(data.text.zipNotFound, { invalid: true });
      if (codes.length > 1) return zipMessage(data.text.zipMulti, { codes });
      choose(codes[0]);
      zipMessage(fill(data.text.zipFound, { place: data.names[codes[0]] }).replace(/\.\.$/, '.'), { quiet: true });
    }
    select.addEventListener('change', () => {
      zip.value = '';
      zipMessage('');
      choose(select.value);
    });
    zip.addEventListener('input', () => {
      zip.value = zip.value.replace(/\D/g, '').slice(0, 5);
      zipMessage('');
    });
    zip.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      lookUpZip();
    });
    root.querySelector('[data-dash-zip-go]')!.addEventListener('click', lookUpZip);

    // Map: click, tap, Enter or Space selects a place (again to go back to the U.S.).
    const pick = (g: HTMLElement | SVGGElement) => choose(place === g.dataset.code ? '' : g.dataset.code!);
    for (const g of places) {
      g.addEventListener('click', () => pick(g));
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pick(g);
        }
      });
    }

    // Virus tabs (each with an "About [disease] →" link to its disease page).
    const about = root.querySelector<HTMLAnchorElement>('[data-dash-about]')!;
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        disease = tab.dataset.disease!;
        about.href = data.about[disease].href;
        about.querySelector('[data-dash-about-text]')!.textContent = data.about[disease].text;
        for (const b of tabs) b.setAttribute('aria-pressed', String(b === tab));
        // Mark the matching row in the reported-cases column.
        for (const row of root!.querySelectorAll<HTMLElement>('[data-dash-row]')) {
          if (row.dataset.dashRow === disease) row.dataset.active = 'true';
          else delete row.dataset.active;
        }
        paintMap();
      });
    }

    // "#map-zika" (from the disease pages' "See the map" links) opens that virus's tab.
    // A hash, not a query string, so nothing about it is ever sent anywhere.
    const requested = location.hash.match(/^#map-(dengue|zika|chikungunya)$/)?.[1];
    tabs.find((tab) => tab.dataset.disease === requested && requested !== 'dengue')?.click();


    // Map / table toggle. Without JavaScript only the table shows.
    const toggle = root.querySelector<HTMLButtonElement>('[data-dash-toggle]')!;
    const tableWrap = root.querySelector<HTMLElement>('[data-dash-table]')!;
    const mapPanel = root.querySelector<HTMLElement>('[data-dash-map-panel]')!;
    const tabsEl = root.querySelector<HTMLElement>('[data-dash-tabs]')!;
    let tableShown = false;
    const setView = (table: boolean) => {
      tableShown = table;
      tableWrap.hidden = !table;
      mapPanel.hidden = table;
      tabsEl.hidden = table;
      toggle.textContent = table ? data.text.viewMap : data.text.viewTable;
      toggle.setAttribute('aria-expanded', String(table));
      alignCells();
    };
    toggle.addEventListener('click', () => setView(!tableShown));
    setView(false);

    // Sortable table
    const table = tableWrap.querySelector('table')!;
    const tbody = table.querySelector('tbody')!;
    for (const th of table.querySelectorAll<HTMLTableCellElement>('th[data-sort-key]')) {
      // The sort buttons start disabled (no sorting without JavaScript); turn them on.
      th.querySelector('button')!.disabled = false;
      th.querySelector('button')!.addEventListener('click', () => {
        const key = th.dataset.sortKey!;
        const current = th.getAttribute('aria-sort');
        // Numbers sort largest first by default; names A–Z.
        const dir = current === 'descending' ? 'ascending' : current === 'ascending' ? 'descending' : key === 'place' ? 'ascending' : 'descending';
        for (const other of table.querySelectorAll('th[data-sort-key]')) other.removeAttribute('aria-sort');
        th.setAttribute('aria-sort', dir);
        // Column position = the heading's position (place, then year and week per virus).
        const col = th.cellIndex;
        const rows = [...tbody.rows].sort((a, b) => {
          const diff =
            key === 'place'
              ? a.dataset.place!.localeCompare(b.dataset.place!, data.locale)
              : Number(a.cells[col].dataset.value) - Number(b.cells[col].dataset.value);
          return dir === 'ascending' ? diff : -diff;
        });
        tbody.append(...rows);
      });
    }

    // Start with the place chosen earlier (this browser only), else the whole U.S.
    // Always opens on All of the U.S. (no place is remembered).
    root.querySelector('[data-dash-back]')?.addEventListener('click', () => {
      zip.value = '';
      zipMessage('');
      choose('');
      select.focus();
    });
    showPlace('');
    // A link ending in "#place-PR" (the home page's Puerto Rico line) opens on that place,
    // after the default All of the U.S. view above. A hash: nothing is sent anywhere.
    const requestedPlace = location.hash.match(/^#place-([A-Z]{2})$/)?.[1];
    if (requestedPlace && data.ytd[requestedPlace]) {
      select.value = requestedPlace;
      choose(requestedPlace);
    }
  }
</script>

