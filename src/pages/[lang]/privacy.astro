---
// Privacy. Text and Spanish: src/content/privacy.json. Every statement matches the
// code: the browser storage keys listed here are the ones in src/lib/storage.ts, and the
// site's content checks confirm the code sets no cookie and uses no unlisted storage key. GoatCounter sentences were
// checked against https://www.goatcounter.com/help/privacy.
// "Don't count my visits": GoatCounter's documented opt-out (localStorage "skipgc" =
// "t", what #toggle-goatcounter sets). Hidden without JavaScript, when nothing is
// counted anyway.
import ActionRow from '../../components/ActionRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../content/privacy.json';
import { getLocale, langStaticPaths } from '../../i18n';
import { formatDate } from '../../lib/cases';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.params;
const text = (content.text as Record<string, typeof content.text.en>)[lang] ?? content.text.en;
const htmlLang = getLocale(lang).meta.htmlLang;
const items = text.storage.items as Record<string, string>;
const sections = [
  ['short', 'short-version'],
  ['counting', 'counting-visits'],
  ['storage', 'in-your-browser'],
  ['never', 'never'],
  ['links', 'other-sites'],
  ['qr', 'qr-codes'],
] as const;
const id = Object.fromEntries(sections) as Record<(typeof sections)[number][0], string>;
---

<BaseLayout lang={lang} title={text.title} description={text.short.text}>
  <div class="page-intro">
    <div class="container">
      <h1>{text.title}</h1>
      <p class="page-intro__lead">{text.intro}</p>
      <ActionRow lang={lang} />
    </div>
  </div>

  <div class="container privacy">
    <nav class="jumps" aria-label={text.jumpLabel}>
      <ul>
        {
          sections.map(([key, anchor]) => (
            <li>
              <a href={`#${anchor}`}>{text[key].heading}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="psec psec--short" id={id.short} aria-labelledby="short-heading">
      <h2 id="short-heading">{text.short.heading}</h2>
      <p class="psec__lead">{text.short.text}</p>
    </section>

    <section class="psec" id={id.counting} aria-labelledby="counting-heading">
      <h2 id="counting-heading">{text.counting.heading}</h2>
      <ul>{text.counting.points.map((p: string) => <li>{p}</li>)}</ul>
      <p>{text.counting.sends}</p>
      <p>{text.counting.noJs}</p>
      <p>
        <a href={content.goatcounterPrivacyUrl}>{text.counting.link} <span aria-hidden="true">→</span></a>
      </p>

      <div class="optout" data-optout hidden>
        <button type="button" role="switch" aria-checked="false" class="optout__switch" data-optout-switch aria-describedby="optout-state">
          <span class="optout__track" aria-hidden="true"><span class="optout__thumb"></span></span>
          <span class="optout__label">{text.counting.switchLabel}</span>
        </button>
        <p class="optout__state" id="optout-state" role="status" data-optout-state data-off={text.counting.stateOff} data-on={text.counting.stateOn} data-blocked={text.counting.blocked}>
        </p>
      </div>
    </section>

    <section class="psec" id={id.storage} aria-labelledby="storage-heading">
      <h2 id="storage-heading">{text.storage.heading}</h2>
      <p>{text.storage.intro}</p>
      <ul>{content.storageKeys.map((s) => <li>{items[s.key]}</li>)}</ul>
      <p>{text.storage.outro}</p>
    </section>

    <section class="psec" id={id.never} aria-labelledby="never-heading">
      <h2 id="never-heading">{text.never.heading}</h2>
      <ul>{text.never.points.map((p: string) => <li>{p}</li>)}</ul>
    </section>

    <section class="psec" id={id.links} aria-labelledby="links-heading">
      <h2 id="links-heading">{text.links.heading}</h2>
      <p>{text.links.text}</p>
    </section>

    <section class="psec" id={id.qr} aria-labelledby="qr-heading">
      <h2 id="qr-heading">{text.qr.heading}</h2>
      <p>{text.qr.text}</p>
    </section>

    <p class="privacy__updated">{text.updated.replace('{date}', formatDate(content.lastUpdated, htmlLang))}</p>
  </div>
</BaseLayout>

<script>
  // "Don't count my visits": GoatCounter's opt-out value in this browser only
  // (localStorage "skipgc" = "t"). Nothing is sent anywhere.
  import { STORAGE } from '../../lib/storage';

  const box = document.querySelector<HTMLElement>('[data-optout]');
  const sw = box?.querySelector<HTMLButtonElement>('[data-optout-switch]');
  const state = box?.querySelector<HTMLElement>('[data-optout-state]');
  if (box && sw && state) {
    const read = (): boolean | null => {
      try {
        return localStorage.getItem(STORAGE.skipCounting) === 't';
      } catch {
        return null;
      }
    };
    const write = (skip: boolean): boolean => {
      try {
        if (skip) localStorage.setItem(STORAGE.skipCounting, 't');
        else localStorage.removeItem(STORAGE.skipCounting);
        return true;
      } catch {
        return false;
      }
    };
    const show = (skip: boolean | null) => {
      if (skip === null) {
        sw.disabled = true;
        state.textContent = state.dataset.blocked ?? '';
        return;
      }
      sw.setAttribute('aria-checked', String(skip));
      state.textContent = (skip ? state.dataset.off : state.dataset.on) ?? '';
    };
    sw.addEventListener('click', () => {
      const next = sw.getAttribute('aria-checked') !== 'true';
      show(write(next) ? read() : null);
    });
    show(read());
    box.hidden = false;
  }
</script>

<style>
  .privacy {
    padding-block: var(--space-4) var(--section-gap);
  }

  .jumps ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jumps a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-heading);
    font-weight: var(--weight-heading);
  }

  .psec {
    max-width: var(--content-width);
    margin-top: var(--space-5);
    padding: var(--pad-box-lg);
    border-top: 4px solid var(--color-rule);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .psec h2 {
    margin-bottom: var(--space-2);
  }

  .psec p,
  .psec ul {
    margin: 0;
  }

  .psec > * + * {
    margin-top: var(--space-3);
  }

  .psec ul {
    padding-inline-start: 1.2em;
  }

  .psec li + li {
    margin-top: var(--space-1);
  }

  .psec__lead {
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  /* "Don't count my visits" switch */
  .optout[hidden] {
    display: none;
  }

  .optout {
    padding: var(--space-3) var(--pad-box);
    background: var(--color-surface-tint);
  }

  .optout__switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-target);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  .optout__switch:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .optout__track {
    position: relative;
    flex: none;
    width: 3rem;
    height: 1.6rem;
    border: 2px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .optout__thumb {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-rule);
    transform: translateY(-50%);
    transition: left 0.15s;
  }

  .optout__switch[aria-checked='true'] .optout__track {
    background: var(--color-rule);
  }

  .optout__switch[aria-checked='true'] .optout__thumb {
    left: calc(100% - 1.3rem);
    background: var(--color-surface);
  }

  .optout__switch:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .optout__state {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .privacy__updated {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
