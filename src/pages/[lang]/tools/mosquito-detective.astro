---
// Mosquito detective / Detective de mosquitos (design/mosquito-detective-mockup.png and
// design/breed-round-mockup.png): a 3-round game, about 2 minutes, no timer. Nothing is
// saved or sent: the rounds, picks and scores live only in this page while it's open.
// Text, photos and sources: src/content/detective.json (photos made by
// npm run build-photos into public/photos/detective/; held-back photos are listed there
// with the reason).
// - Start: the intro, "How to tell them apart" (DetectiveClues.astro: an Aedes and a
//   Culex box, each with a CDC example photo that isn't in the game) and Start.
// - Rounds 1 and 2: 6 photos (3 across, 2 on phones) with 2–3 Aedes each, drawn at random
//   from every photo in detective.json, Round 2 preferring photos Round 1 didn't use.
//   Each photo is a toggle button; "Check" shows every answer with its one-line clue,
//   marks what was found, missed or wrongly picked, and explains anything missed.
// - Round 3: the yard (DetectiveYard.astro). Tapping something that holds water draws an
//   orange box with CDC's action; anything else a dotted light-blue box and why it's
//   fine. "I'm done" marks anything missed with its action.
// - End: "Case closed!", the score per round, the closing note and three buttons.
// Each step's heading takes focus when the step opens; results are read out through a
// polite live region. Without JavaScript: the same two boxes and the list of things that
// hold water.
import ActionRow from '../../../components/ActionRow.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DetectiveClues from '../../../components/DetectiveClues.astro';
import DetectiveYard from '../../../components/DetectiveYard.astro';
import Genus from '../../../components/Genus.astro';
import SourceLine from '../../../components/SourceLine.astro';
import ToolIcon from '../../../components/ToolIcon.astro';
import content from '../../../content/detective.json';
import { assetPath, langStaticPaths, localizePath, useTranslations } from '../../../i18n';
import { getPage } from '../../../config/pages';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const L = (lang === 'es' ? 'es' : 'en') as 'en' | 'es';
const text = content.text[L];
const items = text.items as Record<string, { name: string; tag: string; say: string }>;
const photoAlt = text.photos as Record<string, string>;
const href = (key: string) => localizePath(lang, getPage(key).path);
const { water, fine } = content.yard;
const SIZES = '(max-width: 40rem) 30vw, 180px';
// Wider screens: the spot above the photos is kept as tall as the longest full result can
// be (phones show a short one that fits the instructions' room), so Check moves nothing.
const fillN = (s: string) => s.replace(/\{n\}/g, '3');
const longestResult = [text.allFound, `${text.missedOne} ${text.wrongOne}`, `${fillN(text.missedMany)} ${fillN(text.wrongMany)}`, `${fillN(text.missedMany)} ${text.wrongOne}`, `${text.missedOne} ${fillN(text.wrongMany)}`].reduce((a, b) => (b.length > a.length ? b : a));
const srcset = (id: string, ext: string) => [320, 640].map((w) => `${assetPath(`photos/detective/${id}-${w}.${ext}`)} ${w}w`).join(', ');
// What the page script needs, in this language.
const scriptText = {
  roundOf: text.roundOf,
  photoRound: text.photoRound,
  yardRound: text.yardRound,
  found: text.found,
  allFound: text.allFound,
  resultShort: text.resultShort,
  missedOne: text.missedOne,
  missedMany: text.missedMany,
  wrongOne: text.wrongOne,
  wrongMany: text.wrongMany,
  markFound: text.markFound,
  markMissed: text.markMissed,
  markWrong: text.markWrong,
  progress: text.progress,
  yardAllFound: text.yardAllFound,
  yardMissedOne: text.yardMissedOne,
  yardMissedMany: text.yardMissedMany,
  roundScore: text.roundScore,
  scoreOf: text.scoreOf,
  say: Object.fromEntries(Object.entries(items).map(([k, v]) => [k, v.say])),
};
---

<BaseLayout lang={lang} title={t('pages.detective.title')} description={t('pages.detective.summary')}>
  <div class="page-intro">
    <div class="container">
      <p class="det-eyebrow">{text.eyebrow}</p>
      <div class="det-title">
        <ToolIcon tool="detective" />
        <h1>{t('pages.detective.title')}</h1>
      </div>
      <!-- No glossary link here: on the start screen only Start should look clickable. -->
      <p class="page-intro__lead" data-no-glossary><Genus text={text.intro} /></p>
      <ActionRow lang={lang} />
    </div>
  </div>

  <div class="container det-page">
    <!-- Without JavaScript: the two clue boxes and the places to check. -->
    <div class="det-static">
      <p class="det-static__intro">{text.staticIntro}</p>
      <DetectiveClues lang={lang} headingId="det-static-clues" />
      <h2 class="det-static__heading"><Genus text={text.yardRound} /></h2>
      <p>{text.staticWater}</p>
      <ul class="det-static__water">
        {
          water.map((key) => (
            <li>
              <strong>{items[key].name}:</strong> {items[key].tag}
            </li>
          ))
        }
      </ul>
      <p>{text.yardFact}</p>
      <p class="det-end__actions">
        <a class="btn btn-primary" href={href('checklist')}>{text.checklist} <span aria-hidden="true">→</span></a>
        <a class="btn btn-secondary" href={href('protect')}>{text.protect} <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <!-- The game (shown by the page script). No glossary links inside: following one
         mid-game would lose the game. -->
    <div class="det-game" data-no-glossary data-det data-text={JSON.stringify(scriptText)} hidden>
      <section class="det-step" data-step="start" aria-labelledby="det-start-heading">
        <DetectiveClues lang={lang} headingId="det-start-heading" />
        <p class="det-start">
          <button type="button" class="btn btn-primary det-start__btn" data-start>{text.start} <span aria-hidden="true">→</span></button>
        </p>
        <p class="det-note">{text.startNote}</p>
      </section>

      <section class="det-step" data-step="photos" aria-labelledby="det-photos-heading" hidden>
        <h2 id="det-photos-heading" class="det-step__heading" tabindex="-1" data-step-heading>
          <span class="det-step__round" data-photos-round></span><span class="visually-hidden">. </span>
          <span data-photos-heading></span>
        </h2>
        <p class="det-help" data-photos-help><Genus text={text.photoRoundHelp} /></p>
        <p class="det-help det-msg-sizer" aria-hidden="true">{longestResult}</p>
        <ul class="det-grid" data-grid></ul>
        <p class="det-credit">{text.credit}</p>
        <div class="det-foot">
          {/* The full result, and on phones a short one ("You missed 1 Aedes and picked 1
              Culex.") that fits the instructions' space; screen readers get the full one. */}
          <p class="det-result" data-photos-result hidden><span class="det-result__full" data-result-full></span><span class="det-result__short" aria-hidden="true" data-result-short></span></p>
          <div class="det-bar">
            <button type="button" class="btn btn-primary" data-check>{text.check}</button>
            <button type="button" class="btn btn-primary" data-next hidden>{text.next} <span aria-hidden="true">→</span></button>
          </div>
        </div>
      </section>

      <section class="det-step" data-step="yard" aria-labelledby="det-yard-heading" hidden>
        <h2 id="det-yard-heading" class="det-step__heading" tabindex="-1" data-step-heading>
          <span class="det-step__round">{text.roundOf.replace('{n}', '3')}</span><span class="visually-hidden">. </span>
          {text.yardRound}
        </h2>
        <p class="det-help"><span class="det-help__full">{text.yardHelp}</span><span class="det-help__short">{text.yardHelpShort}</span> {text.yardFact}</p>
        <DetectiveYard items={items} water={water} label={text.yardLabel} />
        <ul class="det-key">
          <li class="det-key__item det-key__item--found">{text.keyWater}</li>
          <li class="det-key__item det-key__item--fine">{text.keyFine}</li>
          <li class="det-key__item det-key__item--missed" data-key-missed hidden>{text.keyMissed}</li>
        </ul>
        <div class="det-foot">
          <p class="det-progress" data-progress-line>
            <span class="det-progress__boxes" aria-hidden="true">
              {water.map(() => <span class="det-progress__box" data-progress-box />)}
            </span>
            <span data-progress>{text.progress.replace('{n}', '0')}</span>
          </p>
          <p class="det-result" data-yard-result hidden></p>
          <button type="button" class="btn btn-primary" data-done>{text.done}</button>
          <button type="button" class="btn btn-primary" data-finish hidden>{text.finish} <span aria-hidden="true">→</span></button>
        </div>
      </section>

      <section class="det-step" data-step="end" aria-labelledby="det-end-heading" hidden>
        <h2 id="det-end-heading" class="det-end__heading" tabindex="-1" data-step-heading>{text.endHeading}</h2>
        <ul class="det-scores" data-scores></ul>
        <p class="det-end__note">{text.endNote}</p>
        <p class="det-end__actions">
          <a class="btn btn-primary" href={href('checklist')}>{text.checklist} <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href={href('protect')}>{text.protect} <span aria-hidden="true">→</span></a>
          <button type="button" class="btn btn-secondary" data-again>{text.again}</button>
        </p>
      </section>

      <p class="visually-hidden" aria-live="polite" data-live></p>

      <!-- One button per photo, copied into the grid by the page script. -->
      {
        content.photos.map((p) => (
          <template data-photo={p.id} data-aedes={String(p.aedes)}>
            <li>
              <button type="button" class="det-photo" aria-pressed="false">
                <picture>
                  <source type="image/webp" srcset={srcset(p.id, 'webp')} sizes={SIZES} />
                  <img src={assetPath(`photos/detective/${p.id}-320.jpg`)} srcset={srcset(p.id, 'jpg')} sizes={SIZES} width="320" height="320" alt={photoAlt[p.id]} decoding="async" />
                </picture>
                <span class="det-photo__tick" aria-hidden="true">✓</span>
                <span class="det-photo__mark" data-mark hidden />
                <span class="det-answer" data-answer hidden>
                  <span class="visually-hidden">. </span>
                  <Genus text={p.aedes ? text.answerAedes : text.answerCulex} />
                </span>
              </button>
            </li>
          </template>
        ))
      }
    </div>

    <SourceLine lang={lang} ids={[...content.cite.clues, ...content.cite.yard]} />
  </div>
</BaseLayout>

<script>
  // Everything stays in this page: nothing is saved or sent.
  const root = document.querySelector<HTMLElement>('[data-det]');
  if (root?.dataset.text) {
    type Text = Record<string, string> & { say: Record<string, string> };
    const T: Text = JSON.parse(root.dataset.text);
    root.hidden = false;
    const $ = <E extends Element = HTMLElement>(sel: string) => root.querySelector<E>(sel)!;
    const fill = (s: string, vars: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (m, k) => String(vars[k] ?? m));
    // Scientific names in italics (same names as Genus.astro).
    const NAMES = /((?:Aedes|Ae\.) (?:aegypti|albopictus)|(?:Culex|Cx\.) quinquefasciatus|Aedes|Culex)/;
    const rich = (el: HTMLElement, s: string) => el.replaceChildren(...s.split(NAMES).map((part, i) => (i % 2 ? Object.assign(document.createElement('em'), { textContent: part }) : part)));
    const live = $('[data-live]');
    const say = (s: string) => {
      live.textContent = '';
      setTimeout(() => (live.textContent = s), 60);
    };
    const shuffle = <V,>(list: V[]) => {
      const a = [...list];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    // The page never jumps to the top: a step's heading is scrolled to just under the
    // sticky header (or the top of the screen where the header doesn't stick), with the
    // photos or yard right below it, and only if it isn't already there. Where that would
    // leave too little of the photos or yard on the screen above the round's bar (small
    // phones at larger text), the photos or yard start just under the header instead.
    const siteHeader = document.querySelector<HTMLElement>('.site-header');
    const bringIntoView = (heading: HTMLElement, content?: HTMLElement | null, bar?: HTMLElement | null) => {
      const offset = siteHeader && getComputedStyle(siteHeader).position === 'sticky' ? siteHeader.offsetHeight : 0;
      const want = offset + 8;
      const top = heading.getBoundingClientRect().top;
      let delta = top < offset || top > want + 16 ? top - want : 0;
      if (content) {
        const barTop = bar ? innerHeight - bar.offsetHeight : innerHeight;
        const contentTop = content.getBoundingClientRect().top - delta;
        if (barTop - contentTop < Math.min(220, (barTop - want) / 2)) delta = content.getBoundingClientRect().top - want;
      }
      if (delta) window.scrollBy({ top: delta, behavior: 'instant' });
    };

    // Steps: one shows at a time; its heading takes focus.
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const show = (name: string, focus = true) => {
      for (const s of steps) s.hidden = s.dataset.step !== name;
      // Settle the layout before scrolling to the heading.
      if (name === 'photos') sizeHeading();
      if (name === 'yard') fitYard();
      if (focus) {
        // Focus moves to the new heading for screen readers, without the browser's own
        // scrolling; the heading is then brought just under the sticky header (unless it's
        // already there), with the photos or yard right below it.
        const step = steps.find((s) => s.dataset.step === name)!;
        const heading = step.querySelector<HTMLElement>('[data-step-heading]')!;
        heading.focus({ preventScroll: true });
        bringIntoView(heading, step.querySelector<HTMLElement>('[data-grid], [data-yard-frame]'), step.querySelector<HTMLElement>('.det-bar, .det-foot'));
      }
    };

    // ---- Rounds 1 and 2: photos ----
    const templates = [...root.querySelectorAll<HTMLTemplateElement>('template[data-photo]')];
    const aedes = templates.filter((t) => t.dataset.aedes === 'true').map((t) => t.dataset.photo!);
    const culex = templates.filter((t) => t.dataset.aedes !== 'true').map((t) => t.dataset.photo!);
    const grid = $('[data-grid]');
    const photosHeading = $('[data-photos-heading]');
    const photosRound = $('[data-photos-round]');
    const photosTitle = $('#det-photos-heading');
    const photosHelp = $('[data-photos-help]');
    const photosResult = $('[data-photos-result]');
    const resultFull = $('[data-result-full]');
    const resultShort = $('[data-result-short]');
    const checkBtn = $<HTMLButtonElement>('[data-check]');
    const nextBtn = $<HTMLButtonElement>('[data-next]');
    let round = 0;
    let used = new Set<string>();
    let scores: { n: number; total: number }[] = [];

    // Photos not shown yet come first, then the rest, each group in random order.
    const pick = (pool: string[], n: number) => [...shuffle(pool.filter((id) => !used.has(id))), ...shuffle(pool.filter((id) => used.has(id)))].slice(0, n);
    // The heading changes after Check ("Tap every Aedes" → "You found 1 of 2 Aedes"), which
    // may need another line (320px, larger text): it's kept as tall as the longer of the
    // two, so nothing under it moves.
    function sizeHeading() {
      const shown = [...photosHeading.childNodes].map((n) => n.cloneNode(true));
      photosTitle.style.minHeight = '';
      const now = photosTitle.offsetHeight;
      rich(photosHeading, fill(T.found, { n: 3, total: 3 }));
      const after = photosTitle.offsetHeight;
      photosHeading.replaceChildren(...shown);
      photosTitle.style.minHeight = `${Math.max(now, after)}px`;
    }
    addEventListener('resize', () => !photosTitle.closest('[hidden]') && sizeHeading());

    function startPhotoRound() {
      // 2 or 3 Aedes (as many as the photos allow), the rest Culex: 6 in all.
      const most = Math.min(3, aedes.length);
      const least = Math.min(most, Math.max(2, 6 - culex.length));
      const k = least + Math.floor(Math.random() * (most - least + 1));
      const ids = shuffle([...pick(aedes, k), ...pick(culex, 6 - k)]);
      ids.forEach((id) => used.add(id));
      grid.replaceChildren(
        ...ids.map((id) => {
          const tpl = templates.find((t) => t.dataset.photo === id)!;
          const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const btn = li.querySelector('button')!;
          btn.dataset.aedes = tpl.dataset.aedes;
          btn.addEventListener('click', () => btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true')));
          return li;
        }),
      );
      photosRound.textContent = fill(T.roundOf, { n: round + 1 });
      rich(photosHeading, T.photoRound);
      photosHelp.classList.remove('is-replaced');
      photosHelp.removeAttribute('aria-hidden');
      photosResult.hidden = true;
      checkBtn.hidden = false;
      nextBtn.hidden = true;
      show('photos');
    }

    checkBtn.addEventListener('click', () => {
      // The photos stay exactly where they are on the screen: if the text above them
      // changes height (the result line replaces the instructions, the heading becomes the
      // score), the page scrolls by the same amount.
      const anchor = grid.getBoundingClientRect().top;
      let found = 0;
      let missed = 0;
      let wrong = 0;
      let total = 0;
      for (const btn of grid.querySelectorAll<HTMLButtonElement>('button')) {
        const isAedes = btn.dataset.aedes === 'true';
        const picked = btn.getAttribute('aria-pressed') === 'true';
        const mark = btn.querySelector<HTMLElement>('[data-mark]')!;
        const state = isAedes ? (picked ? 'found' : 'missed') : picked ? 'wrong' : '';
        if (isAedes) total++;
        if (state === 'found') found++;
        if (state === 'missed') missed++;
        if (state === 'wrong') wrong++;
        btn.dataset.result = state || 'skipped';
        btn.dataset.kind = isAedes ? 'aedes' : 'culex';
        rich(mark, state === 'found' ? T.markFound : state === 'missed' ? T.markMissed : state === 'wrong' ? T.markWrong : '');
        mark.hidden = !state;
        btn.querySelector<HTMLElement>('[data-answer]')!.hidden = false;
        btn.disabled = true;
      }
      scores[round] = { n: found, total };
      const lines = [];
      if (!missed && !wrong) lines.push(T.allFound);
      if (missed) lines.push(missed === 1 ? T.missedOne : fill(T.missedMany, { n: missed }));
      if (wrong) lines.push(wrong === 1 ? T.wrongOne : fill(T.wrongMany, { n: wrong }));
      const heading = `${fill(T.roundOf, { n: round + 1 })}. ${fill(T.found, { n: found, total })}`;
      rich(photosHeading, fill(T.found, { n: found, total }));
      rich(resultFull, lines.join(' '));
      const S = T.resultShort as unknown as Record<string, string>;
      rich(resultShort, missed && wrong ? fill(S.both, { m: missed, w: wrong }) : missed ? fill(S.missed, { n: missed }) : wrong ? fill(S.wrong, { n: wrong }) : S.allFound);
      // The result takes the instructions' place; they keep their room (hidden), so on
      // phones, where the short result fits it, nothing above the photos changes height.
      photosHelp.classList.add('is-replaced');
      photosHelp.setAttribute('aria-hidden', 'true');
      photosResult.hidden = false;
      checkBtn.hidden = true;
      nextBtn.hidden = false;
      const shift = grid.getBoundingClientRect().top - anchor;
      if (Math.abs(shift) >= 1) window.scrollBy({ top: shift, behavior: 'instant' });
      // Focus moves for screen readers, without the browser's own scrolling.
      photosTitle.focus({ preventScroll: true });
      say(`${heading}. ${lines.join(' ')}`);
    });

    nextBtn.addEventListener('click', () => {
      round++;
      if (round < 2) startPhotoRound();
      else startYard();
    });

    // ---- Round 3: the yard ----
    const yardItems = [...root.querySelectorAll<HTMLButtonElement>('[data-yard-item]')];
    const boxes = [...root.querySelectorAll<HTMLElement>('[data-progress-box]')];
    const progress = $('[data-progress]');
    const yardResult = $('[data-yard-result]');
    const progressLine = $('[data-progress-line]');
    const doneBtn = $<HTMLButtonElement>('[data-done]');
    const finishBtn = $<HTMLButtonElement>('[data-finish]');
    const keyMissed = $('[data-key-missed]');
    const totalWater = yardItems.filter((b) => b.dataset.water === 'true').length;
    const foundCount = () => yardItems.filter((b) => b.dataset.state === 'found').length;
    const showProgress = () => {
      const n = foundCount();
      boxes.forEach((box, i) => box.classList.toggle('is-on', i < n));
      progress.textContent = fill(T.progress, { n });
      return n;
    };
    for (const btn of yardItems) {
      btn.addEventListener('click', () => {
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        if (on) btn.dataset.state = btn.dataset.water === 'true' ? 'found' : 'fine';
        else delete btn.dataset.state;
        const n = showProgress();
        if (on) say(`${T.say[btn.dataset.yardItem!]} ${fill(T.progress, { n })}`);
      });
    }
    // The compact yard wherever the whole one (at least 37.5rem wide) doesn't fit, so it
    // never scrolls sideways; the buttons follow its rows for the keyboard.
    const yardFrame = $('[data-yard-frame]');
    const yard = $('.yard');
    const fitYard = () => {
      if (!yardFrame.clientWidth) return; // the yard isn't showing
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const compact = yardFrame.clientWidth < 37.5 * rem;
      if (compact === yardFrame.hasAttribute('data-compact') && yard.dataset.placed) return;
      yardFrame.toggleAttribute('data-compact', compact);
      for (const key of (compact ? yard.dataset.compactOrder : yard.dataset.order)!.split(' ')) yard.append(yardItems.find((b) => b.dataset.yardItem === key)!);
      yard.dataset.placed = 'true';
    };
    new ResizeObserver(fitYard).observe(yardFrame);
    new MutationObserver(fitYard).observe(document.documentElement, { attributes: true, attributeFilter: ['data-text-size'] });
    function startYard() {
      for (const btn of yardItems) {
        btn.setAttribute('aria-pressed', 'false');
        btn.disabled = false;
        delete btn.dataset.state;
      }
      showProgress();
      yardResult.hidden = true;
      keyMissed.hidden = true;
      doneBtn.hidden = false;
      finishBtn.hidden = true;
      progressLine.hidden = false;
      show('yard');
    }
    doneBtn.addEventListener('click', () => {
      const n = foundCount();
      let missed = 0;
      for (const btn of yardItems) {
        btn.disabled = true;
        if (btn.dataset.water === 'true' && btn.dataset.state !== 'found') {
          missed++;
          btn.dataset.state = 'missed';
        }
      }
      scores[2] = { n, total: totalWater };
      const line = !missed ? T.yardAllFound : missed === 1 ? T.yardMissedOne : fill(T.yardMissedMany, { n: missed });
      const missedSay = yardItems.filter((b) => b.dataset.state === 'missed').map((b) => T.say[b.dataset.yardItem!]);
      yardResult.textContent = line;
      yardResult.hidden = false;
      progressLine.hidden = true;
      keyMissed.hidden = !missed;
      doneBtn.hidden = true;
      finishBtn.hidden = false;
      finishBtn.focus({ preventScroll: true }); // the yard stays where it is
      say([line, ...missedSay].join(' '));
    });
    finishBtn.addEventListener('click', () => {
      $('[data-scores]').replaceChildren(
        ...scores.map((s, i) => {
          const li = document.createElement('li');
          li.className = 'det-score';
          const b = document.createElement('strong');
          b.textContent = fill(T.roundScore, { n: i + 1 });
          li.append(b, ` ${fill(T.scoreOf, { n: s.n, total: s.total })}`);
          return li;
        }),
      );
      show('end');
    });

    // ---- Start and play again ----
    const begin = () => {
      round = 0;
      used = new Set();
      scores = [];
      startPhotoRound();
    };
    $('[data-start]').addEventListener('click', begin);
    $('[data-again]').addEventListener('click', begin);
    show('start', false);
  }
</script>

<style>
  .det-eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-text-muted);
