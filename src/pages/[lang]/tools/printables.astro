---
// Printables: the weekly checklist, the neighbor flyer, the "Spot the Aedes" poster
// (printables 1–3), the clean-up day flyer (the neighbor flyer with blanks), the
// when-to-get-care card (from the sick page) and the
// trip checklist (from "Traveling soon?", with a destination choice). Each card shows a
// small live preview (the real sheet, scaled down), a language choice and "Print or
// save as PDF" (the browser's own print, no extra libraries). Printing shows only the chosen sheet on one US Letter page.
// Without JavaScript: the previews show the page's language, and printing from the
// browser menu prints the shown sheets, one per page.
import ActionRow from '../../../components/ActionRow.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PrintChecklist from '../../../components/print/PrintChecklist.astro';
import PrintFlyer from '../../../components/print/PrintFlyer.astro';
import PrintPoster from '../../../components/print/PrintPoster.astro';
import PrintCareCard from '../../../components/print/PrintCareCard.astro';
import PrintTripChecklist from '../../../components/print/PrintTripChecklist.astro';
import travel from '../../../content/travel.json';
import { destinations } from '../../../lib/travel';
import sick from '../../../content/sick-page.json';
import Genus from '../../../components/Genus.astro';
import content from '../../../content/printables.json';
import { langStaticPaths, useTranslations } from '../../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const L = (lang === 'es' ? 'es' : 'en') as 'en' | 'es';
const text = content.text[L];
const pg = text.page;
const cards = [
  {
    key: 'checklist',
    title: text.checklist.printTitle,
    what: pg.checklistWhat,
    options: [
      ['en', pg.english],
      ['es', pg.spanish],
    ],
  },
  {
    key: 'flyer',
    title: text.flyer.title,
    what: pg.flyerWhat,
    options: [
      ['en', pg.english],
      ['es', pg.spanish],
      ['both', pg.bothFlyer],
    ],
  },
  {
    key: 'poster',
    title: text.poster.title,
    what: pg.posterWhat,
    options: [
      ['en', pg.english],
      ['es', pg.spanish],
      ['both', pg.bothPoster],
    ],
  },
  {
    key: 'cleanup',
    title: pg.cleanupTitle,
    what: pg.cleanupWhat,
    options: [
      ['en', pg.english],
      ['es', pg.spanish],
      ['both', pg.bothCleanup],
    ],
  },
  {
    key: 'care',
    title: sick.text[L].printTitle,
    what: pg.careWhat,
    options: [
      ['en', pg.english],
      ['es', pg.spanish],
      ['both', pg.bothCare],
    ],
  },
  {
    key: 'trip',
    title: travel.text[L].checkAny,
    what: travel.text[L].printWhat,
    options: [
      ['en', pg.english],
      ['es', pg.spanish],
      ['both', travel.text[L].bothTrip],
    ],
  },
] as const;

// Trip checklist: the destinations (names in both languages) and which CDC advice
// applies to each; the choice only filters the sheet in this browser.
const tripPlaces = destinations(lang);
const otherNames = Object.fromEntries(destinations(L === 'en' ? 'es' : 'en').map((d) => [d.code, d.name]));
const tripData = Object.fromEntries(tripPlaces.map((d) => [d.code, { f: d.flags, names: { [L]: d.name, [L === 'en' ? 'es' : 'en']: otherNames[d.code] } }]));
---

<BaseLayout lang={lang} title={t('pages.printables.title')} description={t('pages.printables.summary')}>
  <div class="page-intro">
    <div class="container">
      <h1>{t('pages.printables.title')}</h1>
      <p class="page-intro__lead">{pg.intro}</p>
      <ActionRow lang={lang} />
    </div>
  </div>

  <div class="container printables" data-printables>
    {
      cards.map((card) => (
        <section class="pcard" id={`printable-${card.key}`} aria-labelledby={`pcard-${card.key}`} data-pcard={card.key}>
          <div class="pcard__preview" aria-hidden="true">
            <div class="pcard__scale">
              {card.key === 'checklist' && (
                <>
                  <div class="pcard__variant" data-variant="en" data-default={L === 'en' ? '' : undefined}>
                    <PrintChecklist lang="en" id="checklist-en" />
                  </div>
                  <div class="pcard__variant" data-variant="es" data-default={L === 'es' ? '' : undefined}>
                    <PrintChecklist lang="es" id="checklist-es" />
                  </div>
                </>
              )}
              {card.key === 'flyer' && (
                <>
                  <div class="pcard__variant" data-variant="en" data-default={L === 'en' ? '' : undefined}>
                    <PrintFlyer langs={['en', 'en']} id="flyer-en" />
                  </div>
                  <div class="pcard__variant" data-variant="es" data-default={L === 'es' ? '' : undefined}>
                    <PrintFlyer langs={['es', 'es']} id="flyer-es" />
                  </div>
                  <div class="pcard__variant" data-variant="both">
                    <PrintFlyer langs={['en', 'es']} id="flyer-both" />
                  </div>
                </>
              )}
              {card.key === 'poster' && (
                <>
                  <div class="pcard__variant" data-variant="en" data-default={L === 'en' ? '' : undefined}>
                    <PrintPoster mode="en" id="poster-en" />
                  </div>
                  <div class="pcard__variant" data-variant="es" data-default={L === 'es' ? '' : undefined}>
                    <PrintPoster mode="es" id="poster-es" />
                  </div>
                  <div class="pcard__variant" data-variant="both">
                    <PrintPoster mode="both" id="poster-both" />
                  </div>
                </>
              )}
              {card.key === 'cleanup' && (
                <>
                  <div class="pcard__variant" data-variant="en" data-default={L === 'en' ? '' : undefined}>
                    <PrintFlyer langs={['en', 'en']} id="cleanup-en" variant="cleanup" />
                  </div>
                  <div class="pcard__variant" data-variant="es" data-default={L === 'es' ? '' : undefined}>
                    <PrintFlyer langs={['es', 'es']} id="cleanup-es" variant="cleanup" />
                  </div>
                  <div class="pcard__variant" data-variant="both">
                    <PrintFlyer langs={['en', 'es']} id="cleanup-both" variant="cleanup" />
                  </div>
                </>
              )}
              {card.key === 'care' && (
                <>
                  <div class="pcard__variant" data-variant="en" data-default={L === 'en' ? '' : undefined}>
                    <PrintCareCard langs={['en', 'en']} id="care-en" />
                  </div>
                  <div class="pcard__variant" data-variant="es" data-default={L === 'es' ? '' : undefined}>
                    <PrintCareCard langs={['es', 'es']} id="care-es" />
                  </div>
                  <div class="pcard__variant" data-variant="both">
                    <PrintCareCard langs={['en', 'es']} id="care-both" />
                  </div>
                </>
              )}
              {card.key === 'trip' && (
                <div data-trip-root>
                  <div class="pcard__variant" data-variant="en" data-default={L === 'en' ? '' : undefined}>
                    <PrintTripChecklist mode="en" id="trip-en" />
                  </div>
                  <div class="pcard__variant" data-variant="es" data-default={L === 'es' ? '' : undefined}>
                    <PrintTripChecklist mode="es" id="trip-es" />
                  </div>
                  <div class="pcard__variant" data-variant="both">
                    <PrintTripChecklist mode="both" id="trip-both" />
                  </div>
                </div>
              )}
            </div>
          </div>
          <div class="pcard__body">
            <h2 id={`pcard-${card.key}`} class="pcard__title">
              <Genus text={card.title} />
            </h2>
            <p class="pcard__what">
              <Genus text={card.what} />
            </p>
            {card.key === 'trip' && (
              <label class="pcard__dest js-only">
                <span>{travel.text[L].destination}</span>
                <select data-trip-dest={JSON.stringify(tripData)}>
                  <option value="">{travel.text[L].anyDestination}</option>
                  {tripPlaces.map((d) => (
                    <option value={d.code}>{d.name}</option>
                  ))}
                </select>
              </label>
            )}
            <fieldset class="pcard__langs js-only">
              <legend>{pg.language}</legend>
              {card.options.map(([value, label]) => (
                <label class="pcard__lang">
                  <input type="radio" name={`lang-${card.key}`} value={value} checked={value === L} data-lang-choice />
                  <span>{label}</span>
                  {card.key === 'trip' && value === 'both' && (
                    <span class="pcard__hint" data-trip-both-note>
                      ({travel.text[L].bothNeedsPlace})
                    </span>
                  )}
                </label>
              ))}
            </fieldset>
            <button type="button" class="btn btn-primary js-only" data-print-card>
              {pg.print}
            </button>
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { applyTrip } from '../../../lib/trip-client';

  // Language choice swaps the preview; "Print or save as PDF" prints only that sheet.
  for (const card of document.querySelectorAll<HTMLElement>('[data-pcard]')) {
    const variants = [...card.querySelectorAll<HTMLElement>('[data-variant]')];
    const show = (value: string) => {
      for (const v of variants) v.toggleAttribute('data-shown', v.dataset.variant === value);
    };
    const checked = card.querySelector<HTMLInputElement>('[data-lang-choice]:checked');
    show(checked?.value ?? 'en');
    for (const radio of card.querySelectorAll<HTMLInputElement>('[data-lang-choice]')) {
      radio.addEventListener('change', () => show(radio.value));
    }
    card.querySelector('[data-print-card]')?.addEventListener('click', () => {
      document.body.dataset.printing = card.dataset.pcard;
      window.print();
    });
  }
  // Trip checklist: the destination choice keeps only the items CDC recommends there.
  const dest = document.querySelector<HTMLSelectElement>('[data-trip-dest]');
  const tripRoot = document.querySelector<HTMLElement>('[data-pcard="trip"] [data-trip-root]');
  if (dest?.dataset.tripDest && tripRoot) {
    const places = JSON.parse(dest.dataset.tripDest) as Record<string, { f: string[]; names: Record<string, string> }>;
    // English and Spanish side by side fit on one page only for a chosen destination.
    const both = document.querySelector<HTMLInputElement>('[data-pcard="trip"] [data-lang-choice][value="both"]');
    const bothNote = document.querySelector<HTMLElement>('[data-trip-both-note]');
    const apply = () => {
      const p = places[dest.value];
      applyTrip(tripRoot, p ? { flags: p.f, names: p.names } : null);
      if (both) {
        both.disabled = !p;
        if (bothNote) bothNote.hidden = Boolean(p);
        if (!p && both.checked) document.querySelector<HTMLInputElement>(`[data-pcard="trip"] [data-lang-choice][value="${document.documentElement.lang.startsWith('es') ? 'es' : 'en'}"]`)?.click();
      }
    };
    dest.addEventListener('change', apply);
    apply();
  }
  window.addEventListener('afterprint', () => {
    delete document.body.dataset.printing;
  });
</script>

<style>
  .printables {
    display: grid;
    gap: var(--section-gap);
    padding-block: var(--section-gap);
  }

  .pcard {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4) var(--space-5);
    align-items: start;
    padding: var(--pad-box-lg);
    border: 3px solid var(--color-rule);
    background: var(--color-surface);
  }

  @media (max-width: 40rem) {
    .pcard {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Preview: the real 720 × 960px sheet, scaled to 216 × 288px. */
  /* The sheet (720 × 960) at 30% is 216 × 288; the box adds its 1px border on each side
     so the whole sheet, down to "Scan to learn more", fits inside it. */
  .pcard__preview {
    width: calc(216px + 2px);
    height: calc(288px + 2px);
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: #ffffff;
    box-shadow: 3px 3px 0 var(--color-rule);
  }

  .pcard__scale {
    width: 720px;
    transform: scale(0.3);
    transform-origin: 0 0;
  }

  /* One variant shows: the chosen one (with JS) or the page's language (without). */
  .pcard__variant {
    display: none;
  }

  .pcard__variant[data-default] {
    display: block;
  }

  :global(.js) .pcard__variant[data-default]:not([data-shown]) {
    display: none;
  }

  :global(.js) .pcard__variant[data-shown] {
    display: block;
  }

  .pcard__title {
    margin-bottom: var(--space-1);
  }

  .pcard__what {
    margin-bottom: var(--space-3);
  }

  /* One column that can shrink: the destination menu is as wide as its longest place
     name, which would otherwise push past a phone's edge. */
  .pcard__dest {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    max-width: 22rem;
    margin-bottom: var(--space-3);
  }

  /* Phones: a name too long for the box ends in "…" in Chrome (WebKit just clips it);
     not used wider up, where Chrome would shorten names that fit. */
  @media (max-width: 30rem) {
    .pcard__dest select {
      text-overflow: ellipsis;
    }
  }

  .pcard__dest span {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  /* overflow: WebKit draws a long chosen name ("Cualquier destino (todos los puntos)"
     at larger text on a 320px phone) past the box's edge, widening the page. */
  .pcard__dest select {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    min-height: var(--tap-target);
    padding: var(--space-1) var(--space-2);
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-field-bg);
    color: var(--color-field-text);
    font: inherit;
  }

  .pcard__langs {
    margin: 0 0 var(--space-3);
    padding: 0;
    border: 0;
  }

  .pcard__langs legend {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  .pcard__lang {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    cursor: pointer;
  }

  .pcard__lang:has(input:disabled) {
    cursor: default;
  }

  .pcard__hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .pcard__hint[hidden] {
    display: none;
  }

  .pcard__lang input {
    width: 22px;
    height: 22px;
    accent-color: var(--color-link);
  }

  .js-only {
    display: none !important;
  }

  :global(.js) .printables .js-only {
    display: revert !important;
  }

  :global(.js) .printables label.pcard__dest.js-only {
    display: grid !important;
  }

  :global(.js) .printables button.js-only {
    display: inline-flex !important;
  }

  /* ---- Print: US Letter, 0.5in margins, only the sheet(s) ---- */
  @media print {
    @page {
      size: letter;
      margin: 0.5in;
    }

    :global(body > :not(main)),
    :global(main > :not(.printables)) {
      display: none !important;
    }

    :global(body) {
      padding: 0 !important;
      background: #ffffff !important;
    }

    .printables {
      display: block;
      padding: 0;
    }

    .pcard {
      display: block;
      padding: 0;
      border: 0;
    }

    .pcard__body {
      display: none;
    }

    .pcard__preview {
      width: auto;
      height: auto;
      overflow: visible;
      border: 0;
      box-shadow: none;
    }

    .pcard__scale {
      transform: none;
    }

    /* Without JavaScript (printing from the browser menu): each shown sheet on its own page. */
    .pcard + .pcard {
      break-before: page;
    }

    /* With the button: only that card's chosen sheet. */
    :global(body[data-printing]) .pcard {
      display: none;
    }

    :global(body[data-printing='checklist']) .pcard[data-pcard='checklist'],
    :global(body[data-printing='flyer']) .pcard[data-pcard='flyer'],
    :global(body[data-printing='poster']) .pcard[data-pcard='poster'],
    :global(body[data-printing='care']) .pcard[data-pcard='care'],
    :global(body[data-printing='cleanup']) .pcard[data-pcard='cleanup'],
    :global(body[data-printing='trip']) .pcard[data-pcard='trip'] {
      display: block;
      break-before: auto;
    }
  }
</style>
