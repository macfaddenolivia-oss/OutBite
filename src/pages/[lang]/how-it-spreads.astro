---
// How it spreads: a nine-step tap-through story (Oct 15 2026 decisions).
// Text, Spanish and sources: src/content/how-it-spreads.json. Drawings:
// src/components/story/.
// With JavaScript: one scene at a time, Back/Next and arrow keys, opening toggle.
// Without JavaScript: all scenes stacked, both openings shown and labeled.
import ActionRow from '../../components/ActionRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceLine from '../../components/SourceLine.astro';
import Genus from '../../components/Genus.astro';
import AedesPhoto from '../../components/AedesPhoto.astro';
import SceneMeet from '../../components/story/SceneMeet.astro';
import SceneFirstBite from '../../components/story/SceneFirstBite.astro';
import SceneOpening from '../../components/story/SceneOpening.astro';
import SceneBite from '../../components/story/SceneBite.astro';
import SceneInside from '../../components/story/SceneInside.astro';
import SceneNextBite from '../../components/story/SceneNextBite.astro';
import SceneMoreMosquitoes from '../../components/story/SceneMoreMosquitoes.astro';
import SceneNewInfection from '../../components/story/SceneNewInfection.astro';
import SceneCycle from '../../components/story/SceneCycle.astro';
import OpeningChoice from '../../components/story/OpeningChoice.astro';
import StoryProgress from '../../components/story/StoryProgress.astro';
import story from '../../content/how-it-spreads.json';
import { assetPath, defaultLocale, langStaticPaths, localizePath, useTranslations } from '../../i18n';
import { getPage } from '../../config/pages';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const text = (story.text as Record<string, (typeof story.text)['en']>)[lang] ?? story.text[defaultLocale as 'en'];
const cite = story.cite as Record<string, string[]>;
const s = text.scenes;
const title = t('pages.howItSpreads.title');
const total = 9;
const stepOf = (n: number) => text.stepOf.replace('{n}', String(n)).replace('{total}', String(total));
const layerKeys = ['body', 'home', 'yard', 'community'] as const;
const layerStep = {
  body: text.layers.stepAnaMosquito,
  home: text.layers.stepMosquitoNeighbor,
  yard: text.layers.stepBucketMosquito,
  community: text.layers.stepCommunity,
};
const names = { ana: text.diagram.ana, neighbor: text.diagram.neighbor };
// "More mosquitoes" strip, in this order (icons in public/story/water/).
const eggSpots = [
  ['tire', 'tire'],
  ['plantSaucer', 'plant-saucer'],
  ['petBowl', 'pet-bowl'],
  ['birdbath', 'birdbath'],
  ['bottleCap', 'bottle-cap'],
  ['upturnedLid', 'upturned-lid'],
] as const;
const headings = [s.meet.heading, s.firstBite.heading, s.openingTravel.heading, s.bite.heading, s.inside.heading, s.nextBite.heading, s.moreMosquitoes.heading, s.newInfection.heading, s.cycle.heading];
const openings = [
  ['local', text.openingLocalLabel],
  ['travel', text.openingTravelLabel],
] as const;
---

<BaseLayout lang={lang} title={title} description={t('pages.howItSpreads.summary')}>
  <div class="page-intro">
    <div class="container">
      <div class="story-intro">
        <h1>{title}</h1>
        <p class="page-intro__lead story-intro__lead"><Genus text={text.intro} /></p>
      </div>
      <ActionRow lang={lang} />
    </div>
  </div>

  <div class="story-band">
  <div class="container story" data-story data-scroll-managed data-opening="travel">
    <OpeningChoice heading={text.choiceHeading} local={text.openingLocalLabel} travel={text.openingTravelLabel} />

    {/* One frame for all nine steps: the steps share one grid cell (inactive ones are
        hidden with visibility), so the frame is always as tall as the tallest step and
        the nav bar never moves. */}
    <div class="story-frame">
    <ol class="scenes">
      {/* ---- Scene 1: meet the Aedes mosquito (both openings) ---- */}
      <li class="scene is-active" data-scene="0">
        <div class="scene__text">
          <p class="scene__step">{stepOf(1)}</p>
          <StoryProgress current={0} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1"><Genus text={s.meet.heading} /></h2>
          <p class="scene__callout-text">{s.meet.calloutAedes}</p>
          <p class="scene__meet-caption"><Genus text={s.meet.caption} /></p>
          {/* Phones: the photo sits here, in the text, so the picture panel stays short. */}
          <div class="meet-photo meet-photo--text phone-only">
            <AedesPhoto lang={lang} story link={{ href: localizePath(lang, getPage('detective').path), text: t('faqLinks.detective') }} />
          </div>
          <div class="scene__notebox">
            <p><Genus text={s.meet.note} /></p>
            {/* Closed by default so step 1 fits the same frame as the other steps. */}
            <details class="scene__where">
              <summary>{s.meet.states.toggle}</summary>
              <p class="scene__states">
                {s.meet.states.lines.map((line: string, i: number) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </p>
            </details>
          </div>
          <div class="scene__meet-foot">
            <SourceLine lang={lang} ids={cite.meet} collapsed />
            <a class="scene__faq" href={`${localizePath(lang, getPage('faq').path)}#spot-aedes`}><Genus text={t('faqLinks.faqSpotShort')} /> <span aria-hidden="true">→</span><span class="visually-hidden"> (<Genus text={t('faqLinks.faqSpot')} />)</span></a>
          </div>
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure scene__figure--sky">
          <div class="art art--meet">
            <SceneMeet label={s.meet.label} aedesName={s.meet.aedesName} culexName={s.meet.culexName} />
            <p class="callout callout--aedes" aria-hidden="true">{s.meet.calloutAedes}</p>
            <div class="meet-photo not-phone">
              <AedesPhoto lang={lang} story link={{ href: localizePath(lang, getPage('detective').path), text: t('faqLinks.detective') }} />
            </div>
          </div>
        </div>
      </li>

      {/* ---- Scene 2: the first bite (two versions) ---- */}
      <li class="scene" data-scene="1">
        <div class="scene__text">
          <p class="scene__step">{stepOf(2)}</p>
          <StoryProgress current={1} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.firstBite.heading}</h2>
          <div class="variant-stack">
            {
              openings.map(([key]) => (
                <div class={`variant v-${key}`}>
                  <p><Genus text={key === 'local' ? s.firstBite.captionLocal : s.firstBite.captionTravel} /></p>
                </div>
              ))
            }
          </div>
          <SourceLine lang={lang} ids={cite.firstBite} />
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure">
          {
            openings.map(([key, name]) => (
              <div class={`variant v-${key}`}>
                <p class="variant__label no-js-only">{text.noJsOpening.replace('{name}', name)}</p>
                <div class="art">
                  <SceneFirstBite
                    label={key === 'local' ? s.firstBite.labelLocal : s.firstBite.labelTravel}
                    travel={key === 'travel'}
                    names={names}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </li>

      {/* ---- Scene 3: opening (two versions) ---- */}
      <li class="scene" data-scene="2">
        <div class="scene__text">
          <p class="scene__step">{stepOf(3)}</p>
          <StoryProgress current={2} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <div class="variant-stack">
          {
            openings.map(([key]) => {
              const sc = key === 'local' ? s.openingLocal : s.openingTravel;
              return (
                <div class={`variant v-${key}`}>
                  <h2 class="scene__heading" tabindex="-1">{sc.heading}</h2>
                  <p class="scene__callout-text">{sc.callout}</p>
                  <p><Genus text={sc.caption} /></p>
                  <SourceLine lang={lang} ids={key === 'local' ? cite.openingLocal : cite.openingTravel} />
                </div>
              );
            })
          }
          </div>
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure">
          {
            openings.map(([key, name]) => (
              <div class={`variant v-${key}`}>
                <p class="variant__label no-js-only">{text.noJsOpening.replace('{name}', name)}</p>
                <div class="art">
                  <SceneOpening
                    label={key === 'local' ? s.openingLocal.label : s.openingTravel.label}
                    travel={key === 'travel'}
                    names={names}
                  />
                  <p class="callout callout--ana" aria-hidden="true">
                    {s.openingLocal.callout}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </li>

      {/* ---- Scene 4: the bite ---- */}
      <li class="scene" data-scene="3">
        <div class="scene__text">
          <p class="scene__step">{stepOf(4)}</p>
          <StoryProgress current={3} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.bite.heading}</h2>
          <p class="scene__callout-text"><Genus text={s.bite.callout} /></p>
          <p><Genus text={s.bite.caption} /></p>
          <SourceLine lang={lang} ids={cite.bite} />
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure">
          <div class="art">
            <SceneBite label={s.bite.label} name={names.ana} id="flight-bite" />
            <p class="callout callout--mosquito" aria-hidden="true"><Genus text={s.bite.callout} /></p>
          </div>
        </div>
      </li>

      {/* ---- Scene 5: inside the mosquito ---- */}
      <li class="scene" data-scene="4">
        <div class="scene__text">
          <p class="scene__step">{stepOf(5)}</p>
          <StoryProgress current={4} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.inside.heading}</h2>
          <p><Genus text={s.inside.caption} /></p>
          <SourceLine lang={lang} ids={cite.inside} />
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure scene__figure--sky">
          <div class="art art--inside">
            <SceneInside label={s.inside.label} timeline={s.inside.timeline} />
          </div>
        </div>
      </li>

      {/* ---- Scene 6: the next bite (same picture in both openings) ---- */}
      <li class="scene" data-scene="5">
        <div class="scene__text">
          <p class="scene__step">{stepOf(6)}</p>
          <StoryProgress current={5} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.nextBite.heading}</h2>
          <p class="scene__callout-text"><Genus text={s.nextBite.callout} /></p>
          <p><Genus text={s.nextBite.caption} /></p>
          <p>{s.nextBite.virusGone}</p>
          <SourceLine lang={lang} ids={cite.nextBite} compact />
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure">
          <div class="art">
            <SceneNextBite label={s.nextBite.label} names={names} virusGone={text.diagram.virusGone} />
            <p class="callout callout--next" aria-hidden="true"><Genus text={s.nextBite.callout} /></p>
          </div>
        </div>
      </li>

      {/* ---- Scene 7: more mosquitoes (same picture in both openings) ---- */}
      <li class="scene" data-scene="6">
        <div class="scene__text">
          <p class="scene__step">{stepOf(7)}</p>
          <StoryProgress current={6} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.moreMosquitoes.heading}</h2>
          <p class="scene__callout-text"><Genus text={s.moreMosquitoes.callout} /></p>
          <p>{s.moreMosquitoes.caption}</p>
          <p>{s.moreMosquitoes.containers}</p>
          {/* Phones: the "Where mosquitoes lay eggs" strip sits here, in the text. */}
          <div class="egg-spots egg-spots--text phone-only">
            <p class="egg-spots__title">{s.moreMosquitoes.eggSpots.title}</p>
            <ul class="egg-spots__list">
              {
                eggSpots.map(([key, file]) => (
                  <li>
                    <img src={assetPath(`story/water/${file}.svg`)} alt="" width="40" height="40" />
                    <span>{s.moreMosquitoes.eggSpots.items[key]}</span>
                  </li>
                ))
              }
            </ul>
            <p class="egg-spots__title egg-spots__more">{s.moreMosquitoes.eggSpots.more}</p>
          </div>
          <SourceLine lang={lang} ids={cite.moreMosquitoes} compact />
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure scene__figure--eggs">
          <div class="art art--more">
            <SceneMoreMosquitoes label={s.moreMosquitoes.label} />
            <p class="callout callout--more" aria-hidden="true"><Genus text={s.moreMosquitoes.callout} /></p>
          </div>
          {/* Other places mosquitoes lay eggs: a labeled strip on the ground, under the bucket. */}
          <div class="egg-spots not-phone">
            <p class="egg-spots__title">{s.moreMosquitoes.eggSpots.title}</p>
            <ul class="egg-spots__list">
              {
                eggSpots.map(([key, file]) => (
                  <li>
                    <img src={assetPath(`story/water/${file}.svg`)} alt="" width="40" height="40" />
                    <span>{s.moreMosquitoes.eggSpots.items[key]}</span>
                  </li>
                ))
              }
            </ul>
            <p class="egg-spots__title egg-spots__more">{s.moreMosquitoes.eggSpots.more}</p>
          </div>
        </div>
      </li>

      {/* ---- Scene 8: a new infection ---- */}
      <li class="scene" data-scene="7">
        <div class="scene__text">
          <p class="scene__step">{stepOf(8)}</p>
          <StoryProgress current={7} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.newInfection.heading}</h2>
          <p class="scene__callout-text">{s.newInfection.callout}</p>
          <p><Genus text={s.newInfection.caption} /></p>
          <p class="scene__note">{s.newInfection.note}</p>
          <SourceLine lang={lang} ids={cite.newInfection} />
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure">
          <div class="art">
            <SceneNewInfection label={s.newInfection.label} name={names.neighbor} days={s.newInfection.calendar} />
            <p class="callout callout--neighbor" aria-hidden="true">{s.newInfection.callout}</p>
          </div>
        </div>
      </li>

      {/* ---- Scene 9: break the cycle (interactive) ---- */}
      <li class="scene" data-scene="8">
        <div class="scene__text">
          <p class="scene__step">{stepOf(9)}</p>
          <StoryProgress current={8} headings={headings} localHeading={s.openingLocal.heading} template={text.stepButton} groupLabel={text.stepsGroup} />
          <h2 class="scene__heading" tabindex="-1">{s.cycle.heading}</h2>
          <p class="scene__closing">{s.cycle.closing}</p>
          <div class="layer-buttons is-pulsing js-only" role="group" aria-label={text.layers.groupLabel} data-layer-buttons>
            {
              layerKeys.map((key) => (
                <button type="button" class={`layer-btn layer-btn--${key}`} data-layer={key} aria-pressed="false">
                  <span class="layer-btn__name">{text.layers[key]}</span>
                  <span class="layer-btn__icon" aria-hidden="true">
                    <span class="layer-btn__arrow">→</span>
                    <span class="layer-btn__check">✓</span>
                  </span>
                </button>
              ))
            }
          </div>

          {/* All eight explanations (4 layers × 2 openings) share one grid cell, so the
              box is always as tall as the longest one and the layout never jumps. Until a
              layer is chosen, the same cell shows the instruction, pointing up at the
              buttons. */}
          <div class="layer-explain js-only" data-layer-explain>
            <p class="tap-callout">
              <svg class="tap-callout__arrow" viewBox="0 0 24 30" width="20" height="25" aria-hidden="true">
                <path d="M12 28 V7" stroke="currentColor" stroke-width="5"></path>
                <path d="M3 13 L12 3 L21 13" fill="none" stroke="currentColor" stroke-width="5"></path>
              </svg>
              <span>{s.cycle.caption}</span>
            </p>
            {
              layerKeys.flatMap((key) =>
                (['travel', 'local'] as const).map((op) => (
                  <div class="layer-explain__item" data-for={key} data-opening-text={op}>
                    <p>
                      <strong>{text.layers[key]}:</strong>{' '}
                      {key === 'body' ? (op === 'travel' ? text.layers.bodyTravel : text.layers.bodyLocal) : text.layers[`${key}Text` as 'homeText']}
                    </p>
                    <SourceLine lang={lang} ids={key === 'body' ? (op === 'travel' ? cite.bodyTravel : cite.bodyLocal) : cite[key]} compact />
                  </div>
                )),
              )
            }
          </div>
          <p class="visually-hidden" aria-live="polite" data-layer-announce></p>
          <template data-layer-sr>
            {layerKeys.map((key) => <span data-for={key}>{text.layers.blockedSr.replace('{step}', layerStep[key])}</span>)}
          </template>

          <!-- Without JavaScript: all four layers as a list, with their sources -->
          <ul class="layers-static no-js-only">
            <li><strong>{text.layers.body}:</strong> {text.layers.bodyTravel} ({text.openingTravelLabel}) / {text.layers.bodyLocal} ({text.openingLocalLabel})</li>
            <li><strong>{text.layers.home}:</strong> {text.layers.homeText}</li>
            <li><strong>{text.layers.yard}:</strong> {text.layers.yardText}</li>
            <li><strong>{text.layers.community}:</strong> {text.layers.communityText}</li>
          </ul>
          <div class="no-js-only">
            <SourceLine lang={lang} ids={[...new Set([...cite.bodyTravel, ...cite.bodyLocal, ...cite.home, ...cite.yard, ...cite.community])]} />
          </div>

          {/* Phones: "Start from the beginning" sits here, so Back and the Protect link keep
              one row in the nav bar. */}
          <p class="scene__restart phone-only">
            <button type="button" class="btn btn-secondary" data-restart><span aria-hidden="true">↺</span> {text.restart}</button>
          </p>

          {/* Without JavaScript there is no nav bar, so the Protect link sits here. */}
          <p class="no-js-only">
            <a href={`${localizePath(lang, getPage('protect').path)}#layer-yard`}>{text.protectCard} <span aria-hidden="true">→</span></a>
          </p>
        </div>
        {/* Phones: the text above scrolls inside the box; this shows while there is more below. */}
        <p class="scroll-hint" aria-hidden="true">{text.scrollHint} <span>↓</span></p>
        <div class="scene__figure">
          <div class="art art--cycle">
            <SceneCycle label={s.cycle.label} t={text.diagram} />
          </div>
        </div>
      </li>
    </ol>
    {/* Last step: Back, "Start from the beginning" (middle) and the Protect link in
        Next's place and style. */}
    <div class="story-nav js-only" data-story-nav>
      <button type="button" class="btn btn-secondary story-nav__back" data-go="-1" disabled><span aria-hidden="true">←</span> <span class="story-nav__back-word">{text.back}</span></button>
      <button type="button" class="btn btn-secondary story-nav__restart" data-restart hidden><span aria-hidden="true">↺</span> {text.restart}</button>
      <button type="button" class="btn btn-primary story-nav__next" data-go="1">{text.next} <span aria-hidden="true">→</span></button>
      <a class="btn btn-primary story-nav__protect" href={`${localizePath(lang, getPage('protect').path)}#layer-yard`} hidden data-protect-link>
        {text.protectCard} <span aria-hidden="true">→</span>
      </a>
    </div>
    </div>
  </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-story]');
  if (root) {
    const scenes = [...root.querySelectorAll<HTMLElement>('.scene')];
    const cycle = root.querySelector<SVGElement>('[data-cycle]');
    const explain = root.querySelector<HTMLElement>('[data-layer-explain]');
    const announce = root.querySelector<HTMLElement>('[data-layer-announce]');
    const srTexts = root.querySelector<HTMLTemplateElement>('[data-layer-sr]');
    const layerButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-layer]')];
    const openingButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-opening-choice]')];
    let current = 0;
    // Whether the last input was the keyboard (a key press, including Enter or Space on a
    // button) rather than a pointer: the new step's heading then shows its focus ring.
    let keyboardNav = false;
    document.addEventListener('keydown', () => (keyboardNav = true), true);
    document.addEventListener('pointerdown', () => (keyboardNav = false), true);
    let layer = '';

    // The story opens with "After a trip"; the visitor can switch to "Caught nearby".
    // (No place is remembered anywhere on the site.)
    let opening = 'travel';

    // The heading of the shown step and opening. Chosen from state, not computed
    // visibility: under reduced motion every property gets a tiny transition, so
    // visibility can still read "hidden" at this moment.
    const visibleHeading = (scene: HTMLElement) =>
      [...scene.querySelectorAll<HTMLElement>('.scene__heading')].find((h) => {
        const variant = h.closest<HTMLElement>('.variant');
        return !variant || variant.classList.contains(`v-${opening}`);
      });
    const back = root.querySelector<HTMLButtonElement>('[data-story-nav] [data-go="-1"]');
    const next = root.querySelector<HTMLButtonElement>('[data-story-nav] [data-go="1"]');
    const nav = root.querySelector<HTMLElement>('[data-story-nav]');
    const restart = root.querySelector<HTMLButtonElement>('[data-story-nav] [data-restart]');
    const protectLink = root.querySelector<HTMLElement>('[data-protect-link]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Scene 2: the mosquito flies along the dotted path while the line draws
    // behind it. One requestAnimationFrame timeline drives both: the same progress
    // places the mosquito (getPointAtLength, rotated along the curve) and reveals the
    // line up to exactly that point (mask stroke-dashoffset, pathLength = 1).
    // Reduced motion: the finished picture only.
    const FLIGHT_MS = 1800;
    // Quick lift-off out of the bucket (clear of the handle by the time it reaches
    // full size), gentle landing: ease-out cubic.
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    // The mosquito emerges from the water: 40% size and transparent at the start,
    // full size and opacity after the first 15% of the flight.
    const EMERGE = 0.15;
    const START_SIZE = 0.4;
    const flights = new Map<SVGSVGElement, number>();

    // Body stays nearly level: tilt follows the climb/descent but never more than
    // ±20°, and the mosquito faces the way it travels (flipped horizontally if it
    // ever heads right), so it is never upside down or vertical.
    const MAX_TILT = 20;

    function placeFlight(svg: SVGSVGElement, progress: number, grow = 1) {
      const path = svg.querySelector<SVGPathElement>('[data-flight-path]');
      const reveal = svg.querySelector<SVGPathElement>('[data-flight-reveal]');
      const flyer = svg.querySelector<SVGGElement>('[data-flyer]');
      if (!path || !reveal || !flyer) return;
      const length = path.getTotalLength();
      const at = progress * length;
      const p = path.getPointAtLength(at);
      const a = path.getPointAtLength(Math.max(0, at - 1));
      const b = path.getPointAtLength(Math.min(length, at + 1));
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const facingLeft = dx <= 0; // the drawing faces left
      const tilt = Math.max(-MAX_TILT, Math.min(MAX_TILT, (Math.atan2(dy, Math.abs(dx)) * 180) / Math.PI));
      // Descending (dy > 0) dips the head: counter-clockwise when facing left.
      const rotate = facingLeft ? -tilt : tilt;
      const size = START_SIZE + (1 - START_SIZE) * grow;
      // The path ends level; at the very end use the still picture's own transform
      // so the last frame matches it exactly (no leftover fraction of a degree).
      flyer.dataset.still ??= flyer.getAttribute('transform') ?? '';
      flyer.setAttribute(
        'transform',
        progress >= 1
          ? flyer.dataset.still
          : `translate(${p.x} ${p.y}) rotate(${rotate.toFixed(2)}) scale(${(facingLeft ? size : -size).toFixed(3)} ${size.toFixed(3)})`,
      );
      flyer.style.opacity = String(grow);
      reveal.style.strokeDashoffset = String(1 - progress);
    }

    function fly(scene: HTMLElement) {
      for (const svg of scene.querySelectorAll<SVGSVGElement>('[data-flight]')) {
        cancelAnimationFrame(flights.get(svg) ?? 0);
        if (reduceMotion.matches) {
          placeFlight(svg, 1);
          continue;
        }
        const start = performance.now();
        const frame = (now: number) => {
          const t = Math.min(1, (now - start) / FLIGHT_MS);
          placeFlight(svg, ease(t), Math.min(1, t / EMERGE));
          if (t < 1) flights.set(svg, requestAnimationFrame(frame));
        };
        placeFlight(svg, 0, 0);
        flights.set(svg, requestAnimationFrame(frame));
      }
    }

    // Phones: each step's text scrolls inside the box. "Scroll for more ↓" shows while
    // there is more below (data-more on the text area).
    const textOf = (scene: HTMLElement) => scene.querySelector<HTMLElement>('.scene__text');
    const updateMore = (box = textOf(scenes[current])) => {
      if (box) box.toggleAttribute('data-more', box.scrollHeight - box.scrollTop - box.clientHeight > 2);
    };
    for (const scene of scenes) {
      const box = textOf(scene);
      box?.addEventListener('scroll', () => updateMore(box), { passive: true });
    }
    addEventListener('resize', () => updateMore());
    // A "Sources" or "Show where" list opening or closing changes the text's height.
    root.addEventListener('toggle', () => updateMore(), true);
    document.fonts?.ready.then(() => updateMore());

    function show(index: number, focus: boolean) {
      current = Math.max(0, Math.min(scenes.length - 1, index));
      scenes.forEach((scene, i) => scene.classList.toggle('is-active', i === current));
      // Each step opens at the top of its text.
      const box = textOf(scenes[current]);
      if (box) box.scrollTop = 0;
      updateMore(box);
      // Shared nav bar: Back disabled on step 1. Last step: Next is replaced by the
      // Protect link, and "Start from the beginning" appears in the middle.
      const last = current === scenes.length - 1;
      if (back) back.disabled = current === 0;
      if (next) next.hidden = last;
      if (restart) restart.hidden = !last;
      if (protectLink) protectLink.hidden = !last;
      nav?.classList.toggle('is-last', last);
      fly(scenes[current]);
      if (focus) {
        const heading = visibleHeading(scenes[current]);
        if (heading) {
          heading.toggleAttribute('data-focus-ring', keyboardNav);
          // preventScroll: the page never moves on its own when the step changes.
          heading.focus({ preventScroll: true });
        }
      }
    }

    function updateLayer() {
      if (cycle) {
        if (layer) cycle.setAttribute('data-block', layer);
        else cycle.removeAttribute('data-block');
      }
      for (const b of layerButtons) b.setAttribute('aria-pressed', String(b.dataset.layer === layer));
      if (explain) {
        explain.dataset.layer = layer;
        let shown: HTMLElement | undefined;
        for (const item of explain.querySelectorAll<HTMLElement>('.layer-explain__item')) {
          const match = item.dataset.for === layer && item.dataset.openingText === opening;
          item.classList.toggle('is-shown', match);
          if (match) shown = item;
        }
        if (announce) {
          const sr = srTexts?.content.querySelector(`[data-for="${layer}"]`)?.textContent ?? '';
          announce.textContent = shown ? `${sr} ${shown.querySelector('p')?.textContent ?? ''}` : '';
        }
        // Phones: if the explanation is below the visible part of the text, scroll the
        // text (not the page) just enough to show it above "Scroll for more".
        const box = explain.closest<HTMLElement>('.scene__text');
        if (layer && box && box.scrollHeight > box.clientHeight) {
          const below = explain.getBoundingClientRect().bottom - box.getBoundingClientRect().bottom + (parseFloat(getComputedStyle(box).scrollPaddingBottom) || 0);
          if (below > 0) box.scrollTop += below;
        }
      }
    }

    function setOpening(value: string) {
      opening = value;
      root!.dataset.opening = value;
      for (const b of openingButtons) b.setAttribute('aria-pressed', String(b.dataset.openingChoice === value));
      // Step 1's progress button names the heading of the chosen opening.
      for (const b of root!.querySelectorAll<HTMLElement>('[data-heading-local]')) {
        b.setAttribute('aria-label', (value === 'local' ? b.dataset.headingLocal : b.dataset.headingTravel) ?? '');
        b.dataset.tip = (value === 'local' ? b.dataset.tipLocal : b.dataset.tipTravel) ?? '';
      }
      updateLayer();
      updateMore();
    }

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('button');
      if (!target) return;
      if (target.dataset.goto !== undefined) show(Number(target.dataset.goto), true);
      else if (target.dataset.go) show(current + Number(target.dataset.go), true);
      // Back to step 1, keeping the chosen opening; focus moves to its heading.
      else if (target.dataset.restart !== undefined) show(0, true);
      else if (target.dataset.openingChoice) setOpening(target.dataset.openingChoice);
      else if (target.dataset.layer) {
        root!.querySelector('[data-layer-buttons]')?.classList.remove('is-pulsing');
        layer = layer === target.dataset.layer ? '' : target.dataset.layer;
        updateLayer();
      }
    });

    root.addEventListener('keydown', (event) => {
      const el = event.target as HTMLElement;
      if (el.matches('input, select, textarea')) return;
      if (event.key === 'ArrowRight') show(current + 1, true);
      else if (event.key === 'ArrowLeft') show(current - 1, true);
      else return;
      event.preventDefault();
    });

    setOpening(opening);
    show(0, false);
  }
</script>

