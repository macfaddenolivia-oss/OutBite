    border-color: transparent;
    border-bottom: 0;
  }

  /* Tail: navy outline triangle with a peach triangle on top (covers the border). */
  .callout::before {
    top: calc(100% + 3px);
    margin-left: -12px;
    border-width: 13px 12px 0;
    border-top-color: #17306a;
  }

  .callout::after {
    top: 100%;
    margin-left: -9px;
    border-width: 12px 9px 0;
    border-top-color: var(--color-callout-bg);
  }

  /* Targets (drawings are 480×360 units, positions in story/layout.ts): Ana's head
     x=110 (23%), the landed mosquito x=182 (38%), the step 4 mosquito x=332 (69%;
     tail near the callout's right end), the neighbor in step 5 x=110 (23%). */
  .callout--ana {
    left: calc(23% - var(--tail-x));
  }

  /* Step 1: the real photo (AedesPhoto.astro) under the drawing, pulled up into the
     empty sky below the names (LABELS_BOTTOM in story/layout.ts: 298.5 of the drawing's
     360 units; 1 unit = 100cqw / 480) so step 1 stays within the shared frame. Centered,
     with the caption beside the photo. */
  .meet-photo {
    position: relative; /* above the drawing's sky */
    z-index: 1;
    display: flex;
    justify-content: center;
    margin-top: calc(12px - (360 - 298.5) * 100cqw / 480);
    padding: 0 var(--space-3) var(--space-3);
  }

  /* Phones (callout hidden, its words are in the text): step 1's drawing starts 80 units
     lower, trimming the empty sky above the wings (top of the raised wing: about 107 of
     360 units), so the photo row costs the shared frame less height. */
  @media (max-width: 30rem) {
    .art--meet :global(.story-art) {
      margin-top: calc(-80 * 100cqw / 480);
    }
  }

  /* Side by side, the panel's own 20px bottom padding is below it. The drawing is a
     little narrower here (476px, others 540px), so the drawing and the 96px photo row
     together stay within 405px, the height of the other steps' drawings, and step 1 is
     no taller than they are. */
  @media (min-width: 56rem) {
    .meet-photo {
      padding-bottom: 0;
    }

    .art--meet {
      max-width: 476px;
    }
  }

  /* Step 1: the callout over the Aedes mosquito (x = 130 of 480 units, 27.1%), 16px
     above its raised wing (about 114 of 360 units). */
  .callout--aedes {
    left: calc(27.1% - var(--tail-x));
    top: calc(114 * 100cqw / 480 - 16px);
    translate: 0 -100%;
    max-width: min(60%, 18rem);
  }

  /* Step 2: on the left above Ana, clear of the mosquito's whole flight from the
     bucket. The tail (35% of the picture's width in from the box's left edge, at 3%)
     points at where the mosquito lands (x = 38%). */
  .callout--mosquito {
    --tail-x: 33cqw; /* the smaller mosquito lands at x = 172.8 (36%) */
    left: 3%;
    max-width: min(80%, 27rem); /* Spanish fits in two lines, clear of the landing mosquito */
  }

  /* Step 4: points down at the mosquito biting the neighbor, above everyone's heads. */
  .callout--next {
    --tail-x: calc(100% - 40px);
    /* Tail at the mosquito (x = 324.8, 67.7%); 7px: the tail is measured inside the
       3px border. The box sits 16px above the tallest figure (the heads' tops, 153 of
       360 units; 1 unit = 100cqw / 480). */
    right: calc(32.3% - 47px);
    top: calc(153 * 100cqw / 480 - 16px);
    translate: 0 -100%;
  }

  /* Step 6: points down at the mosquito perched on the bucket's right rim (centre
     x ≈ 324 of 480 units, 67.4%; same tail geometry as step 5), 16px above the
     mosquito's raised wing (about 88 of 360 units). */
  .callout--more {
    --tail-x: calc(100% - 40px);
    right: calc(32.6% - 47px);
    top: calc(88 * 100cqw / 480 - 16px);
    translate: 0 -100%;
  }

  /* Stacked (under 56rem) the picture panel starts right at the drawing's top, so a
     callout taller than the sky above the mosquito (more lines at larger text or on
     narrow screens) was cut off by the panel's edge. Here the callout sits in its own
     row: the row is as tall as that sky or the callout, whichever is taller, and the
     drawing is pulled up under it by the sky's height. The callout's bottom stays 16px
     above the raised wing, with at least 8px above it, and the drawing only moves down
     when the callout needs the room (nothing changes when it fits). */
  @media (max-width: 55.99rem) {
    .art--more {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .art--more::before {
      content: '';
      grid-area: 1 / 1;
      height: calc(88 * 100cqw / 480 - 16px);
    }

    .art--more .callout--more {
      position: relative;
      grid-area: 1 / 1;
      align-self: end;
      justify-self: end;
      top: auto;
      right: auto;
      margin-top: var(--space-2); /* at least 8px below the panel's edge */
      margin-inline-end: calc(32.6% - 47px);
      translate: none;
    }

    .art--more > :global(svg) {
      grid-row: 2;
      margin-top: calc(-1 * (88 * 100cqw / 480 - 16px));
    }

  }

  /* Longest text (Spanish step 7); there is open sky to its right, above the calendar,
     so it may be wider. */
  .callout--neighbor {
    left: calc(23% - var(--tail-x));
    max-width: min(70%, 24rem);
  }

  /* Short pop-in about 0.4s after the scene shows (never with reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scene.is-active .callout {
      animation: callout-pop 0.32s cubic-bezier(0.2, 0.9, 0.3, 1.3) 0.4s both;
    }

    /* Step 2: the callout pops in near the end of the flight, so it never covers
       the mosquito while visible. */
    :global(.js) .scene.is-active .callout--mosquito {
      animation-delay: 1s;
    }
  }

  @keyframes callout-pop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.85);
    }
  }

  /* The callout is also real text in the caption for screen readers; on phones (under
     40rem) the picture is small, so show it there instead of over the picture. */
  .scene__callout-text {
    display: none;
  }

  @media (max-width: 39.99rem) {
    .callout {
      display: none;
    }
    .scene__callout-text {
      display: block;
      font-weight: var(--weight-heading);
    }
  }

  /* "Step N of 8" sits above the progress dashes, 8px above them. */
  .scene__step {
    margin-bottom: 4px;
    font-size: var(--text-sm);
    font-weight: var(--weight-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .scene__heading {
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
  }

  /* Focus always moves to the heading (for screen readers); the outline shows only
     after keyboard navigation (the script sets data-focus-ring). */
  .scene__heading:focus {
    outline: none;
  }

  .scene__heading[data-focus-ring]:focus {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .scene__text p {
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .scene__text :global(.source-line) {
    font-size: var(--text-sm);
  }

  /* Step 1: the light-blue note box ("You don't have to travel to get sick…"). */
  /* Step 1: the sources line and the FAQ link share one row when they fit. */
  .scene__meet-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-4);
  }

  .scene__faq {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  .scene__text .scene__meet-caption {
    margin-bottom: var(--space-2);
  }

  .scene__text .scene__notebox {
    margin-bottom: 0;
    padding: 4px var(--pad-box);
    border-inline-start: 4px solid var(--color-rule);
    background: var(--color-surface-tint);
  }

  /* Note box text at 15px (the source-line size) so step 1 fits the same frame as
     the other steps. */
  .scene__text .scene__notebox p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .scene__text .scene__notebox .scene__states {
    margin-top: 2px;
    font-size: 0.875rem;
  }

  /* "Show where": the list of states, closed by default (like the sources toggle). */
  .scene__where summary {
    min-height: 24px;
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  .scene__note {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-strong);
  }

  /* ---- Shared nav bar along the bottom of the frame ---- */
  :global(.js) .story .story-nav {
    display: grid !important;
    /* Fixed side columns so the buttons never shift when the middle label changes. */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'back middle forward';
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) 20px; /* 44px buttons + 2×4px + 3px border = 55px */
    border-top: 3px solid var(--color-rule);
    background: var(--color-surface);
    /* Pinned to the bottom of the window whenever the frame's bottom is off-screen. */
    position: sticky;
    bottom: 0;
    z-index: 4;
  }

  .story-nav__back {
    grid-area: back;
    justify-self: start;
  }

  .story-nav__restart {
    grid-area: middle;
  }

  .story-nav__next,
  .story-nav__protect {
    grid-area: forward;
    justify-self: end;
  }

  .story-nav [hidden] {
    display: none;
  }

  /* Last step on tablets and phones: the three buttons don't fit in one row, so stack
     them, full width (Protect link first, then restart, then Back). */
  @media (max-width: 63.99rem) {
    /* Not pinned on this step: three stacked buttons would cover too much of it. */
    :global(.js) .story .story-nav.is-last {
      position: static;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'forward' 'middle' 'back';
      gap: var(--space-2);
    }

    .story-nav.is-last .btn {
      justify-self: stretch;
      justify-content: center;
    }
  }

  .story-nav button[disabled] {
    opacity: 0.45;
    cursor: default;
  }

  @media (max-width: 30rem) {
    :global(.js) .story .story-nav {
      padding-inline: var(--space-3);
      gap: var(--space-2);
    }
    .story-nav .btn {
      padding-inline: var(--space-3);
      font-size: 1rem;
    }
  }

  /* ---- Scene 9 ----
     Spacing: heading → closing line 4px, closing line → buttons 8px, buttons →
     explanation 6px. The instruction ("↑ Tap a layer…") sits in the explanation box's
     cell, under the buttons, until a layer is chosen. */
  .tap-callout {
    grid-area: 1 / 1;
    align-self: start;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 4px var(--space-3);
    color: var(--color-heading);
    font-size: 1.25rem;
    font-weight: var(--weight-heading);
    line-height: 1.25;
  }

  .tap-callout__arrow {
    flex: none;
    color: var(--color-rule);
  }

  /* Hidden (not removed) once a layer is chosen; it comes back if the layer is
     tapped again to clear it. */
  .layer-explain[data-layer]:not([data-layer='']) .tap-callout {
    visibility: hidden;
  }

  /* Even 2×2 grid; every button keeps the same size in every state. */
  :global(.js) .story .layer-buttons {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--space-2);
    margin: 0 0 6px;
  }

  .layer-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    min-height: var(--tap-target);
    padding: 2px var(--space-3) 2px var(--space-4);
    border: 3px solid var(--color-layers-border);
    border-radius: var(--radius-sm);
    color: var(--color-layer-text);
    font: inherit;
    font-size: var(--text-base);
    font-weight: var(--weight-heading);
    line-height: 1.2;
    text-align: start;
    cursor: pointer;
  }

  /* Fixed-width spot on the right: → normally, ✓ when selected. */
  .layer-btn__icon {
    flex: none;
    width: 1.4em;
    font-size: 1.25em;
    text-align: center;
  }

  .layer-btn__check,
  .layer-btn[aria-pressed='true'] .layer-btn__arrow {
    display: none;
  }

  .layer-btn[aria-pressed='true'] .layer-btn__check {
    display: inline;
  }

  .layer-btn--body {
    background: var(--color-layer-body-bg);
  }
  .layer-btn--home {
    background: var(--color-layer-home-bg);
  }
  .layer-btn--yard {
    background: var(--color-layer-yard-bg);
  }
  .layer-btn--community {
    background: var(--color-layer-community-bg);
  }

  /* Selected: navy fill, white text (no extra ring; same size). */
  .layer-btn[aria-pressed='true'] {
    background: var(--color-layer-pressed-bg);
    color: var(--color-layer-pressed-text);
  }

  .layer-btn:focus {
    outline: none;
  }

  .layer-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* Phones: tighter buttons so the longest name (Spanish "Comunidad") fits beside its icon. */
  @media (max-width: 30rem) {
    .scene__text {
      padding: var(--pad-box);
    }

    :global(.js) .story .layer-buttons {
      gap: var(--space-2);
    }

    .layer-btn {
      gap: var(--space-1);
      padding-inline: var(--space-3) var(--space-1);
      font-size: 1.0625rem;
    }

    /* Larger text size: one button per row, so each name fits beside its arrow. */
    :global(html[data-text-size]) .story .layer-buttons {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Very small phones (320px). */
  @media (max-width: 22rem) {
    .scene__text {
      padding: var(--space-3);
    }

    :global(.js) .story .layer-buttons {
      gap: 6px;
    }

    .layer-btn {
      padding-inline: var(--space-2) 2px;
      font-size: 0.9375rem;
      letter-spacing: -0.01em;
    }
  }

  /* Until the first tap, the buttons pulse gently (a fading ring, no size change;
     never with reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .layer-buttons.is-pulsing .layer-btn {
      animation: layer-pulse 1.8s ease-in-out infinite;
    }
    .layer-buttons.is-pulsing .layer-btn:nth-child(2) {
      animation-delay: 0.15s;
    }
    .layer-buttons.is-pulsing .layer-btn:nth-child(3) {
      animation-delay: 0.3s;
    }
    .layer-buttons.is-pulsing .layer-btn:nth-child(4) {
      animation-delay: 0.45s;
    }
  }

  @keyframes layer-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(23 48 106 / 0.45);
    }
    60% {
      box-shadow: 0 0 0 7px rgb(23 48 106 / 0);
    }
  }

  /* Explanation box: all versions stacked in one cell, only the chosen one visible,
     so its height never changes. Tinted to match the chosen layer. */
  /* Last visible line of step 9 (everything after it is for screen readers or no
     JavaScript): no margin under it, so the step stays one screen tall at 1313×900. */
  :global(.js) .story .layer-explain {
    display: grid !important;
    margin: 0;
    border-inline-start: 5px solid transparent;
    color: var(--color-layer-text);
  }

  .layer-explain[data-layer]:not([data-layer='']) {
    border-inline-start-color: #17306a;
  }

  .layer-explain__item {
    grid-area: 1 / 1;
    padding: 4px var(--space-3);
    visibility: hidden;
  }

  /* Only inside the active step: visibility: visible would otherwise override the
     hidden (inactive) step and show through on other steps. */
  .scene.is-active .layer-explain__item.is-shown {
    visibility: visible;
  }

  .scene__text .layer-explain__item p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .layer-explain__item :global(.source-line) {
    margin-top: 2px;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .layer-explain__item :global(.source-line) {
    color: var(--color-layer-text);
  }

  .layer-explain__item :global(.source-line a) {
    color: var(--color-layer-text);
  }

  .layer-explain[data-layer='body'] {
    background: var(--color-layer-body-bg);
  }
  .layer-explain[data-layer='home'] {
    background: var(--color-layer-home-bg);
  }
  .layer-explain[data-layer='yard'] {
    background: var(--color-layer-yard-bg);
  }
  .layer-explain[data-layer='community'] {
    background: var(--color-layer-community-bg);
  }

  /* Under the heading, in regular step-text style; 8px before the buttons. */
  .scene__text .scene__closing {
    margin: 0 0 var(--space-2);
  }

  .layers-static {
    padding-inline-start: 1.2em;
  }

  /* ---- Phones (under 40rem), with JavaScript: the whole box with Back/Next fits on the
     screen under the sticky header (about 375×670 visible on an iPhone).
     - Every step has the same height: a 150px picture panel and a text area of one fixed
       height (as tall as the screen allows, at most 390px) that scrolls inside the box
       when a step's text is longer, with "Scroll for more ↓" at its bottom while there is
       more below.
     - Each drawing is cropped to the band its content uses and scaled to fit the panel
       (--band-top and --band-h, in the drawing's 480×360 units): the same band for every
       drawing on the ground, so the ground and the people don't move between steps. Step
       9's diagram keeps its full width (its labels would be too small at 150px): its
       panel is taller and its text area shorter by the same amount.
     - Step 1's photo and step 7's "Where mosquitoes lay eggs" strip sit in the text
       (.phone-only; the copies in the picture panel are .not-phone).
     - Back/Next is not pinned to the screen here (the box fits), so nothing ever sits
       behind it; on the last step it stays one row (Back, as an arrow, and the Protect
       link), with "Start from the beginning" at the end of step 9's text. ---- */
  .phone-only,
  .scroll-hint {
    display: none;
  }

  @media (max-width: 39.99rem) {
    :global(.js) .story .not-phone {
      display: none;
    }

    :global(.js) .story .phone-only {
      display: block;
    }

    :global(.js) .story-frame {
      container-type: inline-size;
      --fig-h: 150px;
      --hint-h: 1.75rem;
      /* 3px frame border above and below, 3px under the picture, 16px to spare */
      --text-h: clamp(160px, calc(100vh - var(--header-height) - var(--fig-h) - var(--tap-target) - 11px - 25px), 390px);
      --text-h: clamp(160px, calc(100svh - var(--header-height) - var(--fig-h) - var(--tap-target) - 11px - 25px), 390px);
    }

    :global(.js) .story .scene__figure {
      height: calc(var(--fig-h) + 3px);
      align-content: center;
      align-items: center;
    }

    :global(.js) .story .scene__text {
      height: calc(var(--text-h) - var(--hint-h));
      padding: var(--space-3) var(--space-3) var(--space-1);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    /* The step dashes keep their 44px tap areas, which reach 12px under the heading's top
       edge (the dash is at the top of the area). */
    :global(.js) .story .scene__text :global(.progress) {
      margin-bottom: -12px;
    }

    :global(.js) .story .art {
      --band-top: 76;
      --band-h: 242;
      width: min(100%, var(--fig-h) * 480 / var(--band-h));
      max-width: none;
      min-height: 0; /* exactly the band: the rest of the drawing reaches past it */
      aspect-ratio: 480 / var(--band-h);
    }

    :global(.js) .story .art > :global(svg.story-art) {
      max-height: none;
      margin-top: calc(var(--band-top) / -480 * 100%);
    }

    :global(.js) .story .art--meet {
      --band-top: 100;
      --band-h: 218;
    }

    :global(.js) .story .art--inside {
      --band-top: 112;
      --band-h: 216;
    }

    /* Step 7: no callout row above the drawing (the callout is in the text). */
    :global(.js) .story .art--more {
      display: block;
    }

    :global(.js) .story .art--more::before {
      content: none;
    }

    /* Step 9: the diagram at the panel's full width (600×390 units). */
    :global(.js) .story .scene[data-scene='8'] .scene__figure {
      height: calc(100cqw * 390 / 600 + 3px);
    }

    :global(.js) .story .scene[data-scene='8'] .scene__text {
      height: calc(var(--text-h) - var(--hint-h) - 100cqw * 390 / 600 + var(--fig-h));
    }

    :global(.js) .story .art--cycle {
      width: 100%;
      aspect-ratio: auto;
    }

    :global(.js) .story .art--cycle > :global(svg.story-art) {
      margin-top: 0;
      aspect-ratio: 600 / 390;
    }

    :global(.js) .story .meet-photo--text {
      margin: 0 0 var(--space-3);
      padding: 0;
      justify-content: flex-start;
    }

    :global(.js) .story .egg-spots--text {
      max-width: none;
      margin: 0 0 var(--space-3);
      padding: var(--space-2) var(--space-2) var(--space-3);
      background: var(--color-ground-bg);
    }

    :global(.js) .story .scene__restart {
      margin: var(--space-3) 0 0;
    }

    /* A strip of its own under the text area (so it never covers the text or a focused
       link), shown while there is more below (the script sets data-more). */
    :global(.js) .story .scroll-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.3em;
      height: var(--hint-h);
      margin: 0;
      border-top: 1px solid var(--color-border);
      color: var(--color-link);
      font-size: var(--text-sm);
      font-weight: var(--weight-strong);
      line-height: 1;
    }

    :global(.js) .story .scene__text:not([data-more]) + .scroll-hint {
      visibility: hidden;
    }

    :global(.js) .story .story-nav {
      position: static;
    }

    :global(.js) .story .story-nav.is-last {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'back forward';
    }

    :global(.js) .story .story-nav .story-nav__restart {
      display: none;
    }

    /* Two lines at most, at every text size (at most 15px here), so the bar keeps its
       height on the last step. */
    :global(.js) .story .story-nav.is-last {
      padding-inline: var(--space-2);
    }

    :global(.js) .story .story-nav .story-nav__protect {
      padding: 0 var(--space-2);
      font-size: min(0.9375rem, 15px);
      line-height: 1.1;
      text-wrap: balance;
    }

    /* Last step: Back shows its arrow only (the word stays for screen readers), so the
       Protect link has room for its two lines. */
    :global(.js) .story .story-nav.is-last .story-nav__back {
