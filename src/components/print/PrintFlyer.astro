---
// Printable 2: two half-page neighbor flyers on one sheet,
// with a dashed "✂ cut here · corta aquí" line between them. `langs` picks the two
// halves: English + English, Spanish + Spanish, or English top and Spanish bottom.
// `variant="cleanup"`: the clean-up day flyer for schools and groups, same design and
// the same three steps, with blank lines for date, time, place and "Organized by" in
// place of the picture (and no "From your neighbor" line).
import PrintSheet from './PrintSheet.astro';
import PrintLogo from './PrintLogo.astro';
import PrintQr from './PrintQr.astro';
import PrintSources from './PrintSources.astro';
import Genus from '../Genus.astro';
import Bucket from '../story/Bucket.astro';
import Mosquito from '../story/Mosquito.astro';
import content from '../../content/printables.json';
import { assetPath, localizePath } from '../../i18n';

interface Props {
  langs: ['en' | 'es', 'en' | 'es'];
  id: string;
  variant?: 'neighbor' | 'cleanup';
}
const { langs, id, variant = 'neighbor' } = Astro.props;
const cleanup = variant === 'cleanup';
---

<PrintSheet id={id} lang={langs[0]} label={cleanup ? content.text[langs[0]].cleanup.title : content.text[langs[0]].flyer.title}>
  {
    langs.map((lang, half) => {
      const text = content.text[lang];
      const f = text.flyer;
      const c = text.cleanup;
      return (
        <>
          {half === 1 && (
            <p class="pf__cut" aria-hidden="true">
              <span>{f.cut}</span>
            </p>
          )}
          <article class="pf" lang={lang}>
            <h2 class="pf__title">{cleanup ? c.title : f.title}</h2>
            <p class="pf__body">
              <Genus text={cleanup ? c.body : f.body} />
            </p>
            <div class="pf__main">
              <ol class="pf__steps">
                {f.steps.map((step, i) => (
                  <li>
                    <span class="pf__num">{i + 1}</span>
                    <span class="pf__icon" aria-hidden="true">
                      {i === 0 && <img src={assetPath('story/water/plant-saucer.svg')} alt="" width="40" height="40" />}
                      {i === 1 && (
                        <svg viewBox="0 0 40 40">
                          <rect x="3" y="3" width="34" height="34" fill="#FFFFFF" stroke="#17306A" stroke-width="3" />
                          <path
                            d="M9 4V36M15 4V36M21 4V36M27 4V36M33 4V36M4 9H36M4 15H36M4 21H36M4 27H36M4 33H36"
                            stroke="#A9C8E0"
                            stroke-width="1.4"
                          />
                        </svg>
                      )}
                      {i === 2 && (
                        <svg viewBox="0 0 40 40">
                          <rect x="16" y="3" width="8" height="6" fill="#17306A" />
                          <rect x="12" y="9" width="16" height="28" rx="3" fill="#F4D1A8" stroke="#17306A" stroke-width="3" />
                          <path d="M28 6 l6 -3 M29 9 h7 M28 12 l6 3" stroke="#E07034" stroke-width="2.4" stroke-linecap="round" />
                        </svg>
                      )}
                    </span>
                    <span class="pf__step">{step}</span>
                  </li>
                ))}
              </ol>
              {cleanup ? (
                <dl class="pf__fields">
                  {c.fields.map((label) => (
                    <div>
                      <dt>{label}:</dt>
                      <dd />
                    </div>
                  ))}
                </dl>
              ) : (
                <svg class="pf__art" viewBox="0 0 160 140" aria-hidden="true">
                  <rect width="160" height="140" fill="#CBDCEC" />
                  <rect y="128" width="160" height="12" fill="#A9C8E0" />
                  <Bucket x={104} y={128} scale={0.62} />
                  <Mosquito x={56} y={46} scale={1.25} />
                </svg>
              )}
            </div>
            <div class="pf__foot">
              <PrintLogo size={21} />
              <p class="pf__from">{cleanup ? '' : f.from}</p>
              <PrintQr path={localizePath(lang)} text={cleanup ? c.scan : f.scan} placeholder={text.common.siteAddress} size={58} />
            </div>
            <div class="pf__fine">
              <PrintSources ids={cleanup ? content.cite.cleanup : content.cite.flyer} label={text.common.sources} lang={lang} />
              <p>{text.common.disclaimer}</p>
            </div>
          </article>
        </>
      );
    })
  }
</PrintSheet>

<style>
  .pf {
    display: flex;
    flex-direction: column;
    height: 468px;
  }

  .pf__title {
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .pf__body {
    margin-top: 6px !important;
    font-size: 13.5px;
    line-height: 1.45;
  }

  .pf__main {
    display: grid;
    grid-template-columns: 1fr 216px;
    gap: 24px;
    margin-top: 12px;
  }

  .pf__steps {
    padding: 0;
    list-style: none;
    border-top: 4px solid #17306a;
  }

  .pf__steps li {
    display: grid;
    grid-template-columns: 26px 48px 1fr;
    align-items: center;
    gap: 10px;
    min-height: 68px;
    border-bottom: 1px solid #cbdcec;
  }

  .pf__num {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 900;
  }

  .pf__icon img,
  .pf__icon svg {
    display: block;
    width: 44px;
    height: 44px;
  }

  .pf__step {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.3;
  }

  .pf__art {
    width: 216px;
    height: auto;
    align-self: start;
    margin-top: 8px;
  }

  .pf__fields {
    display: grid;
    align-content: start;
    gap: 14px;
    margin: 6px 0 0;
    padding: 10px 12px 14px;
    border: 2px solid #17306a;
  }

  .pf__fields div {
    display: grid;
    gap: 2px;
  }

  .pf__fields dt {
    font-size: 13px;
    font-weight: 800;
  }

  .pf__fields dd {
    height: 22px;
    margin: 0;
    border-bottom: 1.5px solid #17306a;
  }

  .pf__foot {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    margin-top: auto;
  }

  .pf__from {
    font-size: 12.5px;
    text-align: center;
  }

  .pf__fine {
    margin-top: 6px;
    font-size: 9.5px;
    line-height: 1.35;
  }

  .pf__fine :global(.print-sources) {
    font-size: 9.5px;
  }

  .pf__cut {
    position: relative;
    height: 24px;
    margin: 0 -48px !important;
    border-top: 1.5px dashed #6b7488;
    transform: translateY(12px);
    font-size: 10.5px;
  }

  .pf__cut span {
    position: absolute;
    top: -9px;
    left: 64px;
    padding: 0 6px;
    background: #ffffff;
    line-height: 1.4;
  }
</style>
