---
// Printable 3: "Spot the Aedes mosquito" poster. `mode`:
// 'en' or 'es' (one language), or 'both' (English, with the Spanish in italics under
// each line). Aedes (story/Mosquito.astro) beside Culex (story/Mosquito.astro, kind="culex"), three
// facts, where it lays eggs (the story's water icons and the bucket), the navy
// "Empty standing water once a week." bar, sources, disclaimer and QR.
import PrintSheet from './PrintSheet.astro';
import PrintLogo from './PrintLogo.astro';
import PrintQr from './PrintQr.astro';
import PrintSources from './PrintSources.astro';
import Genus from '../Genus.astro';
import Bucket from '../story/Bucket.astro';
import Mosquito from '../story/Mosquito.astro';
import content from '../../content/printables.json';
import { assetPath, localizePath } from '../../i18n';
import { getPage } from '../../config/pages';

interface Props {
  mode: 'en' | 'es' | 'both';
  id: string;
}
const { mode, id } = Astro.props;
const main = mode === 'es' ? content.text.es : content.text.en;
const second = mode === 'both' ? content.text.es : null;
const p = main.poster;
const s = second?.poster;
const lang = mode === 'es' ? 'es' : 'en';
const icons = [
  ['tire', 'tire'],
  ['plantSaucer', 'plant-saucer'],
  ['petBowl', 'pet-bowl'],
  ['birdbath', 'birdbath'],
  ['bucket', ''],
] as const;
---

<PrintSheet id={id} lang={lang} label={p.title}>
  <div class="pp">
    <header class="pp__head">
      <PrintLogo size={24} />
      {mode === 'both' && <span class="pp__langs">{p.languages}</span>}
    </header>

    <h2 class="pp__title"><Genus text={p.title} /></h2>
    {s && <p class="pp__sub" lang="es"><Genus text={s.title} /></p>}

    <div class="pp__cards">
      <div class="pp__card pp__card--aedes">
        <svg viewBox="0 4 64 66" aria-hidden="true"><Mosquito x={31} y={37} /></svg>
        <p class="pp__name"><em>Aedes</em></p>
        <p class="pp__line">{p.aedesLook}</p>
        {s && <p class="pp__es" lang="es">{s.aedesLook}</p>}
        <p class="pp__line pp__line--strong">{p.aedesSpread}</p>
        {s && <p class="pp__es" lang="es">{s.aedesSpread}</p>}
      </div>
      <div class="pp__card pp__card--culex">
        <svg viewBox="0 4 64 66" aria-hidden="true"><Mosquito kind="culex" x={31} y={37} /></svg>
        <p class="pp__name"><em>Culex</em> <span class="pp__common">{p.culexCommon}{s && ` · ${s.culexCommon}`}</span></p>
      </div>
    </div>

    <ul class="pp__facts">
      {
        p.facts.map((fact, i) => (
          <li>
            <p class="pp__fact">{fact}</p>
            {s && <p class="pp__es" lang="es">{s.facts[i]}</p>}
          </li>
        ))
      }
    </ul>

    <p class="pp__where">{p.whereTitle}{s && <> · <em lang="es">{s.whereTitle}</em></>}</p>
    <ul class="pp__icons">
      {
        icons.map(([key, file]) => (
          <li>
            {file ? (
              <img src={assetPath(`story/water/${file}.svg`)} alt="" width="56" height="56" />
            ) : (
              <svg viewBox="0 0 100 110" aria-hidden="true">
                <Bucket x={50} y={106} scale={0.85} />
              </svg>
            )}
            <span class="pp__icon-label">{p.items[key]}</span>
            {s && <span class="pp__es" lang="es">{s.items[key]}</span>}
          </li>
        ))
      }
    </ul>

    <p class="pp__bar">
      <strong>{p.bar}</strong>
      {s && <em lang="es"> {s.bar}</em>}
    </p>

    <footer class="pp__foot">
      <div class="pp__fine">
        <PrintSources ids={content.cite.poster} label={main.common.sources} lang={lang} />
        <p>{main.common.disclaimer}</p>
        {s && <p lang="es">{s && content.text.es.common.disclaimer}</p>}
      </div>
      <PrintQr
        path={localizePath(lang, getPage('howItSpreads').path)}
        text={s ? `${p.learnMore} · ${s.learnMore}` : p.learnMore}
        placeholder={main.common.siteAddress}
      />
    </footer>
  </div>
</PrintSheet>

<style>
  .pp {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pp__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 3px solid #17306a;
  }

  .pp__langs {
    font-size: 12.5px;
    font-weight: 700;
  }

  .pp__title {
    margin-top: 18px !important;
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .pp__title :global(em) {
    font-weight: 900;
  }

  .pp__sub {
    font-size: 20px;
    font-style: italic;
  }

  .pp__sub :global(em) {
    font-style: normal;
  }

  .pp__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 16px;
  }

  .pp__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 14px 14px;
    text-align: center;
  }

  .pp__card--aedes {
    background: #cbdcec;
  }

  .pp__card--culex {
    background: #f4f4f4;
    border: 1px solid #d9d9d9;
  }

  .pp__card svg {
    width: 220px;
    height: auto;
  }

  .pp__name {
    font-size: 21px;
    font-weight: 700;
  }

  .pp__common {
    font-size: 14px;
    font-weight: 400;
  }

  .pp__line {
    font-size: 14px;
    line-height: 1.35;
  }

  .pp__line--strong {
    margin-top: 6px !important;
    font-weight: 700;
  }

  .pp__es {
    display: block;
    font-size: 12.5px;
    font-style: italic;
    line-height: 1.35;
  }

  .pp__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 16px !important;
    padding: 0;
    list-style: none;
  }

  .pp__facts li {
    padding-top: 8px;
    border-top: 3px solid #e07034;
  }

  .pp__fact {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.35;
  }

  .pp__where {
    margin-top: 16px !important;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pp__where em {
    letter-spacing: 0;
    text-transform: none;
    font-weight: 600;
  }

  .pp__icons {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-top: 8px !important;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .pp__icons li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pp__icons img,
  .pp__icons svg {
    width: 56px;
    height: 56px;
  }

  .pp__icon-label {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 700;
  }

  .pp__icons .pp__es {
    font-size: 11.5px;
  }

  .pp__bar {
    margin-top: 14px !important;
    padding: 10px 16px;
    background: #17306a;
    color: #ffffff !important;
    font-size: 16px;
  }

  .pp__bar * {
    color: #ffffff !important;
  }

  .pp__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: auto;
    padding-top: 10px;
  }

  .pp__fine {
    max-width: 420px;
    font-size: 10.5px;
    line-height: 1.4;
  }
</style>
