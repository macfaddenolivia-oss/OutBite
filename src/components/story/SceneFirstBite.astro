---
// Scene 1: how Ana got the virus. A mosquito carrying the virus (orange dots) bites
// Ana near the shoulder; then her own dots pop in one at a time (from 0.6s; the still
// picture shows them). Caught nearby: Ana in front of her house (same place as scene
// 2). After a trip: somewhere else, shown by a small airplane in the sky, no house.
import Airplane from './Airplane.astro';
import Backdrop from './Backdrop.astro';
import House from './House.astro';
import Mosquito from './Mosquito.astro';
import Person from './Person.astro';
import { GROUND, NEXT, PERSON_X, PROBOSCIS, VIEW_H, VIEW_W } from './layout';

interface Props {
  label: string;
  travel: boolean;
  names: { ana: string };
}
const { label, travel, names } = Astro.props;
// Same bite as scene 4: proboscis tip on the right shoulder.
const shoulder = { x: PERSON_X + 25.4, y: GROUND - 58 };
const mosquito = { x: shoulder.x + PROBOSCIS * NEXT.mosquitoScale, y: shoulder.y };
---

<svg class="story-art story-art--ground" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role="img" aria-label={label}>
  <Backdrop names={[{ x: PERSON_X, text: names.ana }]} />
  {travel ? <Airplane x={330} y={GROUND - 198} /> : <House x={290} y={GROUND} />}
  <Person x={PERSON_X} y={GROUND} dots dotsClass="dots-appear dots-appear--after-bite" />
  <Mosquito x={mosquito.x} y={mosquito.y} scale={NEXT.mosquitoScale} dots class="fly fly--next" />
</svg>
