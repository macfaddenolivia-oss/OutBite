---
// The approved story mosquito (src/assets/source/mosquito.svg, updated Oct 16 2026; two wings
// since Oct 19 2026): two wings (the light-blue front wing and a paler back wing, as in
// the cycle diagram), clipped curved white body stripes, jointed legs with four evenly
// spaced white bands, plain navy thorax. The one-wing version is retired everywhere
// (the site's content checks keep it out).
// Drawn in its own 64-unit space and centered on (x, y), facing left.
// `kind="culex"`: the plain brown house mosquito, same pose
// and box but no stripes, no leg bands and no dots, in fixed browns. This is the only
// mosquito drawing on the site; the content checks keep it that way.
// `dots` = it carries the virus: four scattered orange dots (#E07034, thin white
// outline) on the dark parts of the body.
interface Props {
  x: number;
  y: number;
  scale?: number;
  dots?: boolean;
  class?: string;
  dotsClass?: string;
  /** Face right instead of left. */
  flip?: boolean;
  kind?: 'aedes' | 'culex';
}
const { x, y, scale = 1, dots = false, class: className = '', dotsClass = '', flip = false, kind = 'aedes' } = Astro.props;
const culex = kind === 'culex';

// Each copy needs its own clip-path id (several mosquitoes share a page).
const clipId = `mq-abd-${Math.random().toString(36).slice(2, 9)}`;

// White leg bands: [x, y, angle] for each of the three legs (four bands each).
const bands: [number, number, number][] = [
  [19.12, 45.52, 120.1], [16.7, 49.7, 120.1], [14.28, 53.88, 120.1], [11.86, 58.06, 120.1],
  [27.6, 47.68, 103.4], [26.5, 52.3, 103.4], [25.4, 56.92, 103.4], [24.3, 61.54, 103.4],
  [41.44, 42.88, 31.4], [45.4, 45.3, 31.4], [49.36, 47.72, 31.4], [53.32, 50.14, 31.4],
];
const band = 'M-0.75 -1.6 Q0.15 0 -0.75 1.6 L0.75 1.6 Q1.65 0 0.75 -1.6 Z';
const navy = '#17306A';
// Colors per kind: outline/legs, back wing, front wing, abdomen, thorax and head.
const c = culex
  ? { ink: '#5A4A3A', back: '#EFE8DF', front: '#E2D6C8', abdomen: '#8A6E52', body: '#6E5640', leg: 2.6, nose: 2.4, ry: 5.2 }
  : { ink: navy, back: '#DCE8F3', front: '#A9C8E0', abdomen: navy, body: navy, leg: 3.2, nose: 2.6, ry: 5.6 };
---

<g transform={`translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale}) translate(-31 -37)`}>
  <g class={className}>
    <defs>
      <clipPath id={clipId}>
        <ellipse cx="44" cy="33" rx="15" ry="5.6" transform="rotate(14 44 33)"></ellipse>
      </clipPath>
    </defs>
    <!-- legs (jointed), each with four white bands -->
    <path d="M24 34 L20 44 L9 63" fill="none" stroke={c.ink} stroke-width={c.leg} stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M27 35 L28 46 L23 67" fill="none" stroke={c.ink} stroke-width={c.leg} stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M30 34 L40 42 L58 53" fill="none" stroke={c.ink} stroke-width={c.leg} stroke-linecap="round" stroke-linejoin="round"></path>
    {!culex && bands.map(([bx, by, a]) => <path d={band} fill="#FFFFFF" transform={`translate(${bx} ${by}) rotate(${a})`} />)}
    <!-- wings: the back wing behind the front wing -->
    <ellipse cx="32" cy="17" rx="13" ry="4.2" transform="rotate(-50 32 17)" fill={c.back} stroke={c.ink} stroke-width="1.6"></ellipse>
    <ellipse cx="36" cy="18" rx="15" ry="5" transform="rotate(-28 36 18)" fill={c.front} stroke={c.ink} stroke-width="1.6"></ellipse>
    <!-- abdomen with clipped white stripes -->
    <ellipse cx="44" cy="33" rx="15" ry={c.ry} transform="rotate(14 44 33)" fill={c.abdomen}></ellipse>
    {
      !culex && (
        <g clip-path={`url(#${clipId})`} fill="#FFFFFF">
          <path d="M38 22 Q42.4 33 38 44 L40.4 44 Q44.8 33 40.4 22 Z" transform="rotate(14 44 33)" />
          <path d="M44 22 Q48.4 33 44 44 L46.4 44 Q50.8 33 46.4 22 Z" transform="rotate(14 44 33)" />
          <path d="M50 22 Q54.4 33 50 44 L52.4 44 Q56.8 33 52.4 22 Z" transform="rotate(14 44 33)" />
        </g>
      )
    }
    <!-- thorax (plain navy, no white mark), head, proboscis -->
    <ellipse cx="27" cy="29" rx="7" ry="6" fill={c.body}></ellipse>
    <circle cx="18" cy="30" r="4.6" fill={c.body}></circle>
    <path d="M15 31 L4 37" stroke={c.ink} stroke-width={c.nose} stroke-linecap="round"></path>
    {
      dots && !culex && (
        <g fill="#E07034" stroke="#FFFFFF" stroke-width="0.7" class={dotsClass}>
          {/* four scattered dots (mosquito.svg coordinates): thorax, abdomen front band,
              between stripes 2 and 3, and the abdomen tip */}
          <circle class="dot dot--1" cx="28.8" cy="26.4" r="1.6" />
          <circle class="dot dot--2" cx="35.4" cy="33.8" r="1.6" />
          <circle class="dot dot--3" cx="49" cy="32.4" r="1.6" />
          <circle class="dot dot--4" cx="55" cy="34.4" r="1.6" />
        </g>
      )
    }
  </g>
</g>
