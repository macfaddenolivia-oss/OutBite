---
// "How does Ana's story start?" choice band above the story frame: two large,
// equal-size buttons (house = Caught nearby, suitcase = After a trip). The page
// script sets aria-pressed; the selected one is navy with white text (no ✓: the fill and
// aria-pressed show it).
// Colors are fixed (peach band, navy and white buttons). Shown only with JavaScript; without it, both openings are shown.
interface Props {
  heading: string;
  local: string;
  travel: string;
}
const { heading, local, travel } = Astro.props;
---

<section class="choice" aria-labelledby="choice-heading">
  <h2 id="choice-heading" class="choice__heading">{heading}</h2>
  <div class="choice__buttons">
    <button type="button" class="choice__btn" data-opening-choice="local" aria-pressed="false">
      <svg class="choice__icon" viewBox="0 0 48 48" width="32" height="32" aria-hidden="true">
        <polygon points="4,22 24,6 44,22" fill="#E07034" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></polygon>
        <rect x="9" y="21" width="30" height="22" fill="#FFFFFF" stroke="currentColor" stroke-width="3"></rect>
        <rect x="27" y="29" width="7" height="14" fill="#F0AF74" stroke="currentColor" stroke-width="2.5"></rect>
        <rect x="14" y="26" width="8" height="8" fill="#CBDCEC" stroke="currentColor" stroke-width="2.5"></rect>
      </svg>
      <span class="choice__label">{local}</span>
    </button>
    <button type="button" class="choice__btn" data-opening-choice="travel" aria-pressed="true">
      <svg class="choice__icon" viewBox="0 0 48 48" width="32" height="32" aria-hidden="true">
        <path d="M18 14 V8 H30 V14" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"></path>
        <rect x="8" y="14" width="32" height="28" rx="2" fill="#F0AF74" stroke="currentColor" stroke-width="3"></rect>
        <path d="M18 14 V42 M30 14 V42" stroke="currentColor" stroke-width="2.5"></path>
      </svg>
      <span class="choice__label">{travel}</span>
    </button>
  </div>
</section>

<style>
  /* Slim band: question and both buttons on one row on desktop; on phones the question
     on top and the two buttons side by side under it. */
  .choice {
    display: none;
    --color-focus: #17306a;
    margin-bottom: var(--space-2);
    padding: 10px var(--space-4);
    background: #f4d1a8;
    border: 3px solid #17306a;
    color: #17306a;
  }

  :global(.js) .choice {
    display: grid;
    gap: var(--space-2) var(--space-5);
    align-items: center;
  }

  /* One row: the question, then the two buttons sized to their text (equal widths, at
     least 11rem each), not stretched across the band; 10px of orange above and below them
     (more than the 8px between them). */
  @media (min-width: 56rem) {
    :global(.js) .choice {
      grid-template-columns: auto minmax(0, 1fr);
      padding-block: 10px;
    }

    .choice__buttons {
      grid-template-columns: repeat(2, minmax(11rem, 1fr));
      justify-self: start;
      width: max-content;
      max-width: 100%;
    }
  }

  .choice__heading {
    margin: 0;
    color: #17306a;
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
  }

  /* Two equal columns, on phones too; both buttons grow together if a label wraps. */
  .choice__buttons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--space-2);
  }

  .choice__icon {
    line-height: 1;
  }

  .choice__btn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    /* 44px (at every text size: slim, never under the tap size); grows only if the text
       wraps. */
    min-height: 44px;
    padding: 0 var(--space-4);
    line-height: 1.2;
    background: #ffffff;
    color: #17306a;
    border: 3px solid #17306a;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    text-align: start;
    cursor: pointer;
  }

  /* Phones: side by side (design/phone-layout-mockup.png), the icon left of the label. A
     label wraps to a second line where it needs to (both buttons grow together); its text
     is at most 16px, so the longest word ("Contagio", "Después") still fits beside the
     icon at 320px and the largest text size. */
  @media (max-width: 35.99rem) {
    :global(.js) .choice {
      padding: 10px;
    }

    .choice__btn {
      gap: 4px;
      padding: 2px 4px;
      font-size: min(1rem, 16px);
      line-height: 1.15;
    }

    .choice__icon {
      width: 20px;
      height: 20px;
    }

    .choice__label {
      min-width: 0;
    }
  }

  /* Only where the device can really hover: on touch screens a tapped button would keep
     the underline (the hover state sticks on iPhone). */
  @media (hover: hover) {
    .choice__btn:hover .choice__label {
      text-decoration: underline;
    }
  }

  .choice__btn[aria-pressed='true'] {
    background: #17306a;
    color: #ffffff;
  }

  .choice__btn:focus-visible {
    outline: 3px solid #17306a;
    outline-offset: 3px;
  }

  .choice__icon {
    flex: none;
  }

  /* On the navy (selected) button the icon outlines turn white too (currentColor). */
  .choice__label {
    flex: 1;
  }
</style>
