---
import { assetPath, getLocale, getTagline, locales, localizePath, siteName, switchLocalePath, useTranslations } from '../i18n';
import { diseaseKeys, getPage, mainNavKeys } from '../config/pages';

interface Props {
  lang: string;
  /** Language links go to each language's home page (the 404 page, which has no translation). */
  langLinksHome?: boolean;
}

const { lang, langLinksHome = false } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;

const navItems = mainNavKeys.map((key) => {
  const href = localizePath(lang, getPage(key).path);
  return {
    key,
    href,
    current: normalized === href ? 'page' : normalized.startsWith(href) ? 'true' : undefined,
  };
});
// "Diseases": a small dropdown (desktop) or a labeled group (phone menu) with the three
// disease pages; marked current on any disease page.
const diseaseItems = diseaseKeys.map((key) => {
  const href = localizePath(lang, getPage(key).path);
  return { key, href, current: normalized === href ? ('page' as const) : undefined };
});
const onDiseasePage = diseaseItems.some((d) => d.current);
// Main-menu label: a shorter one where a page has it (pages.<key>.menu, e.g. "Travel"),
// so the bar fits on one line; otherwise the page's usual label.
const menuLabel = (key: string) => (getLocale(lang).messages as Record<string, any>).pages?.[key]?.menu ?? t(`pages.${key}.nav`);
---

<header class="site-header">
  <div class="container header__grid">
    <div class="brand">
      <a class="brand__name" href={localizePath(lang)}>
        <span class="visually-hidden">{siteName}</span>
        {/* The current Outbite logo (v2, files in public/brand/): the mark is the "O"
            and the rest of the name follows as live text. */}
        <span class="brand__logo" aria-hidden="true">
          <picture>
            <source srcset={assetPath('brand/outbite-mark-dark.svg')} media="screen and (prefers-color-scheme: dark)" />
            <img class="brand__mark" src={assetPath('brand/outbite-mark.svg')} alt="" width="64" height="64" />
          </picture><span class="brand__word">{siteName.slice(1)}</span>
        </span>
      </a>
      <p class="brand__tagline">{getTagline(lang)}</p>
    </div>

    <nav class="lang-switcher" aria-label={t('a11y.languageNav')}>
      <ul>
        {
          locales.map((l) => (
            <li>
              <a
                href={langLinksHome ? localizePath(l.code) : switchLocalePath(pathname, l.code)}
                lang={l.meta.htmlLang}
                hreflang={l.meta.htmlLang}
                aria-current={l.code === lang ? 'true' : undefined}
              >
                {l.meta.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn-urgent sick-link" href={localizePath(lang, getPage('sick').path)}>
      {t('header.sick')}
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      {t('a11y.menu')}
    </button>
  </div>

  <nav id="site-nav" class="site-nav" aria-label={t('a11y.mainNav')}>
    <ul class="container">
      <!-- Diseases, phones: a label with the three pages under it (always shown). -->
      <li class="nav-dis-phone">
        <span class:list={['nav-dis-phone__label', { 'is-current': onDiseasePage }]}>{t('header.diseases')}</span>
        <ul>
          {
            diseaseItems.map((d) => (
              <li>
                <a href={d.href} aria-current={d.current}>
                  {t(`pages.${d.key}.nav`)}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      <!-- Diseases, tablet and up: a dropdown opened by click, tap, Enter or Space (a
           native <details>, so it also works without JavaScript; the script adds
           aria-expanded, Escape and closing on a click outside). Never on hover. -->
      <li class="nav-dis">
        <details class="nav-dis__details" data-nav-dis>
          <summary class:list={['nav-dis__btn', { 'is-current': onDiseasePage }]}>
            {t('header.diseases')}
            <svg class="nav-dis__caret" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2 4 L6 8 L10 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </summary>
          <ul class="nav-dis__menu">
            {
              diseaseItems.map((d) => (
                <li>
                  <a href={d.href} aria-current={d.current}>
                    {t(`pages.${d.key}.nav`)}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current}>
              {menuLabel(item.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const sickLink = document.querySelector<HTMLElement>('.sick-link');

  // Share the real header/bar sizes with CSS (used for scroll padding and the
  // space reserved under the phone bar). Sizes change with text zoom and language.
  if (header && sickLink) {
    const measure = () => {
      root.style.setProperty('--header-height', `${header.offsetHeight}px`);
      root.style.setProperty('--sick-bar-height', `${sickLink.offsetHeight}px`);
    };
    new ResizeObserver(measure).observe(header);
    new ResizeObserver(measure).observe(sickLink);
  }

  // Keep keyboard focus from landing under the sticky header (desktop) or the
  // bottom bar (phones). Backs up CSS scroll-padding for browsers that ignore it.
  document.addEventListener('focusin', (event) => {
    const el = event.target;
    if (!(el instanceof HTMLElement) || !header || !sickLink) return;
    if (header.contains(el)) return;
    // Keyboard focus only: a mouse click on page content can focus <main> (tabindex -1,
    // the skip link's target) and must not scroll the page.
    if (!el.matches(':focus-visible') || el.tagName === 'MAIN') return;
    // Pages that scroll focused content into place themselves (How it spreads story).
    if (el.closest('[data-scroll-managed]')) return;
    requestAnimationFrame(() => {
      const gap = 16;
      const top = getComputedStyle(header).position === 'sticky' ? header.getBoundingClientRect().bottom : 0;
      const bottom =
        getComputedStyle(sickLink).position === 'fixed' ? sickLink.getBoundingClientRect().top : window.innerHeight;
      const rect = el.getBoundingClientRect();
      if (rect.top < top + gap) window.scrollBy(0, rect.top - top - gap);
      else if (rect.bottom > bottom - gap) window.scrollBy(0, rect.bottom - bottom + gap);
    });
  });

  // "Diseases" dropdown: aria-expanded follows the open state; Escape or a click
  // outside closes it (Escape returns focus to "Diseases").
  const dis = document.querySelector<HTMLDetailsElement>('[data-nav-dis]');
  const disBtn = dis?.querySelector<HTMLElement>('summary');
  if (dis && disBtn) {
    const sync = () => disBtn.setAttribute('aria-expanded', String(dis.open));
    sync();
    dis.addEventListener('toggle', sync);
    document.addEventListener('click', (event) => {
      if (dis.open && !dis.contains(event.target as Node)) dis.open = false;
    });
    dis.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dis.open) {
        event.stopPropagation();
        dis.open = false;
        disBtn.focus();
      }
    });
    dis.addEventListener('focusout', (event) => {
      if (dis.open && !dis.contains(event.relatedTarget as Node | null) && event.relatedTarget) dis.open = false;
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--color-header-bg);
    color: var(--color-header-text);
    border-bottom: 4px solid var(--color-rule);
  }

  /* Phone layout:  name + tagline | language
                    name + tagline | menu
                    menu items (collapsible)
     The sick link becomes a bar fixed to the bottom of the screen. */
  .header__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'brand menu';
    align-items: center;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-2);
  }

  /* Logo sizes: under 600px about 1.3× the old size; 600–899px about 1.5×, tagline
     below in small text; 900px and up about 2× (wordmark ~40px), with the tagline
     beside it after a short navy divider. */
  .brand {
    grid-area: brand;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .brand__name {
    display: inline-block;
    white-space: nowrap; /* the mark and "utbite" never split */
    font-family: var(--font-heading);
    font-size: 1.9375rem;
    font-weight: var(--weight-heading);
    line-height: 1.15;
    color: var(--color-header-text);
    text-decoration: none;
  }

  /* Sized and nudged so the mark's ring sits on the text baseline like a
     letter "O" (proportions taken from public/brand/outbite-logo.svg). */
  .brand__mark {
    display: inline;
    width: 1.07em;
    height: 1.07em;
    vertical-align: -0.1em;
    margin-inline-end: -0.1em;
  }

  .brand__tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-header-link);
  }

  /* Under 600px: tagline hidden visually, still read by screen readers. */
  @media (max-width: 37.49rem) {
    .brand__tagline {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 37.5rem) {
    .brand__name {
      font-size: 2.0625rem;
    }
  }

  /* 992px and up (where the Menu button gives way to the menu bar): logo and tagline
     on one row. */
  @media (min-width: 62rem) {
    .brand {
      flex-direction: row;
      align-items: center;
    }

    .brand__name {
      font-size: 2.5rem;
    }

    .brand__tagline {
      display: flex;
      align-items: center;
      min-height: 32px;
      margin-inline-start: var(--space-4);
      padding-inline-start: var(--space-4);
      border-inline-start: 2px solid var(--color-rule);
      font-size: 1.0625rem;
      white-space: nowrap;
    }
  }

  /* 992–999px: a little tighter so the longer Spanish tagline and sick link fit on
     one row with the logo. */
  @media (min-width: 62rem) and (max-width: 62.49rem) {
    .brand__tagline {
      margin-inline-start: var(--space-3);
      padding-inline-start: var(--space-3);
      font-size: var(--text-sm);
    }
  }

  .lang-switcher {
    grid-area: lang;
    justify-self: end;
  }

  .lang-switcher ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-switcher a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-1);
    color: var(--color-header-link);
    font-size: var(--text-sm);
  }

  .lang-switcher a[aria-current] {
    color: var(--color-header-text);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .sick-link {
    grid-area: sick;
    justify-self: start;
  }

  /* Phones: slim bar along the bottom edge. The page reserves matching space
     (see global.css) so it never covers the footer or focused items. */
  @media (max-width: 47.99rem) {
    .sick-link {
      grid-area: auto;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 50;
      width: 100%;
      padding-block: var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
      border: 0;
      border-top: 2px solid var(--color-urgent-border);
      border-radius: 0;
      box-shadow: 0 -2px 10px rgb(0 0 0 / 0.2);
    }

    .sick-link:focus-visible {
      outline-color: var(--palette-white);
      outline-offset: -6px;
    }

    /* Hide the bar while typing so it can't sit on top of the on-screen keyboard. */
    :global(body:has(:is(input, textarea, select, [contenteditable='true']):focus)) .sick-link {
      display: none;
    }
  }

  .menu-toggle {
    grid-area: menu;
    justify-self: end;
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-3);
    border: 3px solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-header-text);
    font: inherit;
    font-weight: var(--weight-strong);
    cursor: pointer;
  }

  :global(.js) .menu-toggle {
    display: inline-flex;
  }

  /* Without JavaScript the menu is simply always open. */
  :global(.js) .site-nav:not([data-open]) {
    display: none;
  }

  .site-nav {
    border-top: 1px solid var(--color-border);
  }

  .site-nav ul {
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    padding-block: var(--space-2);
    list-style: none;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-2);
    color: var(--color-header-link);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .site-nav a:hover {
    text-decoration: underline;
  }

  .site-nav a[aria-current] {
    color: var(--color-header-text);
    text-decoration: underline;
    text-decoration-thickness: 0.16em;
  }

  /* "Diseases" on phones: a label with its three links indented under it. */
  .nav-dis {
    display: none;
  }

  .nav-dis-phone__label {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-2);
    color: var(--color-header-text);
    font-weight: var(--weight-display);
  }

  .nav-dis-phone ul {
    margin: 0;
    padding: 0 0 0 var(--space-4);
    list-style: none;
  }

  /* Tablet and up: compact sticky header. Name | language | sick link. Under 992px a
     "Menu" button opens the list (as on phones), so the menu text never shrinks. */
  @media (min-width: 48rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header__grid {
      grid-template-columns: 1fr auto auto auto;
      grid-template-areas: 'brand lang sick menu';
      gap: var(--space-3) var(--space-4);
    }
  }

  /* 992px and up: the menu as one line under the header, with "Diseases" as a
     dropdown. */
  @media (min-width: 62rem) {
    .header__grid {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'brand lang sick';
    }

    :global(.js) .menu-toggle {
      display: none;
    }

    :global(.js) .site-nav:not([data-open]) {
      display: block;
    }

    .site-nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      padding-block: 0;
    }

    .site-nav a {
      min-height: 2.5rem;
    }

    .nav-dis-phone {
      display: none;
    }

    .nav-dis {
      display: block;
      position: relative;
    }

    .nav-dis__btn {
      display: flex;
      align-items: center;
      gap: 0.3em;
      min-height: 2.5rem;
      padding-inline: var(--space-2);
      color: var(--color-header-link);
      font-weight: var(--weight-strong);
      list-style: none;
      cursor: pointer;
      user-select: none;
    }

    .nav-dis__btn::-webkit-details-marker {
      display: none;
    }

    .nav-dis__btn:hover {
      text-decoration: underline;
    }

    .nav-dis__btn:focus-visible {
      outline: 3px solid var(--color-focus);
      outline-offset: 2px;
    }

    /* On a disease page: underlined like the other current items. */
    .nav-dis__btn.is-current {
      color: var(--color-header-text);
      text-decoration: underline;
      text-decoration-thickness: 0.16em;
    }

    .nav-dis__caret {
      transition: transform 0.15s;
    }

    .nav-dis__details[open] .nav-dis__caret {
      transform: rotate(180deg);
    }

    .site-nav .nav-dis__menu {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      gap: 0;
      min-width: 12rem;
      margin: 0;
      padding: var(--space-1) 0;
      border: 3px solid var(--color-rule);
      border-radius: var(--radius-sm);
      background: var(--color-header-bg);
      box-shadow: 0 6px 16px rgb(0 0 0 / 0.15);
      list-style: none;
    }

    .nav-dis__menu a {
      min-height: var(--tap-target);
      padding-inline: var(--space-3);
    }
  }

  /* 992–1199px: tighter spacing (same text size) so all eight items, longer in
     Spanish, stay on one line. */
  @media (min-width: 62rem) and (max-width: 74.99rem) {
    .site-nav ul {
      gap: 0 var(--space-1);
    }

    .site-nav a,
    .nav-dis__btn {
      padding-inline: var(--space-1);
    }
  }

  @media print {
    .site-header,
    .sick-link {
      position: static;
    }
  }
</style>
