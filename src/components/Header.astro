---
import { assetPath, getLocale, getTagline, locales, localizePath, siteName, switchLocalePath, useTranslations } from '../i18n';
import { diseaseKeys, getPage, mainNavKeys } from '../config/pages';

interface Props {
  lang: string;
  /** Language links go to each language's home page (the 404 page, which has no translation). */
  langLinksHome?: boolean;
}

const { lang, langLinksHome = false } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;

// The current page's item is marked "page"; a section's item (Tools on a tool page) is
// marked "true", unless the page has its own item in the menu (Detective).
const navHrefs = mainNavKeys.map((key) => localizePath(lang, getPage(key).path));
const hasOwnItem = navHrefs.includes(normalized);
const navItems = mainNavKeys.map((key, i) => {
  const href = navHrefs[i];
  return {
    key,
    href,
    current: normalized === href ? 'page' : !hasOwnItem && normalized.startsWith(href) ? 'true' : undefined,
  };
});
// "Diseases": a small dropdown (menu bar) or a label with three buttons (Menu button) for
// the three disease pages; marked current on any disease page.
const diseaseItems = diseaseKeys.map((key) => {
  const href = localizePath(lang, getPage(key).path);
  return { key, href, current: normalized === href ? ('page' as const) : undefined };
});
const onDiseasePage = diseaseItems.some((d) => d.current);
// Main-menu label: a shorter one where a page has it (pages.<key>.menu, e.g. "Travel"),
// so the bar fits on one line; otherwise the page's usual label.
const menuLabel = (key: string) => (getLocale(lang).messages as Record<string, any>).pages?.[key]?.menu ?? t(`pages.${key}.nav`);
---

<header class="site-header">
  <div class="container header__grid">
    {/* The name and the language links: one column on phones; elsewhere (display:
        contents) each takes its own spot in the header grid. */}
    <div class="header__id">
      <div class="brand">
        <a class="brand__name" href={localizePath(lang)}>
          <span class="visually-hidden">{siteName}</span>
          {/* The current Outbite logo (v2, files in public/brand/): the mark is the "O"
              and the rest of the name follows as live text. */}
          <span class="brand__logo" aria-hidden="true">
            <img class="brand__mark" src={assetPath('brand/outbite-mark.svg')} alt="" width="64" height="64" /><span class="brand__word">{siteName.slice(1)}</span>
          </span>
        </a>
        <p class="brand__tagline">{getTagline(lang)}</p>
      </div>

      <nav class="lang-switcher" aria-label={t('a11y.languageNav')}>
        <ul>
          {
            locales.map((l) => (
              <li>
                <a
                  href={langLinksHome ? localizePath(l.code) : switchLocalePath(pathname, l.code)}
                  lang={l.meta.htmlLang}
                  hreflang={l.meta.htmlLang}
                  aria-current={l.code === lang ? 'true' : undefined}
                >
                  {l.meta.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <a class="btn btn-urgent sick-link" href={localizePath(lang, getPage('sick').path)}>
      {/* Phones (under 40rem) show the short label (Spanish "Me siento mal"). */}
      <span class="sick-link__full">{t('header.sick')}</span><span class="sick-link__short">{t('header.sickShort')}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      {/* Both labels share one spot, so the button keeps its width when it changes. */}
      <span class="menu-toggle__labels">
        <span class="menu-toggle__open">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="menu-toggle__word">{t('a11y.menu')}</span>
        </span>
        <span class="menu-toggle__close"><span aria-hidden="true">✕</span> <span class="menu-toggle__word">{t('a11y.close')}</span></span>
      </span>
    </button>
  </div>

  <nav id="site-nav" class="site-nav" aria-label={t('a11y.mainNav')}>
    <ul>
      <!-- Diseases, Menu button: a small label with the three pages as buttons on one row. -->
      <li class="nav-dis-phone">
        <span class="nav-dis-phone__label" id="nav-dis-label">{t('header.diseases')}</span>
        <ul class="nav-dis-phone__list" aria-labelledby="nav-dis-label">
          {
            diseaseItems.map((d) => (
              <li>
                <a href={d.href} aria-current={d.current}>
                  {t(`pages.${d.key}.nav`)}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      <!-- Diseases, menu bar: a dropdown opened by click, tap, Enter or Space (a native
           <details>, so it also works without JavaScript; the script adds aria-expanded,
           Escape and closing on a click outside). Never on hover. -->
      <li class="nav-dis">
        <details class="nav-dis__details" data-nav-dis>
          <summary class:list={['nav-dis__btn', { 'is-current': onDiseasePage }]}>
            {t('header.diseases')}
            <svg class="nav-dis__caret" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2 4 L6 8 L10 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </summary>
          <ul class="nav-dis__menu">
            {
              diseaseItems.map((d) => (
                <li>
                  <a href={d.href} aria-current={d.current}>
                    {t(`pages.${d.key}.nav`)}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current}>
              <span class="site-nav__label">{menuLabel(item.key)}</span>
              <svg class="site-nav__chev" aria-hidden="true" width="8" height="14" viewBox="0 0 8 14">
                <path d="M1.5 2 L6.5 7 L1.5 12" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
<!-- Dims the page behind the open menu (a tap on it closes the menu). -->
<div class="menu-backdrop" aria-hidden="true"></div>

<script is:inline>
  // Header layout wherever the Menu button shows (html.menu-mode): the first of "row",
  // "bar" and "tight" (see the styles) in which nothing is squeezed; on phones (under
  // 40rem) "phone", or "phone-tight" if even that doesn't fit. Runs before the page
  // draws, and again when the fonts load, the width or text size changes, or menu mode
  // starts or ends.
  (function () {
    var root = document.documentElement;
    var header = document.querySelector('.site-header');
    var grid = header && header.querySelector('.header__grid');
    var brand = header && header.querySelector('.brand');
    if (!grid || !brand) return;
    var phone = matchMedia('(max-width: 39.99rem)');
    var sick = header.querySelector('.sick-link');
    var fits = function () {
      if (brand.scrollWidth > brand.clientWidth || grid.scrollWidth > grid.clientWidth) return false;
      // Phones: the sick button may wrap to two lines, which still fit its 44px height.
      return !phone.matches || !sick || sick.offsetHeight <= parseFloat(getComputedStyle(sick).minHeight) + 1;
    };
    var fit = function () {
      if (!root.classList.contains('menu-mode')) {
        header.removeAttribute('data-layout');
        return;
      }
      var layouts = phone.matches ? ['phone', 'phone-tight'] : ['row', 'bar', 'tight'];
      for (var i = 0; i < layouts.length; i++) {
        header.dataset.layout = layouts[i];
        if (fits()) break;
      }
      // WebKit can keep the row height of a layout tried along the way; laying the row
      // out afresh clears it.
      if (phone.matches) {
        grid.style.display = 'none';
        void grid.offsetHeight;
        grid.style.display = '';
      }
    };
    fit();
    addEventListener('resize', fit);
    new MutationObserver(fit).observe(root, { attributes: true, attributeFilter: ['class', 'data-text-size'] });
    if (document.fonts) document.fonts.ready.then(fit);
  })();
</script>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');

  // Share the real header height with CSS (scroll padding under the sticky header).
  // It changes with text zoom and language.
  if (header) {
    new ResizeObserver(() => root.style.setProperty('--header-height', `${header.offsetHeight}px`)).observe(header);
  }

  // Keep keyboard focus from landing under the sticky header (tablet and up). Backs up
  // CSS scroll-padding for browsers that ignore it.
  document.addEventListener('focusin', (event) => {
    const el = event.target;
    if (!(el instanceof HTMLElement) || !header) return;
    if (header.contains(el)) return;
    // Keyboard focus only: a mouse click on page content can focus <main> (tabindex -1,
    // the skip link's target) and must not scroll the page.
    if (!el.matches(':focus-visible') || el.tagName === 'MAIN') return;
    // Pages that scroll focused content into place themselves (How it spreads story).
    if (el.closest('[data-scroll-managed]')) return;
    if (getComputedStyle(header).position !== 'sticky') return;
    requestAnimationFrame(() => {
      const gap = 16;
      const top = header.getBoundingClientRect().bottom;
      const rect = el.getBoundingClientRect();
      if (rect.top < top + gap) window.scrollBy(0, rect.top - top - gap);
    });
  });

  // "Diseases" dropdown: aria-expanded follows the open state; Escape or a click
  // outside closes it (Escape returns focus to "Diseases").
  const dis = document.querySelector<HTMLDetailsElement>('[data-nav-dis]');
  const disBtn = dis?.querySelector<HTMLElement>('summary');
  if (dis && disBtn) {
    const sync = () => disBtn.setAttribute('aria-expanded', String(dis.open));
    sync();
    dis.addEventListener('toggle', sync);
    document.addEventListener('click', (event) => {
      if (dis.open && !dis.contains(event.target as Node)) dis.open = false;
    });
    dis.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dis.open) {
        event.stopPropagation();
        dis.open = false;
        disBtn.focus();
      }
    });
    dis.addEventListener('focusout', (event) => {
      if (dis.open && !dis.contains(event.relatedTarget as Node | null) && event.relatedTarget) dis.open = false;
    });
  }

  // Menu button: the menu opens over the page (dimmed behind it, and not scrolling) just
  // under the header, so "I think I'm sick" stays in view. Escape, a tap outside it or
  // choosing an item closes it and puts focus back on the button; moving focus out of
  // the header (Tab past the last item) just closes it.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');

  if (header && toggle && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const place = () => nav.style.setProperty('--menu-top', `${Math.max(0, header.getBoundingClientRect().bottom)}px`);
    const setOpen = (open: boolean, returnFocus = false) => {
      if (open && header.getBoundingClientRect().top < 0) {
        // Phones (the header scrolls away): bring the whole header back into view first.
        window.scrollBy({ top: header.getBoundingClientRect().top, behavior: 'instant' });
      }
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      root.classList.toggle('menu-open', open);
      if (open) place();
      // The button is in view (the header sticks, or was brought into view to open the
      // menu); WebKit would otherwise scroll toward the sticky header's place in the page.
      if (!open && returnFocus) toggle.focus({ preventScroll: true });
    };
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    nav.addEventListener('click', (event) => {
      if (isOpen() && (event.target as Element).closest('a')) setOpen(false, true);
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (isOpen() && !nav.contains(target) && !toggle.contains(target)) setOpen(false, true);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false, true);
      }
    });
    document.addEventListener('focusin', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
    // Wider window or smaller text: the menu bar replaces the button, so close.
    addEventListener('resize', () => {
      if (!isOpen()) return;
      if (root.classList.contains('menu-mode')) place();
      else setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    background: var(--color-header-bg);
    color: var(--color-header-text);
    border-bottom: 4px solid var(--color-rule);
  }

  .header__id {
    display: contents;
  }

  /* Header layouts wherever the Menu button shows (and without JavaScript under 992px):
       row:   name | language | sick link | Menu
       bar:   name | language | Menu, then the sick link as a full-width red bar
       tight: name | language over Menu, then the bar
     The script just after the header picks the first that fits (data-layout). Before it
     runs, and without JavaScript, phones get "bar" and wider screens "row". */
  .header__grid {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    grid-template-areas: 'brand lang sick menu';
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  @media (max-width: 47.99rem) {
    .header__grid {
      grid-template-columns: 1fr auto auto;
      grid-template-areas:
        'brand lang menu'
        'sick sick sick';
    }
  }

  .site-header[data-layout='row'] .header__grid {
    grid-template-columns: 1fr auto auto auto;
    grid-template-areas: 'brand lang sick menu';
  }

  .site-header[data-layout='bar'] .header__grid {
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'brand lang menu'
      'sick sick sick';
  }

  .site-header[data-layout='tight'] .header__grid {
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'brand menu'
      'sick sick';
  }

  /* Logo sizes: under 600px about 1.3× the old size; 600–899px about 1.5×, tagline
     below in small text; 900px and up about 2× (wordmark ~40px), with the tagline
     beside it after a short navy divider. */
  .brand {
    grid-area: brand;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .brand__name {
    display: inline-block;
    white-space: nowrap; /* the mark and "utbite" never split */
    font-family: var(--font-heading);
    font-size: 1.9375rem;
    font-weight: var(--weight-heading);
    line-height: 1.15;
    color: var(--color-header-text);
    text-decoration: none;
  }

  /* Sized and nudged so the mark's ring sits on the text baseline like a
     letter "O" (proportions taken from public/brand/outbite-logo.svg). */
  .brand__mark {
    display: inline;
    width: 1.07em;
    height: 1.07em;
    vertical-align: -0.1em;
    margin-inline-end: -0.1em;
  }

  .brand__tagline {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-header-link);
  }

  /* Under 600px: tagline hidden visually, still read by screen readers. */
  @media (max-width: 37.49rem) {
    .brand__tagline {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 37.5rem) {
    .brand__name {
      font-size: 2.0625rem;
    }
  }

  /* 992px and up: logo and tagline on one row. */
  @media (min-width: 62rem) {
    .brand {
      flex-direction: row;
      align-items: center;
    }

    .brand__name {
      font-size: 2.5rem;
    }

    .brand__tagline {
      display: flex;
      align-items: center;
      min-height: 32px;
      margin-inline-start: var(--space-4);
      padding-inline-start: var(--space-4);
      border-inline-start: 2px solid var(--color-rule);
      font-size: 1.0625rem;
      white-space: nowrap;
    }

    /* With the Menu button (Spanish at larger text) the tagline may wrap, so the sick
       link can stay in the row. */
    :global(html.menu-mode) .brand__tagline {
      white-space: normal;
    }
  }

  /* 992–999px: a little tighter so the longer Spanish tagline and sick link fit on
     one row with the logo. */
  @media (min-width: 62rem) and (max-width: 62.49rem) {
    .brand__tagline {
      margin-inline-start: var(--space-3);
      padding-inline-start: var(--space-3);
      font-size: var(--text-sm);
    }
  }

  .lang-switcher {
    grid-area: lang;
    justify-self: end;
  }

  .lang-switcher ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wrapping the two names is a last resort ("tight"). */
  .site-header:is([data-layout='row'], [data-layout='bar']) .lang-switcher ul {
    flex-wrap: nowrap;
  }

  .lang-switcher a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-1);
    color: var(--color-header-link);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .lang-switcher a[aria-current] {
    color: var(--color-header-text);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .sick-link {
    grid-area: sick;
    justify-self: start;
    white-space: nowrap;
  }

  /* The full-width red bar under the logo row (phones, or wherever the row is crowded). */
  @media (max-width: 47.99rem) {
    .sick-link {
      justify-self: stretch;
      white-space: normal;
    }
  }

  .site-header:is([data-layout='bar'], [data-layout='tight']) .sick-link {
    justify-self: stretch;
    white-space: normal;
  }

  .site-header[data-layout='row'] .sick-link {
    justify-self: start;
    white-space: nowrap;
  }

  .menu-toggle {
    grid-area: menu;
    justify-self: end;
    display: none;
    align-items: center;
    min-height: var(--tap-target);
    padding: var(--space-2) var(--space-3);
    border: 3px solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-header-text);
    font: inherit;
    font-weight: var(--weight-strong);
    white-space: nowrap;
    cursor: pointer;
  }

  :global(html.menu-mode) .menu-toggle {
    display: inline-flex;
  }

  /* Open: "✕ Close", filled navy. */
  .menu-toggle[aria-expanded='true'] {
    background: var(--color-rule);
    color: var(--color-header-bg);
  }

  .menu-toggle__labels {
    display: grid;
    justify-items: center;
  }

  .menu-toggle__labels > span {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__open,
  .menu-toggle:not([aria-expanded='true']) .menu-toggle__close {
    visibility: hidden;
  }

  /* ---- The menu as a list of rows: under the Menu button, and without JavaScript under
     992px (always open there, below the header). ---- */
  .site-nav {
    border-top: 1px solid var(--color-border);
    background: var(--color-header-bg);
  }

  .site-nav > ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav > ul > li {
    border-bottom: 1px solid var(--color-nav-divider);
  }

  .site-nav > ul > li:last-child {
    border-bottom: 0;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    color: var(--color-header-link);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  /* Rows: full width, at least 48px tall, with a › on the right. */
  /* At least 48px (not 3rem): at larger text the row grows with its text anyway, and the
     nine rows still fit the open menu at 768px in Spanish at 130%. */
  .site-nav > ul > li > a {
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--gutter);
    color: var(--color-header-text);
    font-size: var(--text-lg);
  }

  /* Larger text: less padding, so the rows stay close to 48px. */
  :global(html[data-text-size]) .site-nav > ul > li > a {
    padding-block: var(--space-1);
  }

  .site-nav > ul > li > a:focus-visible {
    outline-offset: -3px;
  }

  .site-nav a:hover .site-nav__label {
    text-decoration: underline;
  }

  .site-nav__chev {
    flex: none;
    color: var(--color-header-link);
  }

  /* Current page: a light-orange bar on the left, pale peach, bold. */
  .site-nav > ul > li > a[aria-current] {
    padding-inline-start: calc(var(--gutter) - 6px);
    border-inline-start: 6px solid var(--color-nav-current-bar);
    background: var(--color-nav-current-bg);
    font-weight: var(--weight-heading);
  }

  /* "Diseases": a small label, then the three pages as equal buttons on one row (two
     rows if the names don't fit, as in Spanish at the largest text size). */
  .nav-dis-phone {
    padding: var(--space-3) var(--gutter) var(--space-4);
  }

  .nav-dis-phone__label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-header-link);
    font-size: 0.8125rem;
    font-weight: var(--weight-heading);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav-dis-phone__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-dis-phone__list li {
    flex: 1 1 0;
    min-width: max-content;
  }

  .site-nav .nav-dis-phone__list a {
    justify-content: center;
    min-height: 3rem;
    padding: var(--space-1) var(--space-2);
    border: 2px solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-header-text);
    text-align: center;
  }

  .nav-dis-phone__list a:hover {
    text-decoration: underline;
  }

  /* On a disease page, its button is filled navy. */
  .site-nav .nav-dis-phone__list a[aria-current] {
    background: var(--color-header-text);
    color: var(--color-header-bg);
  }

  .nav-dis {
    display: none;
  }

  /* ---- Under the Menu button (JavaScript on): the menu opens over the page, just under
     the header; the page behind is dimmed and doesn't scroll. ---- */
  :global(html.menu-mode) .site-nav {
    position: fixed;
    inset-inline: 0;
    top: var(--menu-top, 0px);
    z-index: 50;
    max-height: calc(100vh - var(--menu-top, 0px));
    max-height: calc(100dvh - var(--menu-top, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 0;
    border-bottom: 4px solid var(--color-rule);
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.2);
  }

  :global(html.menu-mode) .site-nav:not([data-open]) {
    display: none;
  }

