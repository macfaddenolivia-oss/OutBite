---
// Home page: three preview tiles. Each tile is one link
// (the whole tile is clickable): a decorative preview (aria-hidden; the tile's text
// describes it), a title, one line and a light-orange button. The previews reuse the
// real drawings and data, built at build time:
// 1. How it spreads: the moment of the bite (bucket, dotted flight from its water, the
//    mosquito level and facing right, biting Ana's shoulder and carrying the virus (the
//    four scattered dots); the bucket stands in the light-blue ground with its contact
//    shadow; "Ana" on the ground).
// 2. Protect yourself: a small, airy nested-layers graphic (no rows or mosquitoes), with
//    "Have young kids? See tips for families →" between the text and the button.
// The buttons sit at the bottom of every tile, so they line up across a row.
// 3. Is it near me?: the dashboard map (dengue) with a Puerto Rico inset, shaded like the
//    "Is it near me?" map (mapStep in src/lib/cases.ts): orange where CDC lists ongoing local
//    spread, four fixed blue steps, white for none, grey stripes for not reported; with a
//    one-line key in the big legend's words.
import Bucket from './story/Bucket.astro';
import Mosquito from './story/Mosquito.astro';
import Person from './story/Person.astro';
import { BUCKET_WATER_Y } from './story/layout';
import map from '../data/us-map.json';
import placeData from '../data/places.json';
import { caseData, mapStep } from '../lib/cases';
import { localizePath, useTranslations } from '../i18n';
import { getPage } from '../config/pages';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = (key: string) => localizePath(lang, getPage(key).path);

// ---- 1. Story preview (380 × 200 units) ----
const G = 166; // ground line
const ana = { x: 300, y: G };
// The bucket stands on the ground line, drawn in front of it, its base corners `sink`
// units below G: about 3px at 1313×900, where this drawing renders at 0.91px per unit.
const bucket = { x: 82, y: G, scale: 0.8, sink: 3 / 0.91 };
const water = { x: bucket.x, y: G + bucket.sink + BUCKET_WATER_Y * bucket.scale };
// Ana's near (left) shoulder; the mosquito (90% size) faces right, its proboscis tip
// 27 units ahead at full size.
const mqScale = 0.9;
const bite = { x: ana.x - 25.4, y: G - 58 };
const mq = { x: bite.x - 27 * mqScale, y: bite.y };
const flight = `M${water.x} ${water.y} C ${water.x} ${water.y - 95}, ${mq.x - 80} ${mq.y - 45}, ${mq.x - 30 * mqScale} ${mq.y}`;

// ---- 2. Layers preview (378 × 198 units): evenly spaced rings ----
const rings = [
  ['community', 44, 14, 290, 170, '#A9C8E0'],
  ['yard', 80, 35, 218, 128, '#F0AF74'],
  ['home', 116, 56, 146, 86, '#CBDCEC'],
  ['body', 152, 77, 74, 44, '#F4D1A8'],
] as const;

// ---- 3. Map preview: states (dengue year totals, the dashboard's shading) ----
const states = Object.entries(map.states as Record<string, string>).filter(([code]) => code !== 'DC');
const localDengue = new Set(placeData.places.filter((p) => p.localSpread.dengue).map((p) => p.code));
const shadeOf = (code: string) =>
  `tile__state tile__step-${mapStep(caseData.places[code]?.dengue.ytd ?? null)}${localDengue.has(code) ? ' tile__local' : ''}`;
const pr = (map.territories as Record<string, { d: string; width: number; height: number }>).PR;
---

<ul class="tiles">
  <li>
    <a class="tile" href={href('howItSpreads')}>
      <span class="tile__preview tile__preview--story" aria-hidden="true">
        <svg viewBox="0 0 380 200" class="tile__svg tile__svg--story">
          <rect width="380" height="200" fill="#FFFFFF"></rect>
          <rect x="-2000" y={G} width="4380" height="2000" fill="#CBDCEC"></rect>
          <Bucket x={bucket.x} y={bucket.y} scale={bucket.scale} onGround sink={bucket.sink} />
          <path d={flight} fill="none" stroke="#17306A" stroke-width="2.4" stroke-dasharray="2.4 7" stroke-linecap="round"></path>
          <Person x={ana.x} y={ana.y} />
          <Mosquito x={mq.x} y={mq.y} scale={mqScale} flip dots />
          <text x={ana.x} y={G + 19} text-anchor="middle" class="tile__name">Ana</text>
        </svg>
      </span>
      <span class="tile__body">
        <span class="tile__title">{t('home.tiles.story.title')}</span>
        <span class="tile__text">{t('home.tiles.story.text')}</span>
        <span class="tile__btn">{t('home.tiles.story.button')} <span aria-hidden="true">→</span></span>
      </span>
    </a>
  </li>
  <li>
    {/* The families link sits between the text and the button, and a link can't sit
        inside another link, so here the button is the tile's link: it covers the whole
        tile (::after), with the families link on top of it. */}
    <div class="tile tile--stretched">
      <span class="tile__preview" aria-hidden="true">
        <svg viewBox="0 0 378 198" class="tile__svg">
          {
            rings.map(([layer, x, y, w, h, fill]) => (
              <rect x={x} y={y} width={w} height={h} fill={fill} stroke="#17306A" stroke-width="2.5" />
            ))
          }
          {
            rings
              .filter(([layer]) => layer !== 'body')
              .map(([layer, x, y]) => (
                <text x={x + 8} y={y + 15} class="tile__ring-label">
                  {t(`home.layersGraphic.${layer}`)}
                </text>
              ))
          }
          <circle cx="189" cy="92" r="6.5" fill="#17306A"></circle>
          <path d="M176 119 V113 a13 12 0 0 1 26 0 V119 Z" fill="#17306A"></path>
        </svg>
      </span>
      <span class="tile__body">
        <span class="tile__title">{t('home.tiles.protect.title')}</span>
        <span class="tile__text">{t('home.tiles.protect.text')}</span>
        <a class="tile__extra" href={href('families')}>
          {t('home.tiles.protect.families')}{'\u00A0'}<span aria-hidden="true">→</span>
        </a>
        <a class="tile__btn tile__btn--stretched" href={href('protect')}>
          {t('home.tiles.protect.button')} <span aria-hidden="true">→</span>
        </a>
      </span>
    </div>
  </li>
  <li>
    <a class="tile" href={href('nearMe')}>
      <span class="tile__preview tile__preview--map" aria-hidden="true">
        <svg viewBox="0 -10 975 640" class="tile__svg tile__svg--map">
          <defs>
            <pattern id="tile-hatch" width="16" height="16" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <rect width="16" height="16" fill="#FFFFFF"></rect>
              <line x1="0" y1="0" x2="0" y2="16" class="tile__hatch-line" stroke-width="5"></line>
            </pattern>
          </defs>
          {states.map(([code, d]) => <path d={d} class={shadeOf(code)} />)}
          <g transform="translate(830 520)">
            <rect x="0" y="0" width="120" height="62" fill="#FFFFFF" stroke="#17306A" stroke-width="3"></rect>
            <g transform={`translate(10 ${(62 - pr.height) / 2}) scale(1)`}>
              <path d={pr.d} class={shadeOf('PR')} />
            </g>
          </g>
        </svg>
        {/* The big map's legend, in one line: orange, then the four blues. */}
        <span class="tile__key">
          <span class="tile__key-item"><span class="tile__swatch tile__swatch--local"></span><span><strong>{t('dash.legendLocal')}</strong> (CDC)</span></span>
          <span class="tile__key-item">
            <span class="tile__swatches">
              {[1, 2, 3, 4].map((n) => <span class={`tile__swatch tile__swatch--${n}`}></span>)}
            </span>
            {t('dash.legendHeading', { year: String(caseData.mmwrYear) })}
          </span>
        </span>
      </span>
      <span class="tile__body">
        <span class="tile__title">{t('home.tiles.nearMe.title')}</span>
        <span class="tile__text">{t('home.tiles.nearMe.text')}</span>
        <span class="tile__btn">{t('home.tiles.nearMe.button')} <span aria-hidden="true">→</span></span>
      </span>
    </a>
  </li>
</ul>

<style>
  /* Three across on desktop, two plus one on tablets, stacked on phones. */
  .tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tiles li {
    display: flex;
  }

  .tile {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 3px solid var(--color-rule);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: box-shadow 0.12s;
  }

  /* Hover: a slightly thicker border (drawn inside, so nothing moves). */
  .tile:hover {
    box-shadow: inset 0 0 0 2px var(--color-rule);
  }

  .tile:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* Previews: the same height in all three, white, divider below. */
  .tile__preview {
    position: relative;
    display: block;
    height: 200px;
    overflow: hidden;
    border-bottom: 3px solid var(--color-rule);
    background: #ffffff;
  }

  .tile__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Story: the drawing sits at the top; the ground reaches the divider at any width. */
  .tile__svg--story {
    height: auto;
    overflow: visible;
  }

  .tile__preview--story {
    background: #cbdcec;
  }

  .tile__preview--story .tile__svg--story {
    background: #ffffff;
  }

  .tile__name {
    fill: #17306a;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 800;
  }

  .tile__ring-label {
    fill: #17306a;
    font-family: var(--font-heading);
    font-size: 11px; /* about 10px at the tile's size */
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .tile__svg--map {
    padding: 8px 10px;
  }

  .tile__state {
    stroke: #17306a;
    stroke-width: 0.8;
    stroke-linejoin: round;
  }

  /* Same shading as the "Is it near me?" map. */
  .tile__step-0 { fill: #ffffff; }
  .tile__step-1 { fill: var(--color-map-step-1); }
  .tile__step-2 { fill: var(--color-map-step-2); }
  .tile__step-3 { fill: var(--color-map-step-3); stroke: var(--color-map-outline-on-dark); }
  .tile__step-4 { fill: var(--color-map-step-4); stroke: var(--color-map-outline-on-dark); }
  .tile__step--1 { fill: url(#tile-hatch); }

  .tile__hatch-line {
    stroke: var(--color-map-pattern);
  }

  .tile__state.tile__local {
    fill: var(--color-map-local);
    stroke: var(--color-map-outline);
  }

  /* Map tile: the map above a one-line key, in the tile's fixed preview height. */
  .tile__preview--map {
    display: flex;
    flex-direction: column;
  }

  .tile__preview--map .tile__svg--map {
    flex: 1 1 auto;
    min-height: 0;
  }

  .tile__key {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-3);
    padding: 4px 10px 8px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .tile__key-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .tile__swatches {
    display: inline-flex;
  }

  .tile__swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--color-map-outline);
  }

  .tile__swatches .tile__swatch + .tile__swatch {
    border-inline-start: 0;
  }

  .tile__swatch--local { background: var(--color-map-local); }
  .tile__swatch--1 { background: var(--color-map-step-1); }
  .tile__swatch--2 { background: var(--color-map-step-2); }
  .tile__swatch--3 { background: var(--color-map-step-3); }
  .tile__swatch--4 { background: var(--color-map-step-4); }

  .tile__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--pad-box-lg);
  }

  .tile__title {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 1.625rem;
    font-weight: var(--weight-display);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }


  .tile__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    margin-top: auto;
    padding: var(--space-2) var(--pad-box);
    border: 3px solid var(--color-primary-border);
    border-radius: var(--radius-sm);
    background: var(--color-primary-bg);
    color: var(--color-primary-text);
    font-weight: var(--weight-strong);
  }

  /* Protect tile: the button's ::after covers the tile, so the whole tile is clickable;
     the families link sits on top of it. */
  .tile--stretched {
    position: relative;
  }

  .tile__btn--stretched {
    text-decoration: none;
  }

  .tile__btn--stretched::after {
    content: '';
    position: absolute;
    inset: -3px;
  }

  .tile__btn--stretched:focus-visible {
    outline: none;
  }

  .tile__btn--stretched:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* Hover the tile, not the families link. */
  .tile--stretched:hover {
    box-shadow: none;
  }

  .tile--stretched:has(.tile__btn--stretched:hover) {
    box-shadow: inset 0 0 0 2px var(--color-rule);
  }

  .tile__extra {
    position: relative;
    z-index: 1;
    font-weight: var(--weight-heading);
  }

  /* A little space above the button, even in the tallest tile. */
  .tile__extra,
  .tile__text {
    margin-bottom: var(--space-1);
  }

  .tile:hover .tile__btn {
    background: var(--color-primary-bg-hover);
  }

  .tile--stretched:hover .tile__btn {
    background: var(--color-primary-bg);
  }

  .tile--stretched .tile__btn:hover {
    background: var(--color-primary-bg-hover);
  }
</style>
