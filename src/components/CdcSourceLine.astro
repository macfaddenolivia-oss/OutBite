---
// "Source: CDC. Counts include cases reported up to [date]. CDC updates these numbers
// weekly." Used under every set of case numbers (home panel, dashboard numbers, map).
// "CDC" links to the NNDSS dataset page; the system is named in full only in Sources.
import { CDC_DATA_URL, caseData, formatDate } from '../lib/cases';
import { getLocale, useTranslations } from '../i18n';

interface Props {
  lang: string;
  class?: string;
}
const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
const date = formatDate(caseData.weekEnding, getLocale(lang).meta.htmlLang);
---

<p class={className}>
  {t('dash.sourceLabel')} <a href={CDC_DATA_URL}>{t('dash.sourceCdcName')}</a>. {t('dash.sourceRest', { date })}
</p>
