---
// Mosquito detective, Round 3: the yard (design/breed-round-mockup.png; drawings from
// design/yard/, copied to src/assets/source/yard/). The picture is yard-scene.svg itself:
// its background (house, fence, ground) and its nine items, each drawn where the scene
// puts it (the scene's own copies of the separate drawings, so every outline has the
// scene's 3.5-unit weight). Over each item sits a toggle button (aria-pressed), the size
// of the item's drawing (its box in BOXES, in the scene's 800 × 440 units) but never
// smaller than 44 × 44px; the button draws the orange or dotted box and the short tag.
// The page script (tools/mosquito-detective.astro) does the rest.
// The whole yard is never drawn narrower than 47rem (752px at the usual text size, wider at
// larger text, so every tag has room clear of its neighbors and the house). Where the frame
// is narrower (phones, tablets, and laptops at the largest text; the page script sets
// data-compact) the compact yard shows
// instead, so nothing ever scrolls sideways (design/organic-yard-mockup.png, right): a box
// in proportions of 360 × 424 (a little shorter than the mockup's 360 × 456, so the round fits
// a 375 × 670 phone with its key) with the house and fence as a strip along the top
// (the scene's own background, cropped), a few grass tufts, and the nine items scattered
// around the ground (SCATTER: center x, bottom y and width in % of the box; items farther
// back are a bit smaller), each button holding its own copy of the item's drawing. Every tap
// area is at least 44 × 44px; each tag has a fixed place flush against its box (SCATTER), kept
// free from the start: where it would touch another item or tag, the page script moves the
// rows apart and the yard grows taller. Keyboard order: back to front, left to right (the
// page script puts the buttons in COMPACT_ORDER or TAB_ORDER).
import scene from '../assets/source/yard/yard-scene.svg?raw';

interface Props {
  items: Record<string, { name: string; tag: string; tagShort: string }>;
  water: string[];
  label: string;
}
const { items, water, label } = Astro.props;

// The scene: the background ends with the ground's top line; the nine items follow, in
// this order, all on one line.
const ORDER = ['birdbath', 'trashCan', 'chair', 'bucketUpsideDown', 'plantSaucer', 'bucket', 'tire', 'petBowl', 'ball'];
const lines = scene.trim().split('\n');
const groundLine = lines.findIndex((l) => l.startsWith('<path d="M0 230 H800"'));
if (groundLine < 0) throw new Error('yard-scene.svg: ground line not found');
const background = lines.slice(1, groundLine + 1).join('\n');
const rest = lines.slice(groundLine + 1).join('\n').replace(/<\/svg>\s*$/, '');
// Top-level elements of `rest`, by tag depth.
const parts: string[] = [];
let depth = 0;
let start = 0;
for (const m of rest.matchAll(/<(\/?)[a-zA-Z][^>]*?(\/?)>/g)) {
  if (m[1]) {
    depth--;
    if (depth === 0) parts.push(rest.slice(start, m.index! + m[0].length));
  } else if (m[2]) {
    if (depth === 0) parts.push(m[0]);
  } else {
    if (depth === 0) start = m.index!;
    depth++;
  }
}
if (parts.length !== ORDER.length) throw new Error(`yard-scene.svg: expected ${ORDER.length} items, found ${parts.length}`);
// Ids inside the drawings (clip paths), made unique on the page.
const uniqueIds = (svg: string, prefix: string) => svg.replace(/id="([^"]+)"/g, `id="${prefix}$1"`).replace(/url\(#([^)]+)\)/g, `url(#${prefix}$1)`);
const drawings = Object.fromEntries(ORDER.map((key, i) => [key, uniqueIds(parts[i], 'yard-')]));
// The compact yard's copies (their own clip path ids).
const compactDrawings = Object.fromEntries(ORDER.map((key, i) => [key, uniqueIds(parts[i], 'yard-c-')]));

// Each item's drawing, in scene units (measured in the browser, outlines excluded).
const BOXES: Record<string, [number, number, number, number]> = {
  birdbath: [51, 239, 107, 92],
  trashCan: [229, 155, 73, 99],
  chair: [330, 176, 80, 124],
  bucketUpsideDown: [474, 259, 61, 71],
  bucket: [574, 244, 58, 76],
  ball: [89, 363, 62, 62],
  tire: [250, 350, 141, 71],
  petBowl: [482, 383, 86, 40],
  plantSaucer: [671, 311, 98, 100],
};
// Keyboard order: the back row, then the front row, left to right.
const TAB_ORDER = ['birdbath', 'trashCan', 'chair', 'bucketUpsideDown', 'bucket', 'ball', 'tire', 'petBowl', 'plantSaucer'];
// The compact yard: center x, bottom y and width of each drawing, in % of the box (360 × 456
// in design/organic-yard-mockup.png, nudged where the 44px tap areas needed room), and where
// its tag goes, in both languages at every width and text size: above or below the box,
// centered or aligned to the box's start or end edge. The compact yard shows the short tags ("Empty & scrub"; tagShort).
const SCATTER: Record<string, { x: number; y: number; w: number; tag: string; tw?: number }> = {
  trashCan: { x: 37, y: 39, w: 14, tag: 'above' },
  chair: { x: 87, y: 40, w: 13, tag: 'above-end' },
  birdbath: { x: 16, y: 53, w: 22, tag: 'above-start' },
  bucketUpsideDown: { x: 59, y: 50.5, w: 16, tag: 'below-end' },
  bucket: { x: 84, y: 68, w: 17, tag: 'above-end' },
  plantSaucer: { x: 23, y: 79, w: 20, tag: 'above' },
  tire: { x: 58, y: 82, w: 30, tag: 'above' },
  ball: { x: 88, y: 89, w: 14, tag: 'below-end' },
  petBowl: { x: 30, y: 96, w: 23, tag: 'above-end', tw: 6.5 },
};
// Back to front, left to right.
const COMPACT_ORDER = ['trashCan', 'chair', 'birdbath', 'bucketUpsideDown', 'bucket', 'plantSaucer', 'petBowl', 'tire', 'ball'];
// Grass tufts on the ground (decoration), in the mockup's 360 × 456 units (placed in % of the box).
const TUFTS = [[36, 134], [252, 145], [173, 184], [334, 248], [24, 293], [156, 293], [24, 402], [244, 420], [333, 433]];
// Compact drawings: each item's box plus 3 units for the outline.
const OUTLINE = 3;
const compactBox = (key: string) => {
  const [x, y, w, h] = BOXES[key];
  return { viewBox: `${x - OUTLINE} ${y - OUTLINE} ${w + 2 * OUTLINE} ${h + 2 * OUTLINE}`, style: `aspect-ratio: ${w + 2 * OUTLINE} / ${h + 2 * OUTLINE}` };
};
const scatter = (key: string) => `--sx: ${SCATTER[key].x}%; --sy: ${SCATTER[key].y}%; --sw: ${SCATTER[key].w}%` + (SCATTER[key].tw ? `; --tw: ${SCATTER[key].tw}rem` : '');
// The whole yard: where each tag goes, flush against its box (above or below it, centered or
// aligned to one of its edges), clear of the other items, the other tags and the house. The
// page script keeps these unless a tag would cross the yard's edge or meet something (larger
// text, Spanish), and only then searches the other places (data-tag-fallback).
const WHOLE_TAG: Record<string, string> = {
  birdbath: 'below-start',
  trashCan: 'below',
  chair: 'above-start',
  bucketUpsideDown: 'above-end',
  bucket: 'above-start',
  ball: 'above',
  tire: 'above-end',
  petBowl: 'above',
  plantSaucer: 'above',
};
// The ball, moved right in the whole yard (scene units) from under the birdbath, so each of
// them has room for its tag.
const WHOLE_SHIFT: Record<string, number> = { ball: 86 };
// Tags kept within their own box's width (they wrap): the birdbath's (below it) and the
// ball's (above it) fit between their neighbors that way.
const WHOLE_FIT = ['birdbath', 'ball'];
// The house (scene units): no tag may cover it.
const HOUSE = [9, 14, 229, 234];
const PAD = 6;
const style = (key: string) => {
  const [x0, y, w, h] = BOXES[key];
  const x = x0 + (WHOLE_SHIFT[key] ?? 0);
  return `--cx: ${(((x + w / 2) / 800) * 100).toFixed(3)}%; --cy: ${(((y + h / 2) / 440) * 100).toFixed(3)}%; --w: ${(((w + 2 * PAD) / 800) * 100).toFixed(3)}%; --h: ${(((h + 2 * PAD) / 440) * 100).toFixed(3)}%`;
};
---

<div class="yard-frame" data-yard-frame>
  <div class="yard" role="group" aria-label={label} data-order={TAB_ORDER.join(' ')} data-house={HOUSE.join(' ')} data-compact-order={COMPACT_ORDER.join(' ')}>
    <svg class="yard__art" viewBox="0 0 800 440" aria-hidden="true" focusable="false">
      <Fragment set:html={background} />
      {ORDER.map((key) => <g transform={WHOLE_SHIFT[key] ? `translate(${WHOLE_SHIFT[key]} 0)` : undefined} set:html={drawings[key]} />)}
    </svg>
    {/* Compact yard: the house and fence, from just above the chimney to the ground line. */}
    <svg class="yard__strip" viewBox="0 10 800 224" aria-hidden="true" focusable="false">
      <Fragment set:html={background} />
    </svg>
    {
      TUFTS.map(([x, y]) => (
        <svg class="yard__tuft" viewBox="-8 -11 18 12" style={`--tx: ${((x / 360) * 100).toFixed(2)}%; --ty: ${((y / 456) * 100).toFixed(2)}%`} aria-hidden="true" focusable="false" data-yard-tuft>
          <path d="M-4 0 l-2 -8 M0 0 l1 -10 M4 0 l3 -7" />
        </svg>
      ))
    }
    {
      TAB_ORDER.map((key) => (
        <button type="button" class="yard-item" style={`${style(key)}; ${scatter(key)}`} aria-pressed="false" data-yard-item={key} data-water={String(water.includes(key))} data-wtag={WHOLE_TAG[key]} data-wfit={WHOLE_FIT.includes(key) ? '' : undefined} data-ctag={SCATTER[key].tag} data-tagpos={WHOLE_TAG[key]}>
          <span class="visually-hidden">{items[key].name}</span>
          <span class="yard-item__spot" aria-hidden="true">
            <svg class="yard-item__art" viewBox={compactBox(key).viewBox} style={compactBox(key).style} focusable="false">
              <g set:html={compactDrawings[key]} />
            </svg>
          </span>
          <span class="yard-item__tag" aria-hidden="true" data-yard-tag>
            <span class="yard-item__tag-full">{items[key].tag}</span><span class="yard-item__tag-short">{items[key].tagShort}</span>
          </span>
        </button>
      ))
    }
  </div>
</div>

<style>
  .yard-frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 2px solid var(--color-border);
    background: #ffffff;
  }

  .yard {
    position: relative;
    min-width: 47rem;
    aspect-ratio: 800 / 440;
  }

  /* The whole yard at most 51rem wide (816px at the usual text size), so on a laptop the
     round fits above its bar (1313 × 800). */
  .yard-frame:not([data-compact]) {
    max-width: 51rem;
  }

  .yard__art {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The tap area: the item's drawing plus a little room, never under 44 × 44px,
     centered on the drawing. It draws the box once tapped. */
  .yard-item {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    width: max(44px, var(--w));
    height: max(44px, var(--h));
    translate: -50% -50%;
    padding: 0;
    border: 3px solid transparent;
    border-radius: 0;
    background: none;
    cursor: pointer;
  }

  .yard-item:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Holds water, found: orange box. */
  .yard-item[data-state='found'] {
    border-color: var(--palette-orange);
  }

  /* Tapped, but doesn't hold water: dotted light-blue box. */
  .yard-item[data-state='fine'] {
    border: 3px dotted var(--palette-light-blue);
  }

  /* After "I'm done": a place that holds water but wasn't found. */
  .yard-item[data-state='missed'] {
    border: 3px dashed var(--palette-orange);
    background: rgb(255 255 255 / 0.35);
  }

  .yard-item:disabled {
    cursor: default;
  }

  /* The short tag, flush against the box (data-tagpos, below): navy (found or missed) or
     white with navy text (fine). Every tag has a 2px border (navy on the navy tags), so it
     is the same size whatever it says. */
  .yard-item__tag {
    display: none;
    position: absolute;
    bottom: calc(100% + 3px);
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    width: max-content;
    max-width: 11rem;
    padding: 0 4px;
    border: 2px solid var(--palette-navy);
    background: var(--palette-navy);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: var(--weight-strong);
    line-height: 1.25;
    text-align: center;
  }

  /* (a little narrower than the box, so it stays clear of the next one) */
  .yard-frame:not([data-compact]) .yard-item[data-wfit] .yard-item__tag {
    max-width: calc(100% - 4px);
  }

  .yard-item[data-tagpos^='below'] .yard-item__tag {
    top: calc(100% + 3px);
    bottom: auto;
  }

  .yard-item[data-tagpos$='-start'] .yard-item__tag {
    left: -3px;
    translate: none;
  }

  .yard-item[data-tagpos$='-end'] .yard-item__tag {
    left: auto;
    right: -3px;
    translate: none;
  }

  .yard-item[data-state] .yard-item__tag {
    display: block;
  }

  .yard-item[data-state='fine'] .yard-item__tag {
    border: 2px solid var(--palette-navy);
    background: #ffffff;
    color: var(--palette-navy);
  }

  /* The compact yard's parts stay hidden in the whole yard. */
  .yard__strip,
  .yard__tuft,
  .yard-item__spot,
  .yard-item__tag-short {
    display: none;
  }

  .yard-frame[data-compact] .yard-item__tag-full {
    display: none;
  }

  .yard-frame[data-compact] .yard-item__tag-short {
    display: inline;
  }

  /* The page script measures the yard, its items and their tags to lay it out: everything
     changes at once (the site-wide reduced-motion rule would otherwise give every property a
     tiny transition, and a size would be measured mid-change). */
  .yard-frame,
  .yard-frame * {
    transition: none !important;
  }

  /* ---- Compact yard (data-compact on the frame): the scattered yard ---- */
  .yard-frame[data-compact] {
    overflow: visible;
  }

  .yard-frame[data-compact] .yard {
    min-width: 0;
    aspect-ratio: 360 / 424;
    background: var(--palette-pale-blue); /* the ground */
  }

  .yard-frame[data-compact] .yard__art {
    display: none;
  }

  /* The house and fence along the top, edge to edge. */
  .yard-frame[data-compact] .yard__strip {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  /* Grass tufts, each standing at its point (the page script moves them down with the
     rows around them when the yard grows taller). */
  .yard-frame[data-compact] .yard__tuft {
    position: absolute;
    left: var(--tx);
    top: var(--ty);
    display: block;
    width: 5%;
    max-width: none;
    height: auto;
    translate: -44.4% -91.7%;
    fill: none;
    stroke: #a6b8cb;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* Each item: its drawing centered at x, standing at y, at its width (never under
     44 × 44px to tap). */
  .yard-frame[data-compact] .yard-item {
    position: absolute;
    left: var(--sx);
    top: var(--sy);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: max(44px, var(--sw));
    height: auto;
    min-height: 44px;
    padding: 2px;
    translate: -50% -100%;
  }

  .yard-frame[data-compact] .yard-item__spot {
    display: block;
    width: 100%;
  }

  .yard-frame[data-compact] .yard-item__art {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  /* The tag flush against the box, above or below it, centered or aligned to one of its
     edges (data-tagpos; the box's border is 3px). Every tag has a 2px border (navy on the
     navy tags), so it is the same size whatever it says. */
  .yard-frame[data-compact] .yard-item__tag {
    width: max-content;
    /* No wider than its own box (at least 4.5rem, or --tw: the pet bowl's fits on one line
       in the narrow gap above it): a longer tag wraps instead of reaching a neighbor. */
    max-width: max(calc(100% + 6px), var(--tw, 4.5rem));
    padding: 0 3px;
    border: 2px solid var(--palette-navy);
    /* 12px, at most 13px at larger text sizes. */
    font-size: min(0.75rem, 13px);
    line-height: 1.2;
  }

  /* While the page script measures every tag's place, shown or not. */
  .yard[data-measuring] .yard-item__tag {
    display: block;
    visibility: hidden;
  }
</style>
